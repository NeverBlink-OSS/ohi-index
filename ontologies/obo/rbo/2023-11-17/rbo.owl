        <oboInOwl:hasExactSynonym>power station</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>powerhouse</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>ENVO</oboInOwl:hasOBONamespace>
        <oboInOwl:id>ENVO:00002214</oboInOwl:id>
        <rdfs:label>power plant</rdfs:label>
    </owl:Class>
