        <obo:IAO_0000115>An affinity inhering in an anatomical structure by virtue of the bearer exhibiting a molecular interaction for acidic dyes under specific pH conditions.</obo:IAO_0000115>
        <terms:contributor rdf:resource="https://orcid.org/0000-0002-2061-091X"/>
        <oboInOwl:creation_date>2012-12-17T03:01:19Z</oboInOwl:creation_date>
