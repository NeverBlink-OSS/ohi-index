        <obo:IAO_0000115>A bird nest is the spot in which a bird lays and incubates its eggs and raises its young.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>bird nest</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>bird&apos;s nest</oboInOwl:hasExactSynonym>
