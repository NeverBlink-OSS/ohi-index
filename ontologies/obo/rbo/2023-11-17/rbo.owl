        <oboInOwl:hasExactSynonym>villus</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>villus intestinalis (intestinum tenue)</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>uberon</oboInOwl:hasOBONamespace>
        <oboInOwl:hasRelatedSynonym>intestinal villus layer</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>small intestine villus</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>villi intestinales</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>UBERON:0001213</oboInOwl:id>
