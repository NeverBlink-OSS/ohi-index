        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_1010015"/>
        <rdfs:comment>&quot;A length unit which is equal to 20.1168 metres, 66 feet, or 22 yards.&quot; [Wikipedia:Wikpiedia]</rdfs:comment>
        <rdfs:label>chain</rdfs:label>
        <oboInOwl1:hasExactSynonym>ch</oboInOwl1:hasExactSynonym>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0010016 -->

