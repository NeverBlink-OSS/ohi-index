    <!-- http://purl.obolibrary.org/obo/CHEBI_37838 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_37838">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_22221"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/chebi#is_substituent_group_from"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/CHEBI_33575"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A carboacyl group is a group formed by loss of at least one OH from the carboxy group of a carboxylic acid.</obo:IAO_0000115>
