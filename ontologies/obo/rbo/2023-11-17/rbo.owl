        <oboInOwl:hasDbXref>EMAPA:16138</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>FMA:14704</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>GAID:24</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MA:0000054</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MESH:D010529</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>NCIT:C12769</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS:C1704247</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>VHOG:0000852</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace>uberon</oboInOwl:hasOBONamespace>
        <oboInOwl:hasRelatedSynonym>cavitas peritonealis</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>saccus serosus peritonei</oboInOwl:hasRelatedSynonym>
