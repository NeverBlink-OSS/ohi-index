        <oboInOwl:id>UBERON:0006235</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#emapa_ehdaa2"/>
        <rdfs:label>foregut-midgut junction</rdfs:label>
    </owl:Class>
