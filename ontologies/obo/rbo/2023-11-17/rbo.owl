        <oboInOwl:hasDbXref>HBA:9203</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS:C0040999</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>neuronames:2021</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>trigeminal nuclei</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>uberon</oboInOwl:hasOBONamespace>
        <oboInOwl:hasRelatedSynonym>nuclei trigemini</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>UBERON:0007641</oboInOwl:id>
        <rdfs:label>trigeminal nuclear complex</rdfs:label>
        <foaf:depicted_by rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://upload.wikimedia.org/wikipedia/commons/3/30/Gray696.png</foaf:depicted_by>
    </owl:Class>
