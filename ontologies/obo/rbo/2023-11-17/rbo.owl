        <rdfs:comment>&quot;A molality unit which is equal to 10^[-12] m.&quot; [UOC:GVG]</rdfs:comment>
        <rdfs:label>picomolal</rdfs:label>
        <oboInOwl1:hasExactSynonym>pm</oboInOwl1:hasExactSynonym>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0000073 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0000073">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/UO_1000062"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/has_prefix"/>
                        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UO_0000303"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_1000062"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/has_prefix"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UO_0000303"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>&quot;A unit of molarity which is equal to 10^[-15] M.&quot; [UOC:GVG]</rdfs:comment>
        <rdfs:label>femtomolar</rdfs:label>
        <oboInOwl1:hasExactSynonym>fM</oboInOwl1:hasExactSynonym>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0000074 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0000074">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_0000051"/>
        <rdfs:comment>&quot;A unit of concentration which highlights the chemical nature of salts.&quot; [Wikipedia:Wikipedia]</rdfs:comment>
        <rdfs:label>unit of normality</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0000075 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0000075">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_1000075"/>
        <rdfs:comment>&quot;A unit of concentration which is one gram equivalent of a solute per liter of solution. A gram equivalent weight or equivalent is a measure of the reactive capacity of a given molecule.&quot; [Wikipedia:Wikipedia]</rdfs:comment>
        <rdfs:label>normal</rdfs:label>
        <oboInOwl1:hasExactSynonym>N</oboInOwl1:hasExactSynonym>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0000076 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0000076">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_1000076"/>
        <rdfs:comment>&quot;A concentration unit which denotes the number of moles of solute as a proportion of the total number of moles in a solution.&quot; [Wikipedia:Wikipedia]</rdfs:comment>
        <rdfs:label>mole fraction</rdfs:label>
        <oboInOwl1:hasExactSynonym>(x)</oboInOwl1:hasExactSynonym>
        <oboInOwl1:hasExactSynonym>chi</oboInOwl1:hasExactSynonym>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0000077 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0000077">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_1000077"/>
        <rdfs:comment>&quot;An acceleration unit which is equal to the acceleration an object changing its velocity by 1meter/s over a time period that equals one second.&quot; [NIST:NIST]</rdfs:comment>
        <rdfs:label>meter per second per second</rdfs:label>
        <oboInOwl1:hasExactSynonym>m/s^[2]</oboInOwl1:hasExactSynonym>
        <oboInOwl1:hasExactSynonym>metre per second per second</oboInOwl1:hasExactSynonym>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0000078 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0000078">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_1000078"/>
        <rdfs:comment>&quot;An angular unit acceleration which is equal to the angular acceleration of an object changing its angular velocity by 1rad/s over a time period that equals one second.&quot; [NIST:NIST]</rdfs:comment>
        <rdfs:label>radian per second per second</rdfs:label>
        <oboInOwl1:hasExactSynonym>alpha</oboInOwl1:hasExactSynonym>
        <oboInOwl1:hasExactSynonym>rad/s^[2]</oboInOwl1:hasExactSynonym>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0000079 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0000079">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_1000079"/>
        <rdfs:comment>&quot;An angular unit velocity which is equal to about 9.54930 rpm (revolutions per minute).&quot; [NIST:NIST]</rdfs:comment>
        <rdfs:label>radian per second</rdfs:label>
        <oboInOwl1:hasExactSynonym>rad/s</oboInOwl1:hasExactSynonym>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0000080 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0000080">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_1000080"/>
        <rdfs:comment>&quot;An area unit which is equal to an area enclosed by a square with sides each 1 meter long.&quot; [NIST:NIST]</rdfs:comment>
        <rdfs:label>square meter</rdfs:label>
        <oboInOwl1:hasExactSynonym>m^[2]</oboInOwl1:hasExactSynonym>
        <oboInOwl1:hasExactSynonym>square metre</oboInOwl1:hasExactSynonym>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0000081 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0000081">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_1000081"/>
        <rdfs:comment>&quot;An area unit which is equal to one ten thousandth of a square meter or 10^[-4] m^[2].&quot; [NIST:NIST]</rdfs:comment>
        <rdfs:label>square centimeter</rdfs:label>
        <oboInOwl1:hasExactSynonym>cm^[2]</oboInOwl1:hasExactSynonym>
        <oboInOwl1:hasExactSynonym>square centimetre</oboInOwl1:hasExactSynonym>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0000082 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0000082">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_1000082"/>
        <rdfs:comment>&quot;An area unit which is equal to one millionth of a square meter or 10^[-6] m^[2].&quot; [NIST:NIST]</rdfs:comment>
        <rdfs:label>square millimeter</rdfs:label>
        <oboInOwl1:hasExactSynonym>mm^[2]</oboInOwl1:hasExactSynonym>
        <oboInOwl1:hasExactSynonym>square millimetre</oboInOwl1:hasExactSynonym>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0000083 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0000083">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_0000052"/>
        <rdfs:comment>&quot;A mass unit density which is equal to mass of an object in kilograms divided by the volume in cubic meters.&quot; [UOC:GVG]</rdfs:comment>
        <rdfs:label>kilogram per cubic meter</rdfs:label>
        <oboInOwl1:hasExactSynonym>kg/m^[3]</oboInOwl1:hasExactSynonym>
        <oboInOwl1:hasExactSynonym>kilogram per cubic metre</oboInOwl1:hasExactSynonym>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0000084 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0000084">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_1000084"/>
        <rdfs:comment>&quot;A mass unit density which is equal to mass of an object in grams divided by the volume in cubic centimeters.&quot; [UOC:GVG]</rdfs:comment>
        <rdfs:label>gram per cubic centimeter</rdfs:label>
        <oboInOwl1:hasExactSynonym>g/cm^[3]</oboInOwl1:hasExactSynonym>
        <oboInOwl1:hasExactSynonym>gram per cubic centimetre</oboInOwl1:hasExactSynonym>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0000085 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0000085">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_1000085"/>
        <rdfs:comment>&quot;A luminance unit which is equal to a luminous intensity of one candela radiating from a surface whose area is one square meter.&quot; [NIST:NIST]</rdfs:comment>
        <rdfs:label>candela per square meter</rdfs:label>
        <oboInOwl1:hasExactSynonym>candela per square metre</oboInOwl1:hasExactSynonym>
        <oboInOwl1:hasExactSynonym>cd/m^[2]</oboInOwl1:hasExactSynonym>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0000086 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0000086">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/UO_1010049"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/has_prefix"/>
