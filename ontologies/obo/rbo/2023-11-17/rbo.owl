        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/UBPROP_0000008"/>
        <owl:annotatedTarget>In zebrafish, the sinus venosus also acts as a pacemaker and is the first to contract</owl:annotatedTarget>
        <oboInOwl:source>ZFA:0000154</oboInOwl:source>
