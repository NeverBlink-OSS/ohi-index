        <oboInOwl:hasDbXref>FMA:83409</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>type F enteroendocrine cell</oboInOwl:hasExactSynonym>
        <oboInOwl:id>CL:0000696</oboInOwl:id>
        <rdfs:label>PP cell</rdfs:label>
    </owl:Class>
    


