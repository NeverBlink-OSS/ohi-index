        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_0000205"/>
        <rdfs:comment>&quot;A volume per unit volume unit which is equal to one millionth of a liter of solute in one cubic meter of solution.&quot; [NIST:NIST]</rdfs:comment>
        <rdfs:label>milliliter per cubic meter</rdfs:label>
        <oboInOwl1:hasExactSynonym>millilitre per cubic metre</oboInOwl1:hasExactSynonym>
        <oboInOwl1:hasExactSynonym>ml/m^[3]</oboInOwl1:hasExactSynonym>
    </owl:Class>
    


