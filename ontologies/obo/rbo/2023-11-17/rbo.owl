        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_1010037"/>
        <rdfs:comment>&quot;An imperial mass unit which is equivalent to 50.802,345,44 kilograms, 112 pounds, or 8 stone.&quot; [Wikipedia:Wikipedia]</rdfs:comment>
        <rdfs:label>hundredweight</rdfs:label>
        <oboInOwl1:hasExactSynonym>cwt</oboInOwl1:hasExactSynonym>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0010038 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0010038">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_1010038"/>
        <rdfs:comment>&quot;An imperial mass unit which is equivalent to 1,016.046,9088 kilograms, or 2,240 pounds.&quot; [Wikipedia:Wikipedia]</rdfs:comment>
        <rdfs:label>ton</rdfs:label>
        <oboInOwl1:hasExactSynonym>t</oboInOwl1:hasExactSynonym>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0010039 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0010039">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_1010039"/>
        <rdfs:comment>&quot;An imperial gravitational unit which is equivalent to a mass that accelerates by 1ft/s² when a force of one pound (lbf) is exerted on it.&quot; [Wikipedia:Wikipedia]</rdfs:comment>
