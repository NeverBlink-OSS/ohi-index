        <rdfs:label>gamete generation</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/GO_0007276"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>The generation and maintenance of gametes in a multicellular organism. A gamete is a haploid reproductive cell.</owl:annotatedTarget>
