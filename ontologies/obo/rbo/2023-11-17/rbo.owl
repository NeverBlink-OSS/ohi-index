        <obo:IAO_0000115>A broadleaf evergreen forest which is subject to temperate climate patterns.</obo:IAO_0000115>
        <rdfs:comment>This class is one of the forest types as identified by the updated Global Forest Map (GFM 2000).</rdfs:comment>
        <rdfs:label>temperate broadleaf evergreen forest</rdfs:label>
    </owl:Class>
    


