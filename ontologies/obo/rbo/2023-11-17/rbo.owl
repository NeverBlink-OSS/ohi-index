        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A series of radioactive elements from ACTINIUM, atomic number 89, to and including LAWRENCIUM, atomic number 103</obo:IAO_0000115>
        <obo:IAO_0000119 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://purl.bioontology.org/ontology/MESH/D008671</obo:IAO_0000119>
