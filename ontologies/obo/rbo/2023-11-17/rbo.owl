        <oboInOwl:hasDbXref>GAID:917</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MA:0000273</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MESH:D007498</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>NCIT:C12737</oboInOwl:hasDbXref>
