    <!-- http://purl.obolibrary.org/obo/UBERON_0004880 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0004880">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CARO_0000000"/>
