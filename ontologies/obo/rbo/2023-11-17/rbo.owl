        <oboInOwl:hasDbXref>MA:0003185</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MESH:D012154</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>NLX:143558</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>neuronames:1223</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>brain stem reticular formation</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>brainstem reticular formation</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>reticular formation (classical)</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>reticular formation of the brainstem</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>uberon</oboInOwl:hasOBONamespace>
        <oboInOwl:id>UBERON:0002275</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#uberon_slim"/>
        <rdfs:label>reticular formation</rdfs:label>
        <foaf:depicted_by rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://upload.wikimedia.org/wikipedia/commons/9/9b/Gray701.png</foaf:depicted_by>
    </owl:Class>
