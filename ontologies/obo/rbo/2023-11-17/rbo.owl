    <!-- http://purl.obolibrary.org/obo/UBERON_0002063 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0002063">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0004151"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
