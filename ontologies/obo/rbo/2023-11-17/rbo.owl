    <!-- http://purl.obolibrary.org/obo/GO_0007399 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GO_0007399">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0048731"/>
        <obo:IAO_0000115>The process whose specific outcome is the progression of nervous tissue over time, from its formation to its mature state.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>biological_process</oboInOwl:hasOBONamespace>
        <oboInOwl:hasRelatedSynonym>pan-neural process</oboInOwl:hasRelatedSynonym>
