    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CL_0002086 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CL_0002086">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CL_0000746"/>
        <obo:IAO_0000115>A cardiac myocyte that is an excitable cells in the myocardium, specifically in the conducting system of heart.</obo:IAO_0000115>
        <oboInOwl:created_by>tmeehan</oboInOwl:created_by>
        <oboInOwl:creation_date>2010-07-21T01:33:38Z</oboInOwl:creation_date>
        <oboInOwl:hasDbXref>FMA:67968</oboInOwl:hasDbXref>
        <oboInOwl:id>CL:0002086</oboInOwl:id>
        <rdfs:label>specialized cardiac myocyte</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CL_0002092 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CL_0002092">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CL_0001035"/>
        <obo:IAO_0000115>A cell found in the bone marrow. This can include fibroblasts, macrophages, adipocytes, osteoblasts, osteoclasts, endothelial cells and hematopoietic cells.</obo:IAO_0000115>
        <oboInOwl:created_by>tmeehan</oboInOwl:created_by>
        <oboInOwl:creation_date>2010-07-22T04:48:15Z</oboInOwl:creation_date>
        <oboInOwl:hasDbXref>BTO:0004850</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>FMA:83621</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MESH:D001854</oboInOwl:hasDbXref>
        <oboInOwl:id>CL:0002092</oboInOwl:id>
        <rdfs:comment>MH consider whether bone marrow cells are bone cells in the structural sense vs. being part of bone organ sense.</rdfs:comment>
        <rdfs:label>bone marrow cell</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CL_0002095 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CL_0002095">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CL_0000593"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CL_0002132"/>
        <obo:IAO_0000115>A cell in the hilum of the ovary that produces androgens.</obo:IAO_0000115>
        <oboInOwl:created_by>tmeehan</oboInOwl:created_by>
        <oboInOwl:creation_date>2010-08-23T11:18:18Z</oboInOwl:creation_date>
        <oboInOwl:hasDbXref>FMA:18710</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>hilar cell of ovary</oboInOwl:hasExactSynonym>
        <oboInOwl:id>CL:0002095</oboInOwl:id>
        <rdfs:label>hilus cell of ovary</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CL_0002132 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CL_0002132">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CL_0000499"/>
        <obo:IAO_0000115>A stomal cell of the ovary</obo:IAO_0000115>
