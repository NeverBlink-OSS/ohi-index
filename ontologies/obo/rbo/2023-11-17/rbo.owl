        <oboInOwl:hasExactSynonym>tail of embryo</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>uberon</oboInOwl:hasOBONamespace>
        <oboInOwl:hasRelatedSynonym>embryonic tail</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>UBERON:0007144</oboInOwl:id>
        <rdfs:label>embryonic post-anal tail</rdfs:label>
