        <rdfs:label>gallon</rdfs:label>
        <oboInOwl1:hasExactSynonym>gal</oboInOwl1:hasExactSynonym>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0010031 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0010031">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_1010031"/>
        <rdfs:comment>&quot;An imperial mass unit which is equivalent to 64.798,91 milligrams.&quot; [Wikipedia:Wikipedia]</rdfs:comment>
        <rdfs:label>grain</rdfs:label>
        <oboInOwl1:hasExactSynonym>gr</oboInOwl1:hasExactSynonym>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0010032 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0010032">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_1010032"/>
        <rdfs:comment>&quot;An imperial mass unit which is equivalent to 1.771,845,195,3125 grams, or 1/256 of 1 pound.&quot; [Wikipedia:Wikipedia]</rdfs:comment>
        <rdfs:label>drachm</rdfs:label>
        <oboInOwl1:hasExactSynonym>dr</oboInOwl1:hasExactSynonym>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0010033 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0010033">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_1010033"/>
        <rdfs:comment>&quot;An imperial mass unit which is equivalent to 28.349,523,125 grams, or 1/16 of 1 pound.&quot; [Wikipedia:Wikipedia]</rdfs:comment>
        <rdfs:label>ounce</rdfs:label>
        <oboInOwl1:hasExactSynonym>oz</oboInOwl1:hasExactSynonym>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0010034 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0010034">
