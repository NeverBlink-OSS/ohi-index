    <!-- http://purl.obolibrary.org/obo/ENVO_01000276 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_01000276">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_01001110"/>
