                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UO_0000294"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>&quot;A mass unit density which is equal to mass of an object in kilograms divided by the volume in liters.&quot; [UOC:GVG]</rdfs:comment>
        <rdfs:label>kilogram per liter</rdfs:label>
        <oboInOwl1:hasExactSynonym>kg/L</oboInOwl1:hasExactSynonym>
        <oboInOwl1:hasExactSynonym>kilogram per litre</oboInOwl1:hasExactSynonym>
    </owl:Class>
    


