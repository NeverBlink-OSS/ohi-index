    <!-- http://purl.obolibrary.org/obo/UBERON_0001045 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0001045">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0004921"/>
        <rdfs:subClassOf>
