        <oboInOwl:id>CHEBI:33833</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/chebi#3_STAR"/>
        <rdfs:label>heteroarene</rdfs:label>
    </owl:Class>
