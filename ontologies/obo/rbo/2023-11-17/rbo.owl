            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002202"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/CL_0000222"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A non-terminally differentiated cell that is capable of developing into a muscle cell.</obo:IAO_0000115>
        <oboInOwl:id>CL:0000680</oboInOwl:id>
        <rdfs:label>muscle precursor cell</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CL_0000696 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CL_0000696">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CL_0000164"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CL_0000167"/>
        <obo:IAO_0000115>A cell that stores and secretes pancreatic polypeptide hormone.</obo:IAO_0000115>
