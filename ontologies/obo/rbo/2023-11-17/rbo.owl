        <oboInOwl:hasDbXref>VHOG:0000401</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>XAO:0000376</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>XAO:0004147</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>embryonic vitelline vein</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>vascular vitelline network</oboInOwl:hasExactSynonym>
