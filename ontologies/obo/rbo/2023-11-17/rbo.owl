    <!-- http://purl.obolibrary.org/obo/UBERON_0006071 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0006071">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CARO_0000000"/>
