            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>An epithelial cell derived from endoderm.</obo:IAO_0000115>
        <oboInOwl:created_by>tmeehan</oboInOwl:created_by>
        <oboInOwl:creation_date>2010-06-29T03:38:14Z</oboInOwl:creation_date>
        <oboInOwl:hasDbXref>FMA:69075</oboInOwl:hasDbXref>
        <oboInOwl:id>CL:0002076</oboInOwl:id>
        <rdfs:label>endo-epithelial cell</rdfs:label>
    </owl:Class>
    


