        <oboInOwl:hasExactSynonym>tile building roof</oboInOwl:hasExactSynonym>
        <rdfs:label>tiled building roof</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ENVO_01000516 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_01000516">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_01000989"/>
        <obo:IAO_0000115>A fixture which is used primarily for the collection and, in some cases, disposal of human urine and feces.</obo:IAO_0000115>
        <oboInOwl:created_by>ORCID:0000-0002-4366-3088</oboInOwl:created_by>
        <oboInOwl:hasBroadSynonym>toilet</oboInOwl:hasBroadSynonym>
        <rdfs:comment>&quot;disposal&quot; may not be the most precise way to describe fill-in latrines. Note that no assertion is made on whether these fixtures are in- or outdoors.</rdfs:comment>
        <rdfs:label>toilet fixture</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ENVO_01000516"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A fixture which is used primarily for the collection and, in some cases, disposal of human urine and feces.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>https://en.wikipedia.org/wiki/Toilet</oboInOwl:hasDbXref>
    </owl:Axiom>
    


