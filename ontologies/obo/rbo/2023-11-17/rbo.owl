    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UBERON_0002384"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Tissue with cells that deposit non-polarized extracellular matrix including connective tissue fibers and ground substance.</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:resource="http://dx.plos.org/10.1371/journal.pone.0051070"/>
        <oboInOwl:hasDbXref rdf:resource="https://github.com/obophenotype/uberon/issues/23"/>
