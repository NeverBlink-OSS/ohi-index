        <oboInOwl:hasDbXref>FMA:15072</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MA:0001563</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>NCIT:C33874</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>TAO:0005125</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS:C1519988</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ZFA:0005125</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>enteric villi</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>enteric villous</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>enteric villus</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>intestinal villi</oboInOwl:hasExactSynonym>
