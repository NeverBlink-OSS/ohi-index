        <oboInOwl:hasDbXref>NLX:28443</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000125"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/UBPROP_0000001"/>
        <owl:annotatedTarget>Anatomical structure consisting of a discrete aggregate of neuronal soma[GO][GO_REF:0000021].</owl:annotatedTarget>
        <oboInOwl:source>GO_REF:0000021</oboInOwl:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000125"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>neuraxis nucleus</owl:annotatedTarget>
        <oboInOwl:hasDbXref>FMA:83686</oboInOwl:hasDbXref>
    </owl:Axiom>
