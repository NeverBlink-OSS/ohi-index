        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UBERON_0005806"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>portal venous system</owl:annotatedTarget>
        <oboInOwl:hasDbXref>FMA:45628</oboInOwl:hasDbXref>
