        <foaf:depicted_by rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://upload.wikimedia.org/wikipedia/commons/5/56/Limbbuddiagram.jpg</foaf:depicted_by>
    </owl:Class>
