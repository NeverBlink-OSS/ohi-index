    <!-- http://purl.obolibrary.org/obo/CL_0002031 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CL_0002031">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CL_0008001"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001062"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002202"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/CL_0002032"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <owl:disjointWith rdf:resource="http://purl.obolibrary.org/obo/CL_0002032"/>
        <obo:IAO_0000115>A hematopoietic progenitor cell that is capable of developing into only one lineage of hematopoietic cells.</obo:IAO_0000115>
        <oboInOwl:created_by>tmeehan</oboInOwl:created_by>
        <oboInOwl:creation_date>2010-01-06T03:43:20Z</oboInOwl:creation_date>
        <oboInOwl:id>CL:0002031</oboInOwl:id>
        <rdfs:label>hematopoietic lineage restricted progenitor cell</rdfs:label>
