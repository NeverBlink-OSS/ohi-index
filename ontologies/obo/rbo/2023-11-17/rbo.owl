        <oboInOwl:hasRelatedSynonym>vein of omphalomesenteric system</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>vitelline veins</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>UBERON:0005487</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#pheno_slim"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#vertebrate_core"/>
        <rdfs:label>vitelline vein</rdfs:label>
        <foaf:depicted_by rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://upload.wikimedia.org/wikipedia/commons/7/7e/Gray475.png</foaf:depicted_by>
    </owl:Class>
