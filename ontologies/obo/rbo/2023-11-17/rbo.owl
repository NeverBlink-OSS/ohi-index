    <!-- http://purl.obolibrary.org/obo/UBERON_0003887 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0003887">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CARO_0000000"/>
