        <oboInOwl:hasDbXref>BTO:0003689</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>mucous cell</oboInOwl:hasExactSynonym>
        <oboInOwl:id>CL:0000319</oboInOwl:id>
        <rdfs:label>mucus secreting cell</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CL_0000325 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CL_0000325">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CL_0000003"/>
