        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CL_0000003"/>
        <obo:IAO_0000115>A cell that moves by its own activities.</obo:IAO_0000115>
        <oboInOwl:id>CL:0000219</oboInOwl:id>
        <rdfs:label>motile cell</rdfs:label>
    </owl:Class>
    


