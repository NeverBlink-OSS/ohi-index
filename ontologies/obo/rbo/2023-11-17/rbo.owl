        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_0000045"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_1010013"/>
        <rdfs:comment>&quot;A length unit which is equal to 0.3048 metres, or 12 inches.&quot; [Wikipedia:Wikpiedia]</rdfs:comment>
        <rdfs:label>foot</rdfs:label>
        <oboInOwl1:hasExactSynonym>ft</oboInOwl1:hasExactSynonym>
    </owl:Class>
    


