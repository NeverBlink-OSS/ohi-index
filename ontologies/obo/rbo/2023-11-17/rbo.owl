        <owl:annotatedTarget>The part of the skull derived from the embryonic pharyngeal arches. [Biology_Online][VHOG]</owl:annotatedTarget>
        <oboInOwl:date_retrieved rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2012-09-17</oboInOwl:date_retrieved>
