            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>The double lipid bilayer enclosing the nucleus and separating its contents from the rest of the cytoplasm; includes the intermembrane space, a gap of width 20-40 nm (also called the perinuclear space).</obo:IAO_0000115>
        <oboInOwl:hasAlternativeId>GO:0005636</oboInOwl:hasAlternativeId>
        <oboInOwl:hasDbXref>Wikipedia:Nuclear_envelope</oboInOwl:hasDbXref>
