        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_1000203"/>
        <rdfs:comment>&quot;A catalytic (activity) concentration unit which is equal to 1 katal activity of a catalyst in a given volume of one cubic meter.&quot; [NIST:NIST]</rdfs:comment>
        <rdfs:label>katal per cubic meter</rdfs:label>
        <oboInOwl1:hasExactSynonym>kat/m^[3]</oboInOwl1:hasExactSynonym>
        <oboInOwl1:hasExactSynonym>katal per cubic metre</oboInOwl1:hasExactSynonym>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0000204 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0000204">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_1000204"/>
        <rdfs:comment>&quot;A catalytic (activity) concentration unit which is equal to 1 katal activity of a catalyst in a given volume of one thousandth of a cubic meter.&quot; [NIST:NIST]</rdfs:comment>
        <rdfs:label>katal per liter</rdfs:label>
        <oboInOwl1:hasExactSynonym>kat/l</oboInOwl1:hasExactSynonym>
        <oboInOwl1:hasExactSynonym>katal per litre</oboInOwl1:hasExactSynonym>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0000205 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0000205">
