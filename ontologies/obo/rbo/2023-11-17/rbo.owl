        <oboInOwl:hasDbXref>HAO:0000666</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MAT:0000143</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MIAA:0000143</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>omatidium</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>uberon</oboInOwl:hasOBONamespace>
        <oboInOwl:hasRelatedSynonym>omatidia</oboInOwl:hasRelatedSynonym>
