        <owl:disjointWith rdf:resource="http://purl.obolibrary.org/obo/ENVO_01000033"/>
        <obo:IAO_0000115>The neritic epipelagic zone biome comprises the marine water column above a continental shelf.</obo:IAO_0000115>
        <oboInOwl:created_by rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ORCID:0000-0002-4366-3088</oboInOwl:created_by>
