    <!-- http://purl.obolibrary.org/obo/UBERON_0003078 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0003078">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0009955"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000010"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
