    <!-- http://purl.obolibrary.org/obo/UO_0000177 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0000177">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_0000051"/>
        <rdfs:comment>&quot;A concentration unit which is a standard measure of the number of units, as an agreed arbitrary amount, of a given substance per a specific volume of solution.&quot; [Webmd:Webmd]</rdfs:comment>
        <rdfs:label>unit per volume unit</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0000178 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0000178">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_1000178"/>
        <rdfs:comment>&quot;A unit per milliliter unit which is equal to one unit of an agreed arbitrary amount per one milliliter.&quot; [Webmd:Webmd]</rdfs:comment>
        <rdfs:label>unit per milliliter</rdfs:label>
        <oboInOwl1:hasExactSynonym>U/ml</oboInOwl1:hasExactSynonym>
        <oboInOwl1:hasExactSynonym>unit per millilitre</oboInOwl1:hasExactSynonym>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0000179 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0000179">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_1000179"/>
        <rdfs:comment>&quot;A unit per milliliter unit which is equal to one unit of an agreed arbitrary amount per one liter.&quot; [UOC:GVG]</rdfs:comment>
        <rdfs:label>unit per liter</rdfs:label>
        <oboInOwl1:hasExactSynonym>U/l</oboInOwl1:hasExactSynonym>
        <oboInOwl1:hasExactSynonym>unit per litre</oboInOwl1:hasExactSynonym>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0000180 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0000180">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_1000180"/>
        <rdfs:comment>&quot;A concentration unit which is a standard measure of the mass of a substance in a given volume (density).&quot; [Wikipedia:Wikipedia]</rdfs:comment>
        <rdfs:label>mass per unit volume</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0000181 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0000181">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_1000181"/>
        <rdfs:comment>&quot;A catalytic unit activity which is equal to the amount of the enzyme that catalyzes the conversion of 1 micro mole of substrate per minute.&quot; [Wikipedia:Wikipedia]</rdfs:comment>
        <rdfs:label>enzyme unit</rdfs:label>
        <oboInOwl1:hasExactSynonym>U</oboInOwl1:hasExactSynonym>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0000182 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0000182">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_0000000"/>
        <rdfs:comment>&quot;A unit which is a standard measure of the influence exerted by some mass.&quot; [Wikipedia:Wikipedia]</rdfs:comment>
        <rdfs:label>density unit</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0000183 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0000183">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_0000182"/>
        <rdfs:comment>&quot;A density unit which is a standard measure of the mass exerting an influence on a one-dimensional object.&quot; [Wikipedia:Wikipedia]</rdfs:comment>
        <rdfs:label>linear density unit</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0000184 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0000184">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_0000183"/>
        <rdfs:comment>&quot;An area density unit which is equal to the mass of an object in kilograms divided by one meter.&quot; [NIST:NIST]</rdfs:comment>
        <rdfs:label>kilogram per meter</rdfs:label>
        <oboInOwl1:hasExactSynonym>kg/m</oboInOwl1:hasExactSynonym>
        <oboInOwl1:hasExactSynonym>kilogram per metre</oboInOwl1:hasExactSynonym>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0000185 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0000185">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_1000185"/>
        <rdfs:comment>&quot;A plane angle unit which is equal to 1/360 of a full rotation or 1.7453310^[-2] rad.&quot; [Wikipedia:Wikipedia]</rdfs:comment>
        <rdfs:label>degree</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0000186 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0000186">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_0000000"/>
        <rdfs:comment>&quot;A unit which is a standard measure of physical quantity consisting of only a numerical number without any units.&quot; [Wikipedia:Wikipedia]</rdfs:comment>
        <rdfs:label>dimensionless unit</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0000187 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0000187">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_0000190"/>
        <rdfs:comment>&quot;A dimensionless ratio unit which denotes numbers as fractions of 100.&quot; [Wikipedia:Wikipedia]</rdfs:comment>
        <rdfs:label>percent</rdfs:label>
        <oboInOwl1:hasExactSynonym>%</oboInOwl1:hasExactSynonym>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0000188 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0000188">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_1000188"/>
        <rdfs:comment>&quot;A dimensionless unit which denoted an irrational real number, approximately equal to 3.14159 which is the ratio of a circle&apos;s circumference to its diameter in Euclidean geometry.&quot; [Wikipedia:Wikipedia]</rdfs:comment>
        <rdfs:label>pi</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0000189 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0000189">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_0000186"/>
        <rdfs:comment>&quot;A dimensionless unit which denotes a simple count of things.&quot; [MGED:MGED]</rdfs:comment>
        <rdfs:label>count unit</rdfs:label>
        <oboInOwl1:hasExactSynonym>count</oboInOwl1:hasExactSynonym>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0000190 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0000190">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_0000186"/>
        <rdfs:comment>&quot;A dimensionless unit which denotes an amount or magnitude of one quantity relative to another.&quot; [Wikipedia:Wikipedia]</rdfs:comment>
        <rdfs:label>ratio</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0000191 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0000191">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_0000190"/>
        <rdfs:comment>&quot;A dimensionless ratio unit which relates the part (the numerator) to the whole (the denominator).&quot; [Wikipedia:Wikipedia]</rdfs:comment>
        <rdfs:label>fraction</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0000192 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0000192">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_1000192"/>
        <rdfs:comment>&quot;A dimensionless count unit which denotes the number of molecules.&quot; [MGED:MGED]</rdfs:comment>
        <rdfs:label>molecule count</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0000193 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0000193">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_1000193"/>
        <rdfs:comment>&quot;A dimensionless percent unit which denotes the homogeneity of a biomaterial.&quot; [MGED:MGED]</rdfs:comment>
        <rdfs:label>purity percentage</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0000194 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0000194">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_1000194"/>
        <rdfs:comment>&quot;A dimensionless percent unit which denotes the density of an attached or monolayer culture (e.g., cell culture).&quot; [MGED:MGED]</rdfs:comment>
        <rdfs:label>confluence percentage</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0000195 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0000195">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_1000195"/>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0000196 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0000196">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_1000196"/>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0000197 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0000197">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_1000197"/>
        <rdfs:comment>&quot;A specific volume unit which is equal to one liter volume occupied by one kilogram of a particular substance.&quot; [NIST:NIST]</rdfs:comment>
        <rdfs:label>liter per kilogram</rdfs:label>
        <oboInOwl1:hasExactSynonym>l/kg</oboInOwl1:hasExactSynonym>
        <oboInOwl1:hasExactSynonym>litre per kilogram</oboInOwl1:hasExactSynonym>
    </owl:Class>
    


