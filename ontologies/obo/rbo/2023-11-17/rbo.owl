        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CL_0000003"/>
        <obo:IAO_0000115>A cell whose function is determined by the generation or the reception of an electric signal.</obo:IAO_0000115>
        <oboInOwl:id>CL:0000211</oboInOwl:id>
        <rdfs:label>electrically active cell</rdfs:label>
    </owl:Class>
    


