    <!-- http://purl.obolibrary.org/obo/UBERON_0004022 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0004022">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0005291"/>
