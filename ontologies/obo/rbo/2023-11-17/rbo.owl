    <!-- http://purl.obolibrary.org/obo/CL_0000027 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CL_0000027">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/CL_0000192"/>
