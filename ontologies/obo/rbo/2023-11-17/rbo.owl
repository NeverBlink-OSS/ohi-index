                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/uberon/core#extends_fibers_into"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001645"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>The sensory trigeminal nerve nuclei are the largest of the cranial nerve nuclei, and extend through the whole of the midbrain, pons and medulla. There is also a distinct trigeminal motor nucleus that is medial to the chief sensory nucleus[WP].</obo:IAO_0000115>
        <obo:UBPROP_0000012>in MA and FMA this is part of the pons / pontime tegmentum. We weaken this to overlaps to avoid inconsistency. In NIF this is a composite structure spanning multiple regions, which is more appropriate.</obo:UBPROP_0000012>
        <oboInOwl:hasDbXref rdf:resource="http://en.wikipedia.org/wiki/Trigeminal_nerve_nuclei"/>
        <oboInOwl:hasDbXref rdf:resource="http://linkedlifedata.com/resource/umls/id/C0040999"/>
        <oboInOwl:hasDbXref>BIRNLEX:4096</oboInOwl:hasDbXref>
