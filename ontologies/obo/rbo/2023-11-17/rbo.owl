        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000162"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDbXref"/>
        <owl:annotatedTarget>UMLS:C0008987</owl:annotatedTarget>
        <oboInOwl:source>ncithesaurus:Cloaca</oboInOwl:source>
    </owl:Axiom>
