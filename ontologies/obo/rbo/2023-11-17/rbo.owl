                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002007"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001049"/>
            </owl:Restriction>
        </rdfs:subClassOf>
