                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ENVO_00000447"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A significant accumulation of water which is part of a marine biome.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>body of marine water</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>marine waterbody</oboInOwl:hasExactSynonym>
        <rdfs:comment>Ideas like &quot;significant&quot; are fuzzy and need to be modelled more accurately. The definition is a candidate for review.</rdfs:comment>
        <rdfs:label>marine water body</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ENVO_00002000 -->

