        <oboInOwl1:hasExactSynonym>metric teaspoon</oboInOwl1:hasExactSynonym>
        <oboInOwl1:hasExactSynonym>tsp</oboInOwl1:hasExactSynonym>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0010048 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0010048">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
