        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/uo.owl"/>
        <rdfs:comment>&quot;A unit which is a standard measure of the amount of space occupied by any substance, whether solid, liquid, or gas.&quot; [NIST:NIST]</rdfs:comment>
        <rdfs:label>volume unit</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0000096 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0000096">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_1000096"/>
        <rdfs:comment>&quot;A volume unit which is equal to the volume of a cube with edges one meter in length. One cubic meter equals to 1000 liters.&quot; [NIST:NIST]</rdfs:comment>
        <rdfs:label>cubic meter</rdfs:label>
        <oboInOwl1:hasExactSynonym>cubic metre</oboInOwl1:hasExactSynonym>
        <oboInOwl1:hasExactSynonym>m^[3]</oboInOwl1:hasExactSynonym>
    </owl:Class>
    


