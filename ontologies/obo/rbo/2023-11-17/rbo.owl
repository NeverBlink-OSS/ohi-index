    <!-- http://www.ebi.ac.uk/efo/EFO_0004005 -->

    <owl:Class rdf:about="http://www.ebi.ac.uk/efo/EFO_0004005">
        <rdfs:subClassOf rdf:resource="http://www.ebi.ac.uk/efo/EFO_0004000"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                <owl:someValuesFrom rdf:resource="http://www.ebi.ac.uk/efo/EFO_0004429"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>An inbred strain carrying one or more phenotypic mutations. For example, the mutant strain C3H/H3eSn-bc3J/J carries the bouncy 3 Jackson phenotypic mutation.</obo:IAO_0000115>
        <efo:definition_citation>http://www.findmice.org/glossary.jsp</efo:definition_citation>
        <rdfs:label>inbred Mus musculus strain</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ebi.ac.uk/efo/EFO_0004429 -->

    <owl:Class rdf:about="http://www.ebi.ac.uk/efo/EFO_0004429">
