                        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ENVO_01001357"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_01000017"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ENVO_01001357"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Sand which is part of a desert.</obo:IAO_0000115>
        <rdfs:label>desert sand</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ENVO_00005803 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_00005803">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_01001813"/>
        <obo:IAO_0000115>The dwelling of an animal or group of similar animals.</obo:IAO_0000115>
