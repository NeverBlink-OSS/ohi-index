        <oboInOwl:hasDbXref>OpenCyc:Mx4rvVjHq5wpEbGdrcN5Y29ycA</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS:C0026727</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>galen:Mucus</oboInOwl:hasDbXref>
