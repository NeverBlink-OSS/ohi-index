        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>An exchangeable device which can be connected to a plumbing system to deliver and drain water.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>https://en.wikipedia.org/wiki/Plumbing_fixture</oboInOwl:hasDbXref>
    </owl:Axiom>
    


