        <obo:IAO_0000115>A manufactured product which is designed to catch and hold animals.</obo:IAO_0000115>
        <oboInOwl:inSubset>envoCesab</oboInOwl:inSubset>
        <rdfs:label xml:lang="en">animal trap</rdfs:label>
    </owl:Class>
    <owl:Axiom>
