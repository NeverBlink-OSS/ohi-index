        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PATO_0002303"/>
        <obo:IAO_0000115>A positional which is relatively low.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>low position</oboInOwl:hasRelatedSynonym>
        <rdfs:label>decreased position</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/PATO_0001481 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PATO_0001481">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PATO_0000052"/>
        <obo:IAO_0000115>A shape quality inhering in a bearer by virtue of the bearer&apos;s having an oblique or slanted direction.</obo:IAO_0000115>
        <rdfs:label>sloped</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/PATO_0001543 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PATO_0001543">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PATO_0001546"/>
        <obo:IAO_0000115>A physical quality inhering in a bearer by virtue of the bearer&apos;s disposition to being turned, bowed, or twisted without breaking.</obo:IAO_0000115>
        <rdfs:label>flexibility</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/PATO_0001545 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PATO_0001545">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PATO_0001543"/>
        <obo:IAO_0000115>A physical quality inhering in a bearer by virtue of the bearer&apos;s inability of being turned, bowed, or twisted without breaking.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>stiff</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>stiffness</oboInOwl:hasRelatedSynonym>
        <rdfs:label>inflexible</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/PATO_0001546 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PATO_0001546">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PATO_0002198"/>
        <obo:IAO_0000115>A physical quality inhering in a bearer by virtue of the bearer&apos;s exhibiting the physical characteristics of an entity characterized by particles arranged such that their shape and volume are relatively stable.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>solidity</oboInOwl:hasExactSynonym>
        <rdfs:label>quality of a solid</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/PATO_0001547 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PATO_0001547">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PATO_0002198"/>
        <obo:IAO_0000115>A physical quality inhering in a bearer by virtue of the bearer&apos;s exhibiting the physical characteristics of an entity consisting of particles that have neither a defined volume nor defined shape.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>gaseous</oboInOwl:hasExactSynonym>
        <rdfs:label>quality of a gas</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/PATO_0001548 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PATO_0001548">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PATO_0002198"/>
        <obo:IAO_0000115>A physical quality inhering in an entity exhibiting the physical characteristics of an amorphous (non-crystalline) form of matter between a gas and a solid that has a definite volume, but no definite shape.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>liquidity</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>quality</oboInOwl:hasOBONamespace>
        <oboInOwl:id>PATO:0001548</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/pato#attribute_slim"/>
        <rdfs:label>quality of a liquid</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/PATO_0001548"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A physical quality inhering in an entity exhibiting the physical characteristics of an amorphous (non-crystalline) form of matter between a gas and a solid that has a definite volume, but no definite shape.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>url:http://www.chemistry-dictionary.com/definition/liquid.php</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/PATO_0001563 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PATO_0001563">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PATO_0000125"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PATO_0002305"/>
        <obo:IAO_0000115>A mass which is higher than normal or average.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>high mass</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>large mass</oboInOwl:hasExactSynonym>
        <rdfs:label>increased mass</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/PATO_0001579 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PATO_0001579">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PATO_0001018"/>
        <rdfs:label>contractility</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/PATO_0001591 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PATO_0001591">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PATO_0000052"/>
        <obo:IAO_0000115>A surface shape quality inhering in a bearer by virtue of the bearer&apos;s exhibiting a degree of bending.</obo:IAO_0000115>
        <rdfs:label>curvature</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/PATO_0001655 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PATO_0001655">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PATO_0000033"/>
        <obo:IAO_0000115>A concentration quality inhering in a bearer by virtue of the bearer&apos;s amount of osmoles of solute per liter of solution.</obo:IAO_0000115>
        <rdfs:label>osmolarity</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/PATO_0001657 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PATO_0001657">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PATO_0001655"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PATO_0002305"/>
        <obo:IAO_0000115>A osmolarity which is relatively high.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>high osmolarity</oboInOwl:hasExactSynonym>
        <rdfs:label>increased osmolarity</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/PATO_0001687 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PATO_0001687">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PATO_0000140"/>
        <obo:IAO_0000115>A positional quality inhering in a bearer by virtue of the bearer&apos;s vertical distance of a point above or below a reference surface.</obo:IAO_0000115>
        <rdfs:label>elevation</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/PATO_0001689 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PATO_0001689">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PATO_0001476"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PATO_0001687"/>
        <obo:IAO_0000115>An elevation which is relatively low.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>low elevation</oboInOwl:hasExactSynonym>
        <rdfs:label>decreased elevation</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/PATO_0001690 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PATO_0001690">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PATO_0001579"/>
        <rdfs:label>contractile</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/PATO_0001693 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PATO_0001693">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PATO_0000998"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PATO_0002305"/>
        <obo:IAO_0000115>A viscosity which relatively high.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>high viscosity</oboInOwl:hasExactSynonym>
        <rdfs:label>increased viscosity</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/PATO_0001729 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PATO_0001729">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PATO_0001995"/>
        <obo:IAO_0000115>An organismal quality inhering in a bearer by virtue of the bearer&apos;s disposition to lose an entitity by natural process.</obo:IAO_0000115>
        <rdfs:label>shedability</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/PATO_0001731 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PATO_0001731">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PATO_0001729"/>
        <obo:IAO_0000115>A quality inhering in a plant by virtue of the bearer&apos;s disposition to shed foliage.</obo:IAO_0000115>
        <rdfs:label>deciduous (plant)</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/PATO_0001733 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PATO_0001733">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PATO_0001729"/>
        <obo:IAO_0000115>A quality inhering in a plant by virtue of the bearer&apos;s disposition to retain foliage.</obo:IAO_0000115>
        <rdfs:label>evergreen (plant)</rdfs:label>
    </owl:Class>
    


