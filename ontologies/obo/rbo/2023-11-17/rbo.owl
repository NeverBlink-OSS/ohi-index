    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001895"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/UBPROP_0000001"/>
        <owl:annotatedTarget>The anterior of two brain vesicles formed by specialization of the rhombencephalon in the developing embryo. It gives rise to cerebellum and pons. [TFD][VHOG]</owl:annotatedTarget>
