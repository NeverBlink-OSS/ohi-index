    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_03510037">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_00010483"/>
        <obo:IAO_0000115>Any material containing unstable atoms that emit ionizing radiation as it decays.</obo:IAO_0000115>
        <dc:creator rdf:resource="http://orcid.org/0000-0002-7463-6306"/>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-08-03T18:32:42Z</dc:date>
        <rdfs:label xml:lang="en">radioactive material</rdfs:label>
    </owl:Class>
    <owl:Axiom>
