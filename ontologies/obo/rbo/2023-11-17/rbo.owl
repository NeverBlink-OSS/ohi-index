        <oboInOwl:hasDbXref>TAO:0001061</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>VHOG:0000225</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>XAO:0004165</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ZFA:0001061</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>intersegmental artery</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>uberon</oboInOwl:hasOBONamespace>
        <oboInOwl:hasRelatedSynonym>intersegmental arteries</oboInOwl:hasRelatedSynonym>
