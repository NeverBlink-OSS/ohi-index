        <rdfs:label>epithelial cell of tracheobronchial tree</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CL_0002209 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CL_0002209">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CL_0002202"/>
        <obo:IAO_0000115>An epithelial cell present in the trachea and bronchi; columnar in shape; generally lack cilia; immature forms of ciliated or secretory cells which have been formed from stem cells.</obo:IAO_0000115>
        <oboInOwl:created_by>tmeehan</oboInOwl:created_by>
        <oboInOwl:creation_date>2010-09-02T02:53:59Z</oboInOwl:creation_date>
