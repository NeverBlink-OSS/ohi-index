        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <obo:IAO_0000115>Relation between occurrents, shares a start boundary with.</obo:IAO_0000115>
        <obo:IAO_0000115>inverse of starts with</obo:IAO_0000115>
        <obo:IAO_0000117>Chris Mungall</obo:IAO_0000117>
        <obo:IAO_0000119>Allen</obo:IAO_0000119>
        <oboInOwl:hasDbXref>RO:0002223</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace>uberon</oboInOwl:hasOBONamespace>
        <oboInOwl:id>starts</oboInOwl:id>
