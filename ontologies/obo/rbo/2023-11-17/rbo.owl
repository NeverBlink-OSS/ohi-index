    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0002546">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0005085"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000033"/>
            </owl:Restriction>
