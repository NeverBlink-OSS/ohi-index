        </owl:propertyChainAxiom>
        <rdfs:label xml:lang="en">contained in</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.obolibrary.org/obo/RO_0001019 -->

    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/RO_0001019">
        <oboInOwl:hasDbXref>RO:0001019</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace>uberon</oboInOwl:hasOBONamespace>
        <oboInOwl:id>contains</oboInOwl:id>
