        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000120"/>
        <obo:IAO_0000115>A device that is used to generate X-rays.</obo:IAO_0000115>
        <obo:IAO_0000117>PERSON: Erik Segerdell</obo:IAO_0000117>
        <obo:IAO_0000118>x-ray generator</obo:IAO_0000118>
        <obo:IAO_0000119>http://en.wikipedia.org/wiki/X-ray_generator</obo:IAO_0000119>
        <oboInOwl:hasAlternativeId>CHMO:0000944</oboInOwl:hasAlternativeId>
        <oboInOwl:hasExactSynonym>X-ray generator</oboInOwl:hasExactSynonym>
        <oboInOwl:id>OBI:0001138</oboInOwl:id>
        <rdfs:label>X-ray source</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/OBI_0001138"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A device that is used to generate X-rays.</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">obi:es</oboInOwl:hasDbXref>
