                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/has_prefix"/>
                        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UO_0000299"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_1000013"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/has_prefix"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UO_0000299"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>&quot;A substance unit which is equal to one millionth of a mole.&quot; [UOB:LTS]</rdfs:comment>
        <rdfs:label>micromole</rdfs:label>
        <oboInOwl1:hasExactSynonym>mmol</oboInOwl1:hasExactSynonym>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0010049 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0010049">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_1010049"/>
        <rdfs:comment>&quot;An area density unit which is equal to the mass of an object in grams divided by the surface area in meters squared.&quot; [NIST:NIST]</rdfs:comment>
        <rdfs:label>gram per square meter</rdfs:label>
        <oboInOwl1:hasExactSynonym>g/m^[2]</oboInOwl1:hasExactSynonym>
