    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/PATO_0000169 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PATO_0000169">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PATO_0001995"/>
        <obo:IAO_0000115>An organismal quality inhering in a bearer or a population by virtue of the bearer&apos;s disposition to survive and develop normally or the number of surviving individuals in a given population.</obo:IAO_0000115>
        <rdfs:label>viability</rdfs:label>
    </owl:Class>
    


