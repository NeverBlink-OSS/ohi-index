        <oboInOwl:hasExactSynonym>land conversion</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>land development</oboInOwl:hasExactSynonym>
        <rdfs:comment>Further examples include subdividing real estate into lots, typically for the purpose of building homes and converting unused factories into condominia.</rdfs:comment>
        <rdfs:label xml:lang="en">land conversion process</rdfs:label>
    </owl:Class>
