        <oboInOwl:hasDbXref>TAO:0000056</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS:C0031354</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>VHOG:0000462</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>XAO:0003227</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ZFA:0000056</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>galen:Pharynx</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace>uberon</oboInOwl:hasOBONamespace>
        <oboInOwl:id>UBERON:0001042</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#efo_slim"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#pheno_slim"/>
