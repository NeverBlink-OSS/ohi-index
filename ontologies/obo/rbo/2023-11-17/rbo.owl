                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0003115"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>An ectoderm that is part of a pharyngeal arch 4.</obo:IAO_0000115>
        <obo:UBPROP_0000003>In all vertebrates, the pharyngeal apparatus develops from a series of bulges found on the lateral surface of the head, the pharyngeal arches, which consist of a number of different embryonic cell types. Each arch has an external covering of ectoderm and inner covering of endoderm, and between these a mesenchymal filling of neural crest with a central core of mesoderm.[well established][VHOG]</obo:UBPROP_0000003>
        <oboInOwl:hasDbXref>EHDAA2:0004032</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>EMAPA:16762</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>EMAPA:16764</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>EMAPA:16768</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>RETIRED_EHDAA2:0000094</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>VHOG:0001095</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>4th pharyngeal arch ectoderm</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>uberon</oboInOwl:hasOBONamespace>
        <oboInOwl:id>UBERON:0005662</oboInOwl:id>
        <rdfs:label>4th arch ectoderm</rdfs:label>
    </owl:Class>
