        <owl:annotatedTarget>lien</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:resource="http://en.wikipedia.org/wiki/Spleen"/>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/uberon/core#LATIN"/>
    </owl:Axiom>
    


