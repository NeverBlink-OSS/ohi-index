    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0001679">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0002513"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0003462"/>
