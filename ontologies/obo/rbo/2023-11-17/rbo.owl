    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/RBO_00000048">
        <rdf:type rdf:resource="http://purl.obolibrary.org/obo/RBO_00000121"/>
        <obo:IAO_0000112 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The experiment was carried out at the SIS-18 accelerator.</obo:IAO_0000112>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An particle accelerator located at the GSI Helmholtz Centre for Heavy Ion Research, Darmstadt, Germay.</obo:IAO_0000115>
