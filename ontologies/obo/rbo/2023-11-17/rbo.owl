    <!-- http://purl.obolibrary.org/obo/PATO_0001411 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PATO_0001411">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PATO_0000141"/>
        <obo:IAO_0000115>A structural quality inhering in a bearer by virtue of the bearer&apos;s having distinct structure.</obo:IAO_0000115>
        <rdfs:label>structured</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/PATO_0001412 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PATO_0001412">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PATO_0000141"/>
        <obo:IAO_0000115>A structural quality inhering in a bearer by virtue of the bearer&apos;s lacking distinct structure.</obo:IAO_0000115>
        <rdfs:label>unstructured</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/PATO_0001422 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PATO_0001422">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PATO_0000169"/>
        <obo:IAO_0000115>A viability quality inhering in a bearer by virtue of the cessation of the bearer&apos;s life.</obo:IAO_0000115>
        <rdfs:label>dead</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/PATO_0001428 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PATO_0001428">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PATO_0001842"/>
        <obo:IAO_0000115>A concentration quality inhering in a medium by virtue of the bearer&apos;s tendency to hydronate a specific reference base.</obo:IAO_0000115>
        <rdfs:label>medium acidity</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/PATO_0001429 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PATO_0001429">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PATO_0001428"/>
        <obo:IAO_0000115>An medium acidity quality inhering in a solution by virtue of the bearer&apos;s a high concentration of H+ ions.</obo:IAO_0000115>
        <rdfs:label>acidic</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/PATO_0001476 -->

