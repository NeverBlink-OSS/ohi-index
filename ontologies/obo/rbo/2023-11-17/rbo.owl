    <!-- http://purl.obolibrary.org/obo/GO_0009584 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GO_0009584">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0009583"/>
        <obo:IAO_0000115>The series of events in which a visible light stimulus is received by a cell and converted into a molecular signal. A visible light stimulus is electromagnetic radiation that can be perceived visually by an organism; for organisms lacking a visual system, this can be defined as light with a wavelength within the range 380 to 780 nm.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>biological_process</oboInOwl:hasOBONamespace>
        <oboInOwl:hasRelatedSynonym>perception of visible light</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>GO:0009584</oboInOwl:id>
        <rdfs:label>detection of visible light</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/GO_0009584"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>The series of events in which a visible light stimulus is received by a cell and converted into a molecular signal. A visible light stimulus is electromagnetic radiation that can be perceived visually by an organism; for organisms lacking a visual system, this can be defined as light with a wavelength within the range 380 to 780 nm.</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">GOC:go_curators</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ISBN:0198506732</oboInOwl:hasDbXref>
    </owl:Axiom>
    


