        <oboInOwl:hasOBONamespace>biological_process</oboInOwl:hasOBONamespace>
        <oboInOwl:id>GO:0071479</oboInOwl:id>
        <rdfs:label>cellular response to ionizing radiation</rdfs:label>
    </owl:Class>
