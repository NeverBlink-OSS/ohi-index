        <oboInOwl:hasDbXref>FMA:62948</oboInOwl:hasDbXref>
        <oboInOwl:id>CL:0002178</oboInOwl:id>
        <rdfs:label>epithelial cell of stomach</rdfs:label>
    </owl:Class>
    


