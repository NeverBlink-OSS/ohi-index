    <!-- http://purl.obolibrary.org/obo/UBERON_0004345 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0004345">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000490"/>
