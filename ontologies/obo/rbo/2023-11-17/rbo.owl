        <oboInOwl:hasDbXref>EMAPA:16706</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>EV:0100065</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>FMA:46688</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>GAID:155</oboInOwl:hasDbXref>
