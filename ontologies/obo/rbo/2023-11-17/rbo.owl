                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002507"/>
                        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ENVO_00010483"/>
                    </owl:Restriction>
