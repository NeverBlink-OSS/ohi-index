                        </owl:unionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </owl:annotatedTarget>
        <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://github.com/EnvironmentOntology/envo/issues/900</rdfs:seeAlso>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ENVO_01001136 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_01001136">
