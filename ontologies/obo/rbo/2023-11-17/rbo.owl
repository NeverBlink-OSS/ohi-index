    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UBERON_0002407"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/UBPROP_0000012"/>
        <owl:annotatedTarget>In GO the concept of pericardium is developmental implicitly epithelial, but here it represents a multi-tissue structure encompassing the sac (epithelium plus connective) and cavity</owl:annotatedTarget>
        <oboInOwl:external_ontology rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FMA</oboInOwl:external_ontology>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UBERON_0002407"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/UBPROP_0000012"/>
        <owl:annotatedTarget>this class denotes a combination of fibrous PC + PC sac (itself a combination of cavity, epithelium and connective tissue). Many sources use the term &apos;pericardium&apos; to denote either just the serous membrane (ZFA) or the epithelium (GO)</owl:annotatedTarget>
        <oboInOwl:external_ontology>ZFA</oboInOwl:external_ontology>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UBERON_0002407"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/UBPROP_0000012"/>
        <owl:annotatedTarget>we follow FMA in dividing pericardium into pericardial sac and fibrous pericardium</owl:annotatedTarget>
        <oboInOwl:external_ontology rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FMA</oboInOwl:external_ontology>
