    <!-- http://purl.obolibrary.org/obo/CL_0000158 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CL_0000158">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CL_0000157"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CL_0002328"/>
        <obo:IAO_0000115>Epithelial progenitor cell of the lung. Club cells are dome-shaped with short microvilli but no cilia. They function to protect the bronchiolar epithelium. Club cells also multiply and differentiate into ciliated cells to regenerate the bronchiolar epithelium.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>BTO:0004811</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>FMA:14119</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>Clara cell</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>bronchiolar non-ciliated cell</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>club cell of bronchiole</oboInOwl:hasExactSynonym>
        <oboInOwl:id>CL:0000158</oboInOwl:id>
        <rdfs:label>club cell</rdfs:label>
    </owl:Class>
    


