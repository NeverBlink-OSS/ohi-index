            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Water which contains a significant concentration of dissolved salts.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>EcoLexicon:saltwater</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SWEETRealm:SalineWater</oboInOwl:hasDbXref>
