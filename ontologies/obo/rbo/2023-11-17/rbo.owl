        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PATO_0002305"/>
        <obo:IAO_0000115>A hardness quality of being rigid and resistant to pressure.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>firm</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>impenetrable</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>tough</oboInOwl:hasRelatedSynonym>
        <rdfs:label>hard</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/PATO_0000389 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PATO_0000389">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PATO_0001309"/>
        <obo:IAO_0000115>A quality of a process inhering in a bearer by virtue of the bearer&apos;s having a sudden onset, sharp rise, and short course.</obo:IAO_0000115>
