        <oboInOwl:hasExactSynonym>red blood cell</oboInOwl:hasExactSynonym>
        <oboInOwl:id>CL:0000232</oboInOwl:id>
        <rdfs:label>erythrocyte</rdfs:label>
    </owl:Class>
    


