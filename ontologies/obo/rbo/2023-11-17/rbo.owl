            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>&quot;A specific volume unit which is equal to one millionth of a liter per kilogram or 10^[-6] l/kg.&quot; [NIST:NIST]</rdfs:comment>
