        <obo:IAO_0000115>An increase in humidity.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>humid</oboInOwl:hasRelatedSynonym>
        <rdfs:label>increased humidity</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/PATO_0015021 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PATO_0015021">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PATO_0001018"/>
        <obo:IAO_0000115>The propensity of a material to undergo combustion. Combustion encompasses smouldering and flaming combustion. Combustibility is usually applied to solids.</obo:IAO_0000115>
        <rdfs:label>combustibility</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/PATO_0015022 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PATO_0015022">
