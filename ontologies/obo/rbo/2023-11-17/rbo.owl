        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CL_0000327"/>
        <obo:IAO_0000115>An extracellular matrix secreting cell that secretes collagen.</obo:IAO_0000115>
        <oboInOwl:id>CL:0000667</oboInOwl:id>
        <rdfs:label>collagen secreting cell</rdfs:label>
    </owl:Class>
    


