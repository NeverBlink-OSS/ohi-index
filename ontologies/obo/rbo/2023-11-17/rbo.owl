        <rdfs:label>pound</rdfs:label>
        <oboInOwl1:hasExactSynonym>lb</oboInOwl1:hasExactSynonym>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0010035 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0010035">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_1010035"/>
