    <!-- http://purl.obolibrary.org/obo/GO_0005902 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GO_0005902">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0098858"/>
