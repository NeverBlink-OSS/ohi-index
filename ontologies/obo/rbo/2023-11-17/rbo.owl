        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CL_0000003"/>
        <obo:IAO_0000115>A cell whose primary function is to prevent the transport of stuff across compartments.</obo:IAO_0000115>
        <oboInOwl:id>CL:0000215</oboInOwl:id>
        <rdfs:label>barrier cell</rdfs:label>
    </owl:Class>
    


