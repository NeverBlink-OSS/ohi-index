        <oboInOwl:hasDbXref>MA:0000475</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>VHOG:0001196</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>arcus aortae</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>uberon</oboInOwl:hasOBONamespace>
        <oboInOwl:hasRelatedSynonym>aortic arch</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>thoracic aorta</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>UBERON:0001508</oboInOwl:id>
