        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CL_0000163"/>
        <obo:IAO_0000115>An endocrine cell that is located in the epithelium of the gastrointestinal tract or in the pancreas.</obo:IAO_0000115>
