        <oboInOwl:hasExactSynonym>undifferentiated columnar cell of tracheobronchial tree</oboInOwl:hasExactSynonym>
        <oboInOwl:id>CL:0002209</oboInOwl:id>
        <rdfs:label>intermediate epitheliocyte</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CL_0002240 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CL_0002240">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CL_0000057"/>
