        <obo:IAO_0000115>A  coniferous forest biome which includes communities adapted to subpolar conditions.</obo:IAO_0000115>
        <oboInOwl:creation_date>2013-09-04T06:41:53Z</oboInOwl:creation_date>
        <oboInOwl:hasDbXref>EcoLexicon:taiga</oboInOwl:hasDbXref>
