        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ENVO_01000230"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A sclerophyllous forest which is subject to temperate climate patterns.</obo:IAO_0000115>
        <rdfs:comment>This class is one of the forest types as identified by the updated Global Forest Map (GFM 2000).</rdfs:comment>
        <rdfs:label>temperate sclerophyllous dry forest</rdfs:label>
    </owl:Class>
    


