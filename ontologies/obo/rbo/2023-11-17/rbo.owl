        <owl:annotatedTarget>duct of pancreas</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">OBOL:accepted</oboInOwl:hasDbXref>
    </owl:Axiom>
