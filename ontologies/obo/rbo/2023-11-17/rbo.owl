    <!-- http://purl.obolibrary.org/obo/GO_0001820 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GO_0001820">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0006837"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0023061"/>
        <obo:IAO_0000115>The regulated release of serotonin by a cell. Serotonin (5-hydroxytryptamine, or 5-HT) is a monoamine synthesised in serotonergic neurons in the central nervous system, enterochromaffin cells in the gastrointestinal tract and some immune system cells.</obo:IAO_0000115>
