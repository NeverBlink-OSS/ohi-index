            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>&quot;A dose equivalent unit which is equal to one thousandth of a millionth of a sievert or 10^[-9] Sv.&quot; [NIST:NIST]</rdfs:comment>
        <rdfs:label>nanosievert</rdfs:label>
        <oboInOwl1:hasExactSynonym>nSv</oboInOwl1:hasExactSynonym>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0000145 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0000145">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/UO_1000133"/>
                    <owl:Restriction>
