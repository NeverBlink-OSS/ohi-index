        <rdfs:label>stone</rdfs:label>
        <oboInOwl1:hasExactSynonym>st</oboInOwl1:hasExactSynonym>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0010036 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0010036">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_1010036"/>
        <rdfs:comment>&quot;An imperial mass unit which is equivalent to 12.700,586,36 kilograms, or 28 pounds.&quot; [Wikipedia:Wikipedia]</rdfs:comment>
        <rdfs:label>quarter</rdfs:label>
        <oboInOwl1:hasExactSynonym>qr</oboInOwl1:hasExactSynonym>
        <oboInOwl1:hasExactSynonym>qtr</oboInOwl1:hasExactSynonym>
    </owl:Class>
    


