        <rdfs:comment>&quot;An absorbed dose unit which is equal to one thousandth of a gray or 10^[-3] Gy.&quot; [NIST:NIST]</rdfs:comment>
        <rdfs:label>milligray</rdfs:label>
        <oboInOwl1:hasExactSynonym>mGy</oboInOwl1:hasExactSynonym>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0000143 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0000143">
