    <!-- http://purl.obolibrary.org/obo/UBERON_0004729 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0004729">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000069"/>
        <rdfs:subClassOf>
