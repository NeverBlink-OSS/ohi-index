        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">space flight</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/RBO_00005010 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/RBO_00005010">
