    <!-- http://purl.obolibrary.org/obo/ENVO_01000248 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_01000248">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_01000219"/>
        <obo:IAO_0000115>A dense settlement biome is an anthropogenic terrestrial biome which is primarily used for human habitation, recreation, and industry within built structures with little other land use.</obo:IAO_0000115>
