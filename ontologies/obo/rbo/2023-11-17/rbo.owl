        <oboInOwl:hasDbXref>FMA:72555</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>endoderm cell</oboInOwl:hasExactSynonym>
        <oboInOwl:id>CL:0000223</oboInOwl:id>
        <rdfs:label>endodermal cell</rdfs:label>
    </owl:Class>
    


