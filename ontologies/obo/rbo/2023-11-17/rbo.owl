        <oboInOwl:hasExactSynonym>cartilage formation</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>cartilage organ development</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>chondrogenesis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>biological_process</oboInOwl:hasOBONamespace>
        <oboInOwl:id>GO:0051216</oboInOwl:id>
        <rdfs:label>cartilage development</rdfs:label>
    </owl:Class>
