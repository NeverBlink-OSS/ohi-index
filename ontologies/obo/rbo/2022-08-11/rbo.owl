    <owl:Ontology rdf:about="http://purl.obolibrary.org/obo/rbo.owl">
        <owl:versionIRI rdf:resource="http://purl.obolibrary.org/obo/rbo/releases/2022-08-11/rbo.owl"/>
        <dc:description>RBO is an ontology for the effects of radiation on biota in terrestrial and space environments.</dc:description>
        <dc:title>Radiation Biology Ontology</dc:title>
        <terms:license rdf:resource="http://creativecommons.org/licenses/by/3.0/"/>
        <owl:versionInfo rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2022-08-11</owl:versionInfo>
    </owl:Ontology>
    


