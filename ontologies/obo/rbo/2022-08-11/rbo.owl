    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0003061">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0006598"/>
        <rdfs:subClassOf>
