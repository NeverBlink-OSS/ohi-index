        <oboInOwl:shorthand>part_of_structure_that_is_capable_of</oboInOwl:shorthand>
        <rdfs:label>part of structure that is capable of</rdfs:label>
        <rdfs:label xml:lang="en">part of structure that is capable of</rdfs:label>
    </owl:ObjectProperty>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/RO_0002329"/>
