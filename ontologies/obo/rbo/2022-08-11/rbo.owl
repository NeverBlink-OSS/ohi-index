    <!-- http://purl.obolibrary.org/obo/UBERON_0003113 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0003113">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0011159"/>
