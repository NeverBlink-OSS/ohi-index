    <!-- http://purl.obolibrary.org/obo/UBERON_0005805 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0005805">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000947"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0003513"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
