        <oboInOwl:hasDbXref>galen:UpperGastrointestinalTract</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>upper GI tract</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>upper gastrointestinal tract</oboInOwl:hasExactSynonym>
