        <oboInOwl:hasExactSynonym>ciliary processes</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>ciliary processes set</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>processus ciliares</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>set of ciliary processes</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>uberon</oboInOwl:hasOBONamespace>
        <oboInOwl:hasRelatedSynonym>ciliary process</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>processus ciliares</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>UBERON:0010427</oboInOwl:id>
        <rdfs:label>ciliary processes</rdfs:label>
        <foaf:depicted_by rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://upload.wikimedia.org/wikipedia/commons/b/b2/Gray875.png</foaf:depicted_by>
