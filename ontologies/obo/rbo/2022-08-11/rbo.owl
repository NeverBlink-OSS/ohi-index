                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UO_0000299"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>&quot;A dose equivalent unit which is equal to one millionth of a sievert or 10^[-6] Sv.&quot; [NIST:NIST]</rdfs:comment>
        <rdfs:label>microsievert</rdfs:label>
        <oboInOwl1:hasExactSynonym>uSv</oboInOwl1:hasExactSynonym>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0000140 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0000140">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_1000140"/>
        <rdfs:comment>&quot;A dose equivalent unit which when multiplied by hundred is equal to one sievert or 1 Sv. 1 Sv is equal to 100 rem.&quot; [Wikipedia:Wikipedia]</rdfs:comment>
        <rdfs:label>Roentgen equivalent man</rdfs:label>
        <oboInOwl1:hasExactSynonym>rem</oboInOwl1:hasExactSynonym>
    </owl:Class>
    


