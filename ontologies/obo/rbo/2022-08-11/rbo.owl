                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0004571"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>An artery of the systemic circulation, which is the part of the cardiovascular system which carries oxygenated blood away from the heart, to the body, and returns deoxygenated blood back to the heart.</obo:IAO_0000115>
        <oboInOwl:hasDbXref rdf:resource="http://en.wikipedia.org/wiki/Artery#Systemic_arteries"/>
        <oboInOwl:hasDbXref>EMAPA:37126</oboInOwl:hasDbXref>
