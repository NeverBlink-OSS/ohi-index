        <oboInOwl:hasRelatedSynonym>post-otic neural crest</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>UBERON:0005428</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#vertebrate_core"/>
