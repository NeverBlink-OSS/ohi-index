            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A mass of water.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">water mass</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ENVO_01000687 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_01000687">
