        <oboInOwl:hasExactSynonym>buccal cavity</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>cavity of mouth</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>uberon</oboInOwl:hasOBONamespace>
        <oboInOwl:hasRelatedSynonym>bucca</oboInOwl:hasRelatedSynonym>
