    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0000047 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0000047">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_0000000"/>
        <rdfs:comment>&quot;A unit which is a standard measure of the amount of a 2-dimensional flat surface.&quot; [UOC:GVG]</rdfs:comment>
        <rdfs:label>area unit</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0000048 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0000048">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_0000000"/>
        <rdfs:comment>&quot;A unit which is a standard measure of the rate of change of velocity in either speed or direction.&quot; [Wikipedia:Wikipedia]</rdfs:comment>
        <rdfs:label>acceleration unit</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0000049 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0000049">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_0000000"/>
        <rdfs:comment>&quot;A unit which is a standard measure of the rate of angular movement about an axis; the angle rotated in a given time.&quot; [Wikipedia:Wikipedia]</rdfs:comment>
        <rdfs:label>angular velocity unit</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0000050 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0000050">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_0000000"/>
        <rdfs:comment>&quot;A unit which is a standard measure of the rate of change of angular velocity.&quot; [Wikipedia:Wikipedia]</rdfs:comment>
        <rdfs:label>angular acceleration unit</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0000051 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0000051">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000003"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_0000000"/>
        <obo:IAO_0000111>concentration unit</obo:IAO_0000111>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/uo.owl"/>
        <rdfs:comment>&quot;A unit which represents a standard measurement of how much of a given substance there is mixed with another substance.&quot; [UOC:GVG]</rdfs:comment>
        <rdfs:label>concentration unit</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0000052 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0000052">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_0000182"/>
        <rdfs:comment>&quot;A density unit which is a standard measure of the mass of a substance in a given volume.&quot; [UOC:GVG]</rdfs:comment>
        <rdfs:label>mass density unit</rdfs:label>
        <oboInOwl1:hasExactSynonym>mass per unit volume</oboInOwl1:hasExactSynonym>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0000053 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0000053">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_0000157"/>
        <rdfs:comment>&quot;A unit which is a standard measure of the luminous intensity impinging on a given area.&quot; [Wikipedia:Wikipedia]</rdfs:comment>
        <rdfs:label>luminance unit</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0000054 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0000054">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_0000182"/>
        <rdfs:comment>&quot;A density unit which is a standard measure of the mass exerting an influence on a given area.&quot; [Wikipedia:Wikipedia]</rdfs:comment>
        <rdfs:label>area density unit</rdfs:label>
        <oboInOwl1:hasExactSynonym>mass per unit area unit</oboInOwl1:hasExactSynonym>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0000055 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0000055">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_0000002"/>
        <rdfs:comment>&quot;A unit which is a standard measure of the mass of a homogeneous substance containing 6.02 x 1023 atoms or molecules.&quot; [Wikipedia:Wikipedia]</rdfs:comment>
        <rdfs:label>molar mass unit</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0000056 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0000056">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_0000095"/>
        <rdfs:comment>&quot;A unit which is a standard measure of the volume of a homogeneous substance containing 6.02 x 1023 atoms or molecules.&quot; [Wikipedia:Wikipedia]</rdfs:comment>
        <rdfs:label>molar volume unit</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0000057 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0000057">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_0000000"/>
        <rdfs:comment>&quot;A unit which is a standard measure of the quantity of motion measured by the product of mass and velocity.&quot; [Wikipedia:Wikipedia]</rdfs:comment>
        <rdfs:label>momentum unit</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0000058 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0000058">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_0000105"/>
        <rdfs:comment>&quot;A unit which is a standard measure of the number of rotations in a given time.&quot; [NIST:NIST]</rdfs:comment>
        <rdfs:label>rotational frequency unit</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0000059 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0000059">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_0000095"/>
        <rdfs:comment>&quot;A unit which is a standard measure of the volume of a given mass of substance (the reciprocal of density).&quot; [Wikipedia:Wikipedia]</rdfs:comment>
        <rdfs:label>specific volume unit</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0000060 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0000060">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_0000000"/>
        <rdfs:comment>&quot;A unit which is a standard measure of the rate of movement. Speed is measured in the same physical units of measurement as velocity, but does not contain the element of direction that velocity has. Speed is thus the magnitude component of velocity.&quot; [Wikipedia:Wikipedia]</rdfs:comment>
        <rdfs:label>speed/velocity unit</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0000061 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0000061">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_0000051"/>
        <rdfs:comment>&quot;A concentration unit which is a standard measure of the number of moles of a given substance per liter of solution.&quot; [UOC:GVG]</rdfs:comment>
        <rdfs:label>unit of molarity</rdfs:label>
    </owl:Class>
    


