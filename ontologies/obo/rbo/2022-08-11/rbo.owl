        <obo:RO_0040042 rdf:resource="http://purl.obolibrary.org/obo/BFO_0000031"/>
        <efo:EFO_URI>http://www.ebi.ac.uk/efo/part_of</efo:EFO_URI>
        <oboInOwl:hasDbXref>BFO:0000050</oboInOwl:hasDbXref>
