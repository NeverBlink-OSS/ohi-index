        </rdfs:subClassOf>
        <rdfs:comment>&quot;An electric potential difference unit which is equal to one trillionth of a volt or 10^[-12] V.&quot; [UOC:GVG]</rdfs:comment>
        <rdfs:label>picovolt</rdfs:label>
        <oboInOwl1:hasExactSynonym>pV</oboInOwl1:hasExactSynonym>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0000252 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0000252">
