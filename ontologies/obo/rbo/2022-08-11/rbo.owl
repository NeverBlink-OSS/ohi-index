        </rdfs:subClassOf>
        <obo:IAO_0000115>A canopy which is part of a woodland ecosystem.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>EcoLexicon:canopy</oboInOwl:hasDbXref>
