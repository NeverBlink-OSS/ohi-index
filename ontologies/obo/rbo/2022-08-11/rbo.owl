        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A valley that no longer has a surface flow of water. Typically found in either Karst (limestone) or chalk terrain.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>https://en.wikipedia.org/wiki/Dry_valley</oboInOwl:hasDbXref>
    </owl:Axiom>
    


