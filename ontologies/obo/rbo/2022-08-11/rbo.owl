        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PATO_0001548"/>
        <obo:IAO_0000115>A physical quality of a liquid inhering in a bearer by virtue of the bearer&apos;s disposition to internal resistance to flow.</obo:IAO_0000115>
        <rdfs:label>viscosity</rdfs:label>
    </owl:Class>
    


