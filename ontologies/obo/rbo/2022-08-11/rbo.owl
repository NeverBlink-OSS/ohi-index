        <obo:IAO_0000115>A shape quality inhering in a bearer by virtue of the bearer&apos;s being narrow, with the two opposite margins parallel.</obo:IAO_0000115>
        <rdfs:label>linear</rdfs:label>
    </owl:Class>
    


