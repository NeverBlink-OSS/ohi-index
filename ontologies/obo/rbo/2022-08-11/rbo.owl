        <rdfs:label>capsule of lens</rdfs:label>
        <foaf:depicted_by rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://upload.wikimedia.org/wikipedia/commons/5/55/Gray883.png</foaf:depicted_by>
