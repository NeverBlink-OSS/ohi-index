            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>&quot;An activity (of a radionuclide) unit which is equal to one millionth of a curie or 10^[-6] Ci.&quot; [ORCBS:ORCBS]</rdfs:comment>
        <rdfs:label>microcurie</rdfs:label>
        <oboInOwl1:hasExactSynonym>uCi</oboInOwl1:hasExactSynonym>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0000147 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0000147">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_1000147"/>
        <rdfs:comment>&quot;An activity (of a radionuclide) unit which is equal to the activity of a quantity of radioactive material in which one nucleus decays per minute or there is one atom disintegration per minute.&quot; [ORCBS:ORCBS]</rdfs:comment>
        <rdfs:label>disintegrations per minute</rdfs:label>
        <oboInOwl1:hasExactSynonym>dpm</oboInOwl1:hasExactSynonym>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0000148 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0000148">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_1000148"/>
        <rdfs:comment>&quot;An activity (of a radionuclide) unit which is equal to the number of light emissions produced by ionizing radiation in one minute.&quot; [ORCBS:ORCBS]</rdfs:comment>
        <rdfs:label>counts per minute</rdfs:label>
        <oboInOwl1:hasExactSynonym>cpm</oboInOwl1:hasExactSynonym>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0000150 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0000150">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/UO_1000010"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/has_prefix"/>
                        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UO_0000300"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_1000010"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/has_prefix"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UO_0000300"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>&quot;A time unit which is equal to one thousandth of one millionth of a second or 10^[-9] s.&quot; [NIST:NIST]</rdfs:comment>
        <rdfs:label>nanosecond</rdfs:label>
        <oboInOwl1:hasExactSynonym>ns</oboInOwl1:hasExactSynonym>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0000151 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0000151">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_1000151"/>
        <rdfs:comment>&quot;A time unit which is equal to 100 years.&quot; [Wikipedia:Wikipedia]</rdfs:comment>
        <rdfs:label>century</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0000152 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0000152">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_1000152"/>
        <rdfs:comment>&quot;A time unit which represents the period over which the activity or concentration of a specified chemical or element falls to half its original activity or concentration.&quot; [MGED:MGED]</rdfs:comment>
        <rdfs:label>half life</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0000153 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0000153">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_1000153"/>
        <rdfs:comment>&quot;An illuminance unit which is equal to the illuminance produced by 1 lumen evenly spread over an area 1 foot^[2]. One footcandle is equal to 10.76 lux.&quot; [Wikipedia:Wikipedia]</rdfs:comment>
        <rdfs:label>foot candle</rdfs:label>
        <oboInOwl1:hasExactSynonym>ft-c</oboInOwl1:hasExactSynonym>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0000154 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0000154">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_0000157"/>
        <rdfs:comment>&quot;A unit which is a standard measure of the power of electromagnetic radiation at a surface, per unit area.&quot; [Wikipedia:Wikipedia]</rdfs:comment>
        <rdfs:label>irradiance unit</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0000155 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0000155">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_1000155"/>
        <rdfs:comment>&quot;An irradiance unit which is equal to 1 watt of radiant power incident per one square meter surface area.&quot; [NIST:NIST]</rdfs:comment>
        <rdfs:label>watt per square meter</rdfs:label>
        <oboInOwl1:hasExactSynonym>W/m^[2]</oboInOwl1:hasExactSynonym>
        <oboInOwl1:hasExactSynonym>watt per square metre</oboInOwl1:hasExactSynonym>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0000156 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0000156">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_1000156"/>
        <rdfs:comment>&quot;An irradiance unit which is equal to one einstein per square meter per second. One einstein is one mole of photons, regardless of their frequency. Therefore, the number of photons in an einstein is Avogadro&apos;s number.&quot; [Wikipedia:Wikipedia]</rdfs:comment>
        <rdfs:label>einstein per square meter per second</rdfs:label>
        <oboInOwl1:hasExactSynonym>einstein per square metre per second</oboInOwl1:hasExactSynonym>
        <oboInOwl1:hasExactSynonym>einstein/sm^[2]</oboInOwl1:hasExactSynonym>
        <oboInOwl1:hasExactSynonym>mole per second and square meter mol/sm^2</oboInOwl1:hasExactSynonym>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0000157 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0000157">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_0000000"/>
        <rdfs:comment>&quot;A unit which is a standard measure of the intensity of light.&quot; [NIST:NIST]</rdfs:comment>
        <rdfs:label>light unit</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0000158 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0000158">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_1000158"/>
        <rdfs:comment>&quot;A radiance unit which is equal to one watt of radiant power incident per steradian solid angle per one square meter projected area of the source, as viewed from the given direction.&quot; [NIST:NIST]</rdfs:comment>
        <rdfs:label>watt per steradian per square meter</rdfs:label>
        <oboInOwl1:hasExactSynonym>W/sr m^[2]</oboInOwl1:hasExactSynonym>
        <oboInOwl1:hasExactSynonym>watt per steradian per square metre</oboInOwl1:hasExactSynonym>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0000159 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0000159">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_0000157"/>
        <rdfs:comment>&quot;A unit which is a standard measure of the intensity of electromagnetic radiation.&quot; [Wikipedia:Wikipedia]</rdfs:comment>
        <rdfs:label>radiant intensity unit</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0000160 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0000160">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/UO_1000156"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/has_prefix"/>
                        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UO_0000299"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_1000156"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/has_prefix"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UO_0000299"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>&quot;An irradiance unit which is equal to one microeinstein per square meter per second or 10^[-6] microeinstein/sm^[2].&quot; [Wikipedia:Wikipedia]</rdfs:comment>
        <rdfs:label>microeinstein per square meter per second</rdfs:label>
        <oboInOwl1:hasExactSynonym>microeinstein per square metre per second</oboInOwl1:hasExactSynonym>
        <oboInOwl1:hasExactSynonym>micromole per second and square meter mmol/sm^2</oboInOwl1:hasExactSynonym>
        <oboInOwl1:hasExactSynonym>umicroeinstein/sm^[2]</oboInOwl1:hasExactSynonym>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0000161 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0000161">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_0000157"/>
        <rdfs:comment>&quot;A unit which is a standard measure of the power of electromagnetic radiation through space or through a material medium in the form of electromagnetic waves.&quot; [Wikipedia:Wikipedia]</rdfs:comment>
        <rdfs:label>radiance unit</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0000162 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0000162">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_1000162"/>
        <rdfs:comment>&quot;A radiant intensity unit which is equal to one kilogram meter squared per second cubed per steradian.&quot; [NIST:NIST]</rdfs:comment>
        <rdfs:label>watt per steradian</rdfs:label>
        <oboInOwl1:hasExactSynonym>W/sr</oboInOwl1:hasExactSynonym>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0000163 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0000163">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_1000163"/>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0000164 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0000164">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_1000164"/>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0000165 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0000165">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_1000165"/>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0000166 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0000166">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_0000186"/>
        <rdfs:comment>&quot;A dimensionless concentration notation which describes the amount of one substance in another. It is the ratio of the amount of the substance of interest to the amount of that substance plus the amount of the substance.&quot; [Wikipedia:Wikipedia]</rdfs:comment>
        <rdfs:label>parts per notation unit</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0000167 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0000167">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_1000167"/>
        <rdfs:comment>&quot;A dimensionless concentration notation which denotes the amount of a given substance in a total amount of 100 regardless of the units of measure as long as they are the same.&quot; [UOC:GVG]</rdfs:comment>
        <rdfs:label>parts per hundred</rdfs:label>
        <oboInOwl1:hasExactSynonym>10^[-2]</oboInOwl1:hasExactSynonym>
        <oboInOwl1:hasExactSynonym>pph</oboInOwl1:hasExactSynonym>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0000168 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0000168">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_1000168"/>
        <rdfs:comment>&quot;A dimensionless concentration notation which denotes the amount of a given substance in a total amount of 1000 regardless of the units of measure as long as they are the same.&quot; [UOC:GVG]</rdfs:comment>
        <rdfs:label>parts per thousand</rdfs:label>
        <oboInOwl1:hasExactSynonym>10^[-3]</oboInOwl1:hasExactSynonym>
        <oboInOwl1:hasExactSynonym>ppth</oboInOwl1:hasExactSynonym>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0000169 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0000169">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_1000169"/>
        <rdfs:comment>&quot;A dimensionless concentration notation which denotes the amount of a given substance in a total amount of 1,000,000 regardless of the units of measure used as long as they are the same or 1 part in 10^[6].&quot; [UOC:GVG]</rdfs:comment>
        <rdfs:label>parts per million</rdfs:label>
        <oboInOwl1:hasExactSynonym>10^[-6]</oboInOwl1:hasExactSynonym>
        <oboInOwl1:hasExactSynonym>ppm</oboInOwl1:hasExactSynonym>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0000170 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0000170">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_1000170"/>
        <rdfs:comment>&quot;A dimensionless concentration notation which denotes the amount of a given substance in a total amount of 1,000,000,000 regardless of the units of measure as long as they are the same or 1 part in 10^[9].&quot; [UOC:GVG]</rdfs:comment>
        <rdfs:label>parts per billion</rdfs:label>
        <oboInOwl1:hasExactSynonym>10^[-9]</oboInOwl1:hasExactSynonym>
        <oboInOwl1:hasExactSynonym>ppb</oboInOwl1:hasExactSynonym>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0000171 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0000171">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_1000171"/>
        <rdfs:comment>&quot;A dimensionless concentration notation which denotes the amount of a given substance in a total amount of 1,000,000,000 regardless of the units of measure used as long as they are the same or 1 part in 10^[12].&quot; [UOC:GVG]</rdfs:comment>
        <rdfs:label>parts per trillion</rdfs:label>
        <oboInOwl1:hasExactSynonym>10^[-12]</oboInOwl1:hasExactSynonym>
        <oboInOwl1:hasExactSynonym>ppt</oboInOwl1:hasExactSynonym>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0000172 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0000172">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_1000172"/>
        <rdfs:comment>&quot;A dimensionless concentration notation which denotes the amount of a given substance in a total amount of 1,000,000,000,000 regardless of the units of measure used as long as they are the same or 1 part in 10^[15].&quot; [UOC:GVG]</rdfs:comment>
        <rdfs:label>parts per quadrillion</rdfs:label>
        <oboInOwl1:hasExactSynonym>10^[-15]</oboInOwl1:hasExactSynonym>
        <oboInOwl1:hasExactSynonym>ppq</oboInOwl1:hasExactSynonym>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0000173 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0000173">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_1000173"/>
        <rdfs:comment>&quot;A mass unit density which is equal to mass of an object in grams divided by the volume in milliliter.&quot; [UOC:GVG]</rdfs:comment>
        <rdfs:label>gram per milliliter</rdfs:label>
        <oboInOwl1:hasExactSynonym>g/ml</oboInOwl1:hasExactSynonym>
        <oboInOwl1:hasExactSynonym>gram per millilitre</oboInOwl1:hasExactSynonym>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0000174 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0000174">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/UO_1000175"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/has_prefix"/>
                        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UO_0000294"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_1000175"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/has_prefix"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UO_0000294"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>&quot;A mass unit density which is equal to mass of an object in kilograms divided by the volume in liters.&quot; [UOC:GVG]</rdfs:comment>
        <rdfs:label>kilogram per liter</rdfs:label>
        <oboInOwl1:hasExactSynonym>kg/L</oboInOwl1:hasExactSynonym>
        <oboInOwl1:hasExactSynonym>kilogram per litre</oboInOwl1:hasExactSynonym>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0000175 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0000175">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_1000175"/>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0000176 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0000176">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/UO_1000175"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/has_prefix"/>
                        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UO_0000297"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_1000175"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/has_prefix"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UO_0000297"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0000177 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0000177">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_0000051"/>
        <rdfs:comment>&quot;A concentration unit which is a standard measure of the number of units, as an agreed arbitrary amount, of a given substance per a specific volume of solution.&quot; [Webmd:Webmd]</rdfs:comment>
        <rdfs:label>unit per volume unit</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0000178 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0000178">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_1000178"/>
        <rdfs:comment>&quot;A unit per milliliter unit which is equal to one unit of an agreed arbitrary amount per one milliliter.&quot; [Webmd:Webmd]</rdfs:comment>
        <rdfs:label>unit per milliliter</rdfs:label>
        <oboInOwl1:hasExactSynonym>U/ml</oboInOwl1:hasExactSynonym>
        <oboInOwl1:hasExactSynonym>unit per millilitre</oboInOwl1:hasExactSynonym>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0000179 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0000179">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_1000179"/>
        <rdfs:comment>&quot;A unit per milliliter unit which is equal to one unit of an agreed arbitrary amount per one liter.&quot; [UOC:GVG]</rdfs:comment>
        <rdfs:label>unit per liter</rdfs:label>
        <oboInOwl1:hasExactSynonym>U/l</oboInOwl1:hasExactSynonym>
        <oboInOwl1:hasExactSynonym>unit per litre</oboInOwl1:hasExactSynonym>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0000180 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0000180">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_1000180"/>
        <rdfs:comment>&quot;A concentration unit which is a standard measure of the mass of a substance in a given volume (density).&quot; [Wikipedia:Wikipedia]</rdfs:comment>
        <rdfs:label>mass per unit volume</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0000181 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0000181">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_1000181"/>
        <rdfs:comment>&quot;A catalytic unit activity which is equal to the amount of the enzyme that catalyzes the conversion of 1 micro mole of substrate per minute.&quot; [Wikipedia:Wikipedia]</rdfs:comment>
        <rdfs:label>enzyme unit</rdfs:label>
        <oboInOwl1:hasExactSynonym>U</oboInOwl1:hasExactSynonym>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0000182 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0000182">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_0000000"/>
        <rdfs:comment>&quot;A unit which is a standard measure of the influence exerted by some mass.&quot; [Wikipedia:Wikipedia]</rdfs:comment>
        <rdfs:label>density unit</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0000183 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0000183">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_0000182"/>
        <rdfs:comment>&quot;A density unit which is a standard measure of the mass exerting an influence on a one-dimensional object.&quot; [Wikipedia:Wikipedia]</rdfs:comment>
        <rdfs:label>linear density unit</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0000184 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0000184">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_0000183"/>
        <rdfs:comment>&quot;An area density unit which is equal to the mass of an object in kilograms divided by one meter.&quot; [NIST:NIST]</rdfs:comment>
        <rdfs:label>kilogram per meter</rdfs:label>
        <oboInOwl1:hasExactSynonym>kg/m</oboInOwl1:hasExactSynonym>
        <oboInOwl1:hasExactSynonym>kilogram per metre</oboInOwl1:hasExactSynonym>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0000185 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0000185">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_1000185"/>
        <rdfs:comment>&quot;A plane angle unit which is equal to 1/360 of a full rotation or 1.7453310^[-2] rad.&quot; [Wikipedia:Wikipedia]</rdfs:comment>
        <rdfs:label>degree</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0000186 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0000186">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_0000000"/>
        <rdfs:comment>&quot;A unit which is a standard measure of physical quantity consisting of only a numerical number without any units.&quot; [Wikipedia:Wikipedia]</rdfs:comment>
        <rdfs:label>dimensionless unit</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0000187 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0000187">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_0000190"/>
        <rdfs:comment>&quot;A dimensionless ratio unit which denotes numbers as fractions of 100.&quot; [Wikipedia:Wikipedia]</rdfs:comment>
        <rdfs:label>percent</rdfs:label>
        <oboInOwl1:hasExactSynonym>%</oboInOwl1:hasExactSynonym>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0000188 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0000188">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_1000188"/>
        <rdfs:comment>&quot;A dimensionless unit which denoted an irrational real number, approximately equal to 3.14159 which is the ratio of a circle&apos;s circumference to its diameter in Euclidean geometry.&quot; [Wikipedia:Wikipedia]</rdfs:comment>
        <rdfs:label>pi</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0000189 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0000189">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_0000186"/>
        <rdfs:comment>&quot;A dimensionless unit which denotes a simple count of things.&quot; [MGED:MGED]</rdfs:comment>
        <rdfs:label>count unit</rdfs:label>
        <oboInOwl1:hasExactSynonym>count</oboInOwl1:hasExactSynonym>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0000190 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0000190">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_0000186"/>
        <rdfs:comment>&quot;A dimensionless unit which denotes an amount or magnitude of one quantity relative to another.&quot; [Wikipedia:Wikipedia]</rdfs:comment>
        <rdfs:label>ratio</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0000191 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0000191">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_0000190"/>
        <rdfs:comment>&quot;A dimensionless ratio unit which relates the part (the numerator) to the whole (the denominator).&quot; [Wikipedia:Wikipedia]</rdfs:comment>
        <rdfs:label>fraction</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0000192 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0000192">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_1000192"/>
        <rdfs:comment>&quot;A dimensionless count unit which denotes the number of molecules.&quot; [MGED:MGED]</rdfs:comment>
        <rdfs:label>molecule count</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0000193 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0000193">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_1000193"/>
        <rdfs:comment>&quot;A dimensionless percent unit which denotes the homogeneity of a biomaterial.&quot; [MGED:MGED]</rdfs:comment>
        <rdfs:label>purity percentage</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0000194 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0000194">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_1000194"/>
        <rdfs:comment>&quot;A dimensionless percent unit which denotes the density of an attached or monolayer culture (e.g., cell culture).&quot; [MGED:MGED]</rdfs:comment>
        <rdfs:label>confluence percentage</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0000195 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0000195">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_1000195"/>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0000196 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0000196">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_1000196"/>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0000197 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0000197">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_1000197"/>
        <rdfs:comment>&quot;A specific volume unit which is equal to one liter volume occupied by one kilogram of a particular substance.&quot; [NIST:NIST]</rdfs:comment>
        <rdfs:label>liter per kilogram</rdfs:label>
        <oboInOwl1:hasExactSynonym>l/kg</oboInOwl1:hasExactSynonym>
        <oboInOwl1:hasExactSynonym>litre per kilogram</oboInOwl1:hasExactSynonym>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0000198 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0000198">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/UO_1000197"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/has_prefix"/>
                        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UO_0000297"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_1000197"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/has_prefix"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UO_0000297"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>&quot;A specific volume unit which is equal to a thousandth of a liter per kilogram or 10^[-3] l/kg.&quot; [NIST:NIST]</rdfs:comment>
        <rdfs:label>milliliter per kilogram</rdfs:label>
        <oboInOwl1:hasExactSynonym>millilitre per kilogram</oboInOwl1:hasExactSynonym>
        <oboInOwl1:hasExactSynonym>ml/kg</oboInOwl1:hasExactSynonym>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0000199 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0000199">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/UO_1000197"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/has_prefix"/>
                        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UO_0000299"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_1000197"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/has_prefix"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UO_0000299"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>&quot;A specific volume unit which is equal to one millionth of a liter per kilogram or 10^[-6] l/kg.&quot; [NIST:NIST]</rdfs:comment>
        <rdfs:label>microliter per kilogram</rdfs:label>
        <oboInOwl1:hasExactSynonym>microlitre per kilogram</oboInOwl1:hasExactSynonym>
        <oboInOwl1:hasExactSynonym>ul/kg</oboInOwl1:hasExactSynonym>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0000200 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0000200">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_0000051"/>
        <rdfs:comment>&quot;A concentration unit which denotes the average cell number in a given volume.&quot; [Bioedonline:Bioedonline]</rdfs:comment>
        <rdfs:label>cell concentration unit</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0000201 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0000201">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_1000201"/>
        <rdfs:comment>&quot;A unit of cell concentration which is equal to one cell in a volume of 1 milliliter.&quot; [Bioedonline:Bioedonline]</rdfs:comment>
        <rdfs:label>cells per milliliter</rdfs:label>
        <oboInOwl1:hasExactSynonym>cells per millilitre</oboInOwl1:hasExactSynonym>
        <oboInOwl1:hasExactSynonym>cells per ml</oboInOwl1:hasExactSynonym>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0000202 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0000202">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_0000051"/>
        <rdfs:comment>&quot;A concentration unit which is a standard measure of the amount of the action of a catalyst in a given volume.&quot; [UOC:GVG]</rdfs:comment>
        <rdfs:label>catalytic (activity) concentration unit</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0000203 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0000203">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_1000203"/>
        <rdfs:comment>&quot;A catalytic (activity) concentration unit which is equal to 1 katal activity of a catalyst in a given volume of one cubic meter.&quot; [NIST:NIST]</rdfs:comment>
        <rdfs:label>katal per cubic meter</rdfs:label>
        <oboInOwl1:hasExactSynonym>kat/m^[3]</oboInOwl1:hasExactSynonym>
        <oboInOwl1:hasExactSynonym>katal per cubic metre</oboInOwl1:hasExactSynonym>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0000204 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0000204">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_1000204"/>
        <rdfs:comment>&quot;A catalytic (activity) concentration unit which is equal to 1 katal activity of a catalyst in a given volume of one thousandth of a cubic meter.&quot; [NIST:NIST]</rdfs:comment>
        <rdfs:label>katal per liter</rdfs:label>
        <oboInOwl1:hasExactSynonym>kat/l</oboInOwl1:hasExactSynonym>
        <oboInOwl1:hasExactSynonym>katal per litre</oboInOwl1:hasExactSynonym>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0000205 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0000205">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_0000051"/>
        <rdfs:comment>&quot;A dimensionless concentration unit which denotes the given volume of the solute in the total volume of the resulting solution.&quot; [NIST:NIST]</rdfs:comment>
        <rdfs:label>volume per unit volume</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0000206 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0000206">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_0000205"/>
        <rdfs:comment>&quot;A volume per unit volume unit which is equal to one millionth of a liter of solute in one cubic meter of solution.&quot; [NIST:NIST]</rdfs:comment>
        <rdfs:label>milliliter per cubic meter</rdfs:label>
        <oboInOwl1:hasExactSynonym>millilitre per cubic metre</oboInOwl1:hasExactSynonym>
        <oboInOwl1:hasExactSynonym>ml/m^[3]</oboInOwl1:hasExactSynonym>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0000207 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0000207">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_0000205"/>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0000208 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0000208">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_1000208"/>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0000209 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0000209">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/UO_1000099"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/has_prefix"/>
                        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UO_0000296"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_1000099"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/has_prefix"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UO_0000296"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>&quot;A volume unit which is equal to one tenth of a liter or 10^[-1] L.&quot; [NIST:NIST]</rdfs:comment>
        <rdfs:label>deciliter</rdfs:label>
        <oboInOwl1:hasExactSynonym>decilitre</oboInOwl1:hasExactSynonym>
        <oboInOwl1:hasExactSynonym>dl</oboInOwl1:hasExactSynonym>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0000210 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0000210">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_1000210"/>
        <rdfs:comment>&quot;A dimensionless count unit which a measure of viable bacterial numbers.&quot; [Wikipedia:Wikipedia]</rdfs:comment>
        <rdfs:label>colony forming unit</rdfs:label>
        <oboInOwl1:hasExactSynonym>cfu</oboInOwl1:hasExactSynonym>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0000211 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0000211">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_1000211"/>
        <rdfs:comment>&quot;A dimensionless count unit which a measure of plague forming units in a given volume.&quot; [Wikipedia:Wikipedia]</rdfs:comment>
        <rdfs:label>plaque forming unit</rdfs:label>
        <oboInOwl1:hasExactSynonym>pfu</oboInOwl1:hasExactSynonym>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0000212 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0000212">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_0000051"/>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0000213 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0000213">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_1000213"/>
        <rdfs:comment>&quot;A colony forming unit which a measure of viable bacterial numbers in one milliliter.&quot; [Wikipedia:Wikipedia]</rdfs:comment>
        <rdfs:label>colony forming unit per milliliter</rdfs:label>
        <oboInOwl1:hasExactSynonym>cfu/ml</oboInOwl1:hasExactSynonym>
        <oboInOwl1:hasExactSynonym>colony forming unit per millilitre</oboInOwl1:hasExactSynonym>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0000214 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0000214">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_0000051"/>
        <rdfs:comment>&quot;A concentration unit which a measure of plague forming units in a given volume.&quot; [UOC:GVG]</rdfs:comment>
        <rdfs:label>plaque forming unit per volume</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0000215 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0000215">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_1000215"/>
        <rdfs:comment>&quot;A concentration unit which a measure of plague forming units in one milliliter.&quot; [UOC:GVG]</rdfs:comment>
        <rdfs:label>plaque forming unit per milliliter</rdfs:label>
        <oboInOwl1:hasExactSynonym>pfu/ml</oboInOwl1:hasExactSynonym>
        <oboInOwl1:hasExactSynonym>plaque forming unit per millilitre</oboInOwl1:hasExactSynonym>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0000216 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0000216">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_1000216"/>
        <rdfs:comment>&quot;An activity (of a radionuclide) unit which is equal to the activity of a quantity of radioactive material in which one nucleus decays per second or there is one atom disintegration per second.&quot; [ORCBS:ORCBS]</rdfs:comment>
        <rdfs:label>disintegrations per second</rdfs:label>
        <oboInOwl1:hasExactSynonym>dps</oboInOwl1:hasExactSynonym>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0000217 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0000217">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_0000000"/>
        <rdfs:comment>&quot;A unit which is a standard measure of the work done per unit charge as a charge is moved between two points in an electric field.&quot; [Wikipedia:Wikipedia]</rdfs:comment>
        <rdfs:label>electric potential difference unit</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0000218 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0000218">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_1000218"/>
        <rdfs:comment>&quot;An electric potential difference unit which is equal to the work per unit charge. One volt is the potential difference required to move one coulomb of charge between two points in a circuit while using one joule of energy.&quot; [Wikipedia:Wikipedia]</rdfs:comment>
        <rdfs:label>volt</rdfs:label>
        <oboInOwl1:hasExactSynonym>V</oboInOwl1:hasExactSynonym>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0000219 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0000219">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_0000000"/>
        <rdfs:comment>&quot;A unit which is a standard measure of the quantity of unbalanced electricity in a body (either positive or negative) and construed as an excess or deficiency of electrons.&quot; [WordNet:WordNet]</rdfs:comment>
        <rdfs:label>electric charge</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0000220 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0000220">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_1000220"/>
        <rdfs:comment>&quot;An electrical charge unit which is equal to the amount of charge transferred by a current of 1 ampere in 1 second.&quot; [WordNet:WordNet]</rdfs:comment>
        <rdfs:label>coulomb</rdfs:label>
        <oboInOwl1:hasExactSynonym>C</oboInOwl1:hasExactSynonym>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0000221 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0000221">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_1000221"/>
        <rdfs:comment>&quot;An independently to the base SI units defined mass unit which is equal to one twelfth of the mass of an unbound atom of the carbon-12 nuclide, at rest and in its ground state.&quot; [Wikipedia:Wikipedia]</rdfs:comment>
        <rdfs:label>dalton</rdfs:label>
        <oboInOwl1:hasExactSynonym>Da</oboInOwl1:hasExactSynonym>
        <oboInOwl1:hasExactSynonym>amu</oboInOwl1:hasExactSynonym>
        <oboInOwl1:hasExactSynonym>u</oboInOwl1:hasExactSynonym>
        <oboInOwl1:hasExactSynonym>unified atomic mass unit</oboInOwl1:hasExactSynonym>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0000222 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0000222">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/UO_1000221"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/has_prefix"/>
                        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UO_0000294"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_1000221"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/has_prefix"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UO_0000294"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>&quot;A mass unit which is equal to one thousand daltons.&quot; [Wikipedia:Wikipedia]</rdfs:comment>
        <rdfs:label>kilodalton</rdfs:label>
        <oboInOwl1:hasExactSynonym>kDa</oboInOwl1:hasExactSynonym>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0000223 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0000223">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_1000223"/>
        <rdfs:comment>&quot;An energy unit which is equal to the amount of electrical energy equivalent to a one-watt load drawing power for one hour.&quot; [Wikipedia:Wikipedia]</rdfs:comment>
        <rdfs:label>watt-hour</rdfs:label>
        <oboInOwl1:hasExactSynonym>Wh</oboInOwl1:hasExactSynonym>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0000224 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0000224">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/UO_1000223"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/has_prefix"/>
                        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UO_0000294"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_1000223"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/has_prefix"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UO_0000294"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>&quot;An energy unit which is equal to 1,000 watt-hours.&quot; [Wikipedia:Wikipedia]</rdfs:comment>
        <rdfs:label>kilowatt-hour</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0000225 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0000225">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_0000000"/>
        <rdfs:comment>&quot;A unit which is a standard measure of quantity of magnetism, taking account of the strength and the extent of a magnetic field.&quot; [Wikipedia:Wikipedia]</rdfs:comment>
        <rdfs:label>magnetic flux unit</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0000226 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0000226">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_1000226"/>
        <rdfs:comment>&quot;A magnetic flux unit which is equal to the amount of flux that when linked with a single turn of wire for an interval of one second will induce an electromotive force of one volt.&quot; [ScienceLobby:ScienceLobby]</rdfs:comment>
        <rdfs:label>weber</rdfs:label>
        <oboInOwl1:hasExactSynonym>V s</oboInOwl1:hasExactSynonym>
        <oboInOwl1:hasExactSynonym>Wb</oboInOwl1:hasExactSynonym>
        <oboInOwl1:hasRelatedSynonym>volt-second</oboInOwl1:hasRelatedSynonym>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0000227 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0000227">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_0000000"/>
        <rdfs:comment>&quot;A unit which is a standard measure of the strength of a magnetic field.&quot; [allnet:allnet]</rdfs:comment>
        <rdfs:label>magnetic flux density unit</rdfs:label>
        <oboInOwl1:hasExactSynonym>B</oboInOwl1:hasExactSynonym>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0000228 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0000228">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_1000228"/>
        <rdfs:comment>&quot;A magnetic flux density unit which is equal to one weber per square meter.&quot; [WordNet:WordNet]</rdfs:comment>
        <rdfs:label>tesla</rdfs:label>
        <oboInOwl1:hasExactSynonym>T</oboInOwl1:hasExactSynonym>
        <oboInOwl1:hasExactSynonym>Wb/m2</oboInOwl1:hasExactSynonym>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0000229 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0000229">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_1000229"/>
        <rdfs:comment>&quot;A magnetic flux unit which is equal to 3600 Wb.&quot; [UOC:GVG]</rdfs:comment>
        <rdfs:label>volt-hour</rdfs:label>
        <oboInOwl1:hasExactSynonym>Vh</oboInOwl1:hasExactSynonym>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0000230 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0000230">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/UO_1000229"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/has_prefix"/>
                        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UO_0000294"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_1000229"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/has_prefix"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UO_0000294"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>&quot;A magnetic flux unit which is equal to one thousand volt-hours.&quot; [UOC:GVG]</rdfs:comment>
        <rdfs:label>kilovolt-hour</rdfs:label>
        <oboInOwl1:hasExactSynonym>kVh</oboInOwl1:hasExactSynonym>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0000231 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0000231">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_0000000"/>
        <rdfs:comment>&quot;A unit which is a standard measure of the amount of information.&quot; [Wikipedia:Wikipedia]</rdfs:comment>
        <rdfs:label>information unit</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0000232 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0000232">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_1000232"/>
        <rdfs:comment>&quot;An information unit which refers to a digit in the binary numeral system, which consists of base 2 digits (ie there are only 2 possible values: 0 or 1).&quot; [Wikipedia:Wikipedia]</rdfs:comment>
        <rdfs:label>bit</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0000233 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0000233">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_1000233"/>
        <rdfs:comment>&quot;An information unit which is equal to 8 bits.&quot; [Wikipedia:Wikipedia]</rdfs:comment>
        <rdfs:label>byte</rdfs:label>
        <oboInOwl1:hasExactSynonym>B</oboInOwl1:hasExactSynonym>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0000234 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0000234">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/UO_1000233"/>
