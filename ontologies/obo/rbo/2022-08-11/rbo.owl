        <oboInOwl:id>CL:1000306</oboInOwl:id>
        <rdfs:label>fibroblast of tunica adventitia of artery</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CL_1000309 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CL_1000309">
