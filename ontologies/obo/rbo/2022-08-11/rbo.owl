                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UO_0000299"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>&quot;An absorbed dose unit which is equal to one millionth of a gray or 10^[-6] Gy.&quot; [NIST:NIST]</rdfs:comment>
        <rdfs:label>microgray</rdfs:label>
        <oboInOwl1:hasExactSynonym>uGy</oboInOwl1:hasExactSynonym>
    </owl:Class>
    


