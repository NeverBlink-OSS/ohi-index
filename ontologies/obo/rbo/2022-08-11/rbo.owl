    <!-- http://purl.obolibrary.org/obo/OBI_0000326 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/OBI_0000326">
        <rdf:type rdf:resource="http://purl.obolibrary.org/obo/IAO_0000098"/>
