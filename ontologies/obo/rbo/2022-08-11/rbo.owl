        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_0000000"/>
        <obo:IAO_0000115>A derived unit is a unit which is derived from base units.</obo:IAO_0000115>
        <obo:IAO_0000115>A unit which is derived from base units.</obo:IAO_0000115>
        <obo:IAO_0000117>James Malone</obo:IAO_0000117>
        <efo:EFO_URI>http://www.ebi.ac.uk/efo/EFO_0001692</efo:EFO_URI>
