    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/RBO_00000043 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/RBO_00000043">
        <rdf:type rdf:resource="http://purl.obolibrary.org/obo/RBO_00000045"/>
        <obo:IAO_0000111 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Zvezda</obo:IAO_0000111>
        <obo:IAO_0000112 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The experiment was conducted in the Zvezda module of the ISS.</obo:IAO_0000112>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An instance of a module on the International Space Station, operated by the Russian Space Agency.</obo:IAO_0000115>
        <obo:IAO_0000119 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Wikipedia</obo:IAO_0000119>
