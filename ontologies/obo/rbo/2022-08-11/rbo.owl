                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UO_0000294"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>&quot;An information unit which is equal to 1000 bytes.&quot; [Wikipedia:Wikipedia]</rdfs:comment>
        <rdfs:label>kilobyte</rdfs:label>
        <oboInOwl1:hasExactSynonym>kB</oboInOwl1:hasExactSynonym>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0000235 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0000235">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/UO_1000233"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/has_prefix"/>
