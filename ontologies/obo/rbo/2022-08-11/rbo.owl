        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_0000109"/>
        <rdfs:comment>&quot;A unit of pressure equal to the amount of fluid pressure one millimeter deep in mercury at zero degrees centigrade on Earth.&quot; [url:en.wiktionary.org/wiki/mmHg]</rdfs:comment>
        <rdfs:label>millimetres of mercury</rdfs:label>
        <oboInOwl1:hasExactSynonym>millimeters of mercury</oboInOwl1:hasExactSynonym>
        <oboInOwl1:hasExactSynonym>mmHg</oboInOwl1:hasExactSynonym>
    </owl:Class>
    


