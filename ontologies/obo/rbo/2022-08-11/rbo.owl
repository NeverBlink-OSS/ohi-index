        <oboInOwl:hasDbXref>VHOG:0001195</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>galen:SuperiorVenaCava</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>superior caval vein</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>superior vena cava</oboInOwl:hasExactSynonym>
