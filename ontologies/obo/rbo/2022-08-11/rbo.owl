        <oboInOwl:id>ENVO:01000023</oboInOwl:id>
        <oboInOwl:inSubset>envoPolar</oboInOwl:inSubset>
        <rdfs:label>marine pelagic biome</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ENVO_01000023"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>The marine pelagic biome (pelagic meaning open sea) is that of the marine water column, from the surface to the greatest depths.</owl:annotatedTarget>
