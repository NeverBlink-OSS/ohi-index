    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_03000043">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_02500000"/>
        <rdfs:subClassOf>
            <owl:Restriction>
