        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000003"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_0000000"/>
        <obo:IAO_0000111>substance unit</obo:IAO_0000111>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/uo.owl"/>
        <rdfs:comment>&quot;A unit which is a standardised quantity of an element or compound with uniform composition.&quot; [Wikipedia:Wikipedia]</rdfs:comment>
        <rdfs:label>substance unit</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0000007 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0000007">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_0000157"/>
        <rdfs:comment>&quot;A unit which is a standard measure of the wavelength-weighted power emitted by a light source in a particular direction.&quot; [Wikipedia:Wikipedia]</rdfs:comment>
        <rdfs:label>luminous intensity unit</rdfs:label>
    </owl:Class>
    


