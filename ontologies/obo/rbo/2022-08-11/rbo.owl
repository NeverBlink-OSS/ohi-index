                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PO_0025034"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PATO_0001422"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Leaf litter is dead plant material, such as leaves, bark, needles, and twigs, that has fallen to the ground.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>duff</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>leaf litter</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>litterfall</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>soil litter</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>tree litter</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">plant litter</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ENVO_01000628"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Leaf litter is dead plant material, such as leaves, bark, needles, and twigs, that has fallen to the ground.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>https://en.wikipedia.org/wiki/Plant_litter</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ENVO_01000635 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_01000635">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_01000324"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_01001782"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002219"/>
