        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_1000014"/>
        <rdfs:comment>&quot;A luminous intensity unit which equal to the luminous intensity, in a given direction, of a source that emits monochromatic radiation of frequency 540 x 1012 hertz and that has a radiant intensity in that direction of 1/683 watt per steradian.&quot; [BIPM:BIPM, NIST:NIST]</rdfs:comment>
        <rdfs:label>candela</rdfs:label>
        <oboInOwl1:hasExactSynonym>cd</oboInOwl1:hasExactSynonym>
    </owl:Class>
    


