        <owl:annotatedTarget>An organism subdivision that includes both an appendage and its associated girdle region. Note that this includes both the skeletal elements and associated tissues (integument, muscle, etc).</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:resource="https://github.com/obophenotype/uberon/wiki/Appendages-and-the-appendicular-skeleton"/>
        <oboInOwl:hasDbXref rdf:resource="https://orcid.org/0000-0002-6601-2165"/>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UBERON_0010707"/>
