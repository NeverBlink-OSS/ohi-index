        </rdfs:subClassOf>
        <rdfs:comment>&quot;An electric potential difference unit which is equal to one billionth of a volt or 10^[-12] V.&quot; [UOC:GVG]</rdfs:comment>
        <rdfs:label>nanovolt</rdfs:label>
        <oboInOwl1:hasExactSynonym>nV</oboInOwl1:hasExactSynonym>
    </owl:Class>
    


