    <!-- http://purl.obolibrary.org/obo/CL_1000409 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CL_1000409">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CL_0002072"/>
        <obo:IAO_0000115>A muscle cell that is part of the sinoatrial node.</obo:IAO_0000115>
