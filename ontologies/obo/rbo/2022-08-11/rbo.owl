        <oboInOwl:hasBroadSynonym>hydrographic feature</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasDbXref>EcoLexicon:waterbody</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>FTT:131</oboInOwl:hasDbXref>
