            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>&quot;An electric potential difference unit which is equal to one million volts or 10^[6] V.&quot; [UOC:GVG]</rdfs:comment>
        <rdfs:label>megavolt</rdfs:label>
        <oboInOwl1:hasExactSynonym>MV</oboInOwl1:hasExactSynonym>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0000253 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0000253">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_0000000"/>
        <rdfs:comment>&quot;A unit which is a standard measure of the ability of a liguid to attraction of molecules at its surface as a result of unbalanced molecular cohesive forces.&quot; [NIST:NIST]</rdfs:comment>
        <rdfs:label>surface tension unit</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0000254 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0000254">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_1000254"/>
        <rdfs:comment>&quot;A surface tension unit which is equal to one newton per meter.&quot; [NIST:NIST]</rdfs:comment>
        <rdfs:label>newton per meter</rdfs:label>
        <oboInOwl1:hasExactSynonym>N/m</oboInOwl1:hasExactSynonym>
        <oboInOwl1:hasExactSynonym>newton per metre</oboInOwl1:hasExactSynonym>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0000255 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0000255">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_1000255"/>
        <rdfs:comment>&quot;A surface tension unit which is equal to one dyne per centimeter.&quot; [Wikipedia:Wikipedia]</rdfs:comment>
        <rdfs:label>dyne per cm</rdfs:label>
        <oboInOwl1:hasExactSynonym>dyn/cm</oboInOwl1:hasExactSynonym>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0000256 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0000256">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_0000000"/>
        <rdfs:comment>&quot;A unit which is a standard measure of the internal resistance of fluids to flow.&quot; [UOC:GVG]</rdfs:comment>
        <rdfs:label>viscosity unit</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0000257 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0000257">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_1000257"/>
        <rdfs:comment>&quot;A viscosity unit which is equal to one pascale per second.&quot; [NIST:NIST]</rdfs:comment>
        <rdfs:label>pascal second</rdfs:label>
        <oboInOwl1:hasExactSynonym>Pa  s</oboInOwl1:hasExactSynonym>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0000258 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0000258">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_1000258"/>
        <rdfs:comment>&quot;A viscosity unit which is equal to one dyne second per square centimeter.&quot; [Wikipedia:Wikipedia]</rdfs:comment>
        <rdfs:label>poise</rdfs:label>
        <oboInOwl1:hasExactSynonym>P</oboInOwl1:hasExactSynonym>
        <oboInOwl1:hasExactSynonym>dyne s/cm^2</oboInOwl1:hasExactSynonym>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0000259 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0000259">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_0000190"/>
        <rdfs:comment>&quot;A ratio unit which is an indicator of sound power per unit area.&quot; [techtarget:techtarget]</rdfs:comment>
        <rdfs:label>decibel</rdfs:label>
        <oboInOwl1:hasExactSynonym>dB</oboInOwl1:hasExactSynonym>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0000260 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0000260">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_1000260"/>
        <rdfs:comment>&quot;A unit which is a standard measure of the estimate of the stochastic effect that a non-uniform radiation dose has on a human.&quot; [Wikipedia:Wikipedia]</rdfs:comment>
        <rdfs:label>effective dose unit</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0000261 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0000261">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_0000000"/>
        <rdfs:comment>&quot;A unit which represents a standard measurement of the transmission of an entity through a medium.&quot; [UOC:GVG]</rdfs:comment>
        <rdfs:label>conduction unit</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0000262 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0000262">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_0000261"/>
        <rdfs:comment>&quot;A unit which represents a standard measurement of the movement of electrically charged particles through a transmission medium (electrical conductor).&quot; [UOC:GVG]</rdfs:comment>
        <rdfs:label>electrical conduction unit</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0000263 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0000263">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_0000261"/>
        <rdfs:comment>&quot;A unit which represents a standard measurement of the spontaneous transfer of thermal energy through matter, from a region of higher temperature to a region of lower temperature.&quot; [Wikipedia:Wikipedia]</rdfs:comment>
        <rdfs:label>heat conduction unit</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0000264 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0000264">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_1000264"/>
        <rdfs:comment>&quot;An electrical conduction unit which is equal to A/V.&quot; [NIST:NIST]</rdfs:comment>
        <rdfs:label>siemens</rdfs:label>
        <oboInOwl1:hasExactSynonym>A V^-1</oboInOwl1:hasExactSynonym>
        <oboInOwl1:hasExactSynonym>mho </oboInOwl1:hasExactSynonym>
        <oboInOwl1:hasRelatedSynonym>S</oboInOwl1:hasRelatedSynonym>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0000265 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0000265">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_1000265"/>
        <rdfs:comment>&quot;An heat conduction unit which is equal to one watt divided by meter kelvin.&quot; [NIST:NIST]</rdfs:comment>
        <rdfs:label>watt per meter kelvin</rdfs:label>
        <oboInOwl1:hasExactSynonym>W/m K</oboInOwl1:hasExactSynonym>
        <oboInOwl1:hasExactSynonym>watt per metre kelvin</oboInOwl1:hasExactSynonym>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0000266 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0000266">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_1000266"/>
        <rdfs:comment>&quot;A non-SI unit of energy (eV) defined as the energy acquired by a single unbound electron when it passes through an electrostatic potential difference of one volt. An electronvolt is equal to 1.602 176 53(14) x 10^-19 J.&quot; [Wikipedia:Wikipedia]</rdfs:comment>
        <rdfs:label>electronvolt</rdfs:label>
        <oboInOwl1:hasExactSynonym>eV</oboInOwl1:hasExactSynonym>
        <oboInOwl1:hasExactSynonym>electron volt</oboInOwl1:hasExactSynonym>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0000267 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0000267">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_0000000"/>
        <rdfs:comment>&quot;The electric field strength is a unit which is a measure of the potential difference between two points some distance apart.&quot; [Wikipedia:http\://en.wikipedia.org/wiki/Electric_field]</rdfs:comment>
        <rdfs:label>electric field strength unit</rdfs:label>
        <oboInOwl1:hasExactSynonym>E-field strength </oboInOwl1:hasExactSynonym>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0000268 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0000268">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_1000268"/>
        <rdfs:comment>&quot;The volt per meter is a unit of electric field strength equal to the a potential difference of 1 volt existing between two points that are 1 meter apart.&quot; [Wikipedia:http\://en.wikipedia.org/wiki/Electric_field]</rdfs:comment>
        <rdfs:label>volt per meter</rdfs:label>
        <oboInOwl1:hasExactSynonym>V/m</oboInOwl1:hasExactSynonym>
        <oboInOwl1:hasExactSynonym>volt per metre</oboInOwl1:hasExactSynonym>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0000269 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0000269">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_1000269"/>
        <rdfs:comment>&quot;A dimensionless logarithmic unit assigned to a measure of absorbance of light through a partially absorbing substance, defined as -log10(I/I_0) where I = transmitted light and I_0 = incident light.&quot; [Wikipedia:http\://en.wikipedia.org/wiki/Absorbance]</rdfs:comment>
        <rdfs:label>absorbance unit</rdfs:label>
        <oboInOwl1:hasExactSynonym>AU</oboInOwl1:hasExactSynonym>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0000270 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0000270">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000003"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_0000000"/>
        <obo:IAO_0000111>volumetric flow rate unit</obo:IAO_0000111>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/uo.owl"/>
        <rdfs:comment>&quot;A unit which is a standard measure of the volume of fluid which passes through a given surface per unit time .&quot; [Wikipedia:Wikipedia]</rdfs:comment>
        <rdfs:label>volumetric flow rate unit</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0000271 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0000271">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_0000270"/>
    </owl:Class>
    


