    <!-- http://purl.obolibrary.org/obo/UBERON_0008895 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0008895">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0010314"/>
