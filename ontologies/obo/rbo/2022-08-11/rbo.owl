        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDbXref"/>
        <owl:annotatedTarget>UMLS:C1512940</owl:annotatedTarget>
        <oboInOwl:source>ncithesaurus:Intraembryonic_Coelom</oboInOwl:source>
    </owl:Axiom>
