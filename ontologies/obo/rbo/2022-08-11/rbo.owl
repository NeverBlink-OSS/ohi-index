        </rdfs:subClassOf>
        <rdfs:comment>&quot;An activity (of a radionuclide) unit which is equal to one thousandth of a curie or 10^[-3] Ci.&quot; [ORCBS:ORCBS]</rdfs:comment>
        <rdfs:label>millicurie</rdfs:label>
        <oboInOwl1:hasExactSynonym>mCi</oboInOwl1:hasExactSynonym>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0000146 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0000146">
