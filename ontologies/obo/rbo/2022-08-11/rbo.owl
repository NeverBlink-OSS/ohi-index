        <oboInOwl:hasDbXref>EHDAA2:0000186</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>EHDAA:398</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>EHDAA:7327</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>EMAPA:16684</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>NCIT:C32123</oboInOwl:hasDbXref>
