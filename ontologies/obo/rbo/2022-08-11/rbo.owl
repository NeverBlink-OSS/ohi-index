        <owl:annotatedTarget>Any hollow cylindrical anatomical structure containing a lumen through which substances are transported.</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:resource="http://orcid.org/0000-0002-6601-2165"/>
