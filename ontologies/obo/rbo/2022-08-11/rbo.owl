        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_1000013"/>
        <rdfs:comment>&quot;A substance unit which is equal to the amount of substance of a molecular system which contains as many elementary entities as there are atoms in 0.012 kilogram of carbon 12.&quot; [BIPM:BIPM, NIST:NIST]</rdfs:comment>
        <rdfs:label>mole</rdfs:label>
        <oboInOwl1:hasExactSynonym>mol</oboInOwl1:hasExactSynonym>
    </owl:Class>
    


