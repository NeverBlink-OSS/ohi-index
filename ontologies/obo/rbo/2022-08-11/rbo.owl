        <obo:IAO_0000115>A biome is an ecosystem to which resident ecological communities have evolved adaptations.</obo:IAO_0000115>
        <oboInOwl:hasAlternativeId>LTER:809</oboInOwl:hasAlternativeId>
        <oboInOwl:hasDbXref>EcoLexicon:biome</oboInOwl:hasDbXref>
