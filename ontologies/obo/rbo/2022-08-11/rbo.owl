        <oboInOwl:source rdf:resource="https://github.com/obophenotype/uberon/wiki/The-neural-crest"/>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000926"/>
