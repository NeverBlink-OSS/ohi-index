        <rdfs:label>anterior vena cava</rdfs:label>
        <foaf:depicted_by rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://upload.wikimedia.org/wikipedia/commons/b/b4/Venenwinkel.png</foaf:depicted_by>
