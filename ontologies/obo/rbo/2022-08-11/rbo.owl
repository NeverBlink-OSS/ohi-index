        <oboInOwl:hasDbXref>FMA:293149</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>NCIT:C34199</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>TAO:0000121</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS:C1517749</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>VHOG:0000118</oboInOwl:hasDbXref>
