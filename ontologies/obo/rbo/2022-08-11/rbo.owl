        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-11-03T20:24:50Z</oboInOwl:creation_date>
        <rdfs:label>potential energy</rdfs:label>
    </owl:Class>
    


