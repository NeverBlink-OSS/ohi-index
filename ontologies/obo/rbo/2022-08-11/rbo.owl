        <oboInOwl1:hasExactSynonym>time derived unit</oboInOwl1:hasExactSynonym>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0000004 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0000004">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_0000000"/>
        <rdfs:comment>&quot;A unit which is a standard measure of the flow of electric charge.&quot; [Wikipedia:Wikipedia]</rdfs:comment>
        <rdfs:label>electric current unit</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0000005 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0000005">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000003"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_0000000"/>
        <obo:IAO_0000111>temperature unit</obo:IAO_0000111>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/uo.owl"/>
        <rdfs:comment>&quot;A unit which is a standard measure of the average kinetic energy of the particles in a sample of matter.&quot; [Wikipedia:Wikipedia]</rdfs:comment>
        <rdfs:label>temperature unit</rdfs:label>
        <oboInOwl1:hasExactSynonym>temperature derived unit</oboInOwl1:hasExactSynonym>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0000006 -->

