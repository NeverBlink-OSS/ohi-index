    <!-- http://purl.obolibrary.org/obo/UO_0000310 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0000310">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_1000310"/>
        <rdfs:comment>&quot;A concentration unit which is a standard measure of the amount of a toxic or pharmaceutical substance administered over time to a recipient subject, expressed in terms of the size of the subject.&quot; [UO:PC]</rdfs:comment>
        <rdfs:label>dosage unit</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0000312 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0000312">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_1000312"/>
        <rdfs:comment>&quot;A derived unit which is a measure of relative light intensity, as typically measured by a luminometer, spectrophotometer, or fluorimeter in biological research applications.&quot; [UO:PC]</rdfs:comment>
        <rdfs:label>relative light unit</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0000313 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0000313">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_1000313"/>
        <rdfs:comment>&quot;A relative light unit which is a measure of relative luminescence intensity.&quot; [UO:PC]</rdfs:comment>
        <rdfs:label>relative luminescence unit</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0000314 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0000314">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_1000314"/>
        <rdfs:comment>&quot;A relative light unit which is a measure of relative fluorescence intensity.&quot; [UO:PC]</rdfs:comment>
        <rdfs:label>relative fluorescence unit</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0000325 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0000325">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_0000105"/>
        <rdfs:comment>&quot;A frequency unit which is equal to one million hertz or 10^[6] V.&quot; [UOC:GVG]</rdfs:comment>
        <rdfs:label>megaHertz</rdfs:label>
        <oboInOwl1:hasRelatedSynonym>mH</oboInOwl1:hasRelatedSynonym>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0000326 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0000326">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_0000001"/>
        <rdfs:comment>&quot;A unit used to express distances on a genetic map. In genetic mapping, distances between markers are determined by measuring the rate of meoitic recombination between them, which increases proportionately with the distance separating them. A cM is defined as the length of an interval in which there is a 1% probability of recombination. On the average, 1 cM is roughly equivalent to 1 megabase (Mb) of DNA, although this can vary widely due to hot and cold spots of recombination.&quot; [NCBI:http\://www.ncbi.nlm.nih.gov/SCIENCE96/Glossary.html]</rdfs:comment>
        <rdfs:label>centiMorgan</rdfs:label>
        <oboInOwl1:hasExactSynonym>cM</oboInOwl1:hasExactSynonym>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0000327 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0000327">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_0000001"/>
        <rdfs:comment>&quot;A unit of genetic map distance defined corresponding to an interval in which there is a 1% probability of X-irradiation induced breakage. To be completely specified, the unit must be qualified by the radiation in dosage in rads (e.g. cR8000), because this determines the actual breakage probability.&quot; [NCBI:http\://www.ncbi.nlm.nih.gov/SCIENCE96/Glossary.html]</rdfs:comment>
        <rdfs:label>centiRay</rdfs:label>
        <oboInOwl1:hasExactSynonym>cR</oboInOwl1:hasExactSynonym>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0000329 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0000329">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/UO_1000244"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/has_prefix"/>
                        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UO_0000293"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_1000244"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/has_prefix"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UO_0000293"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>&quot;A unit equal to one million base pairs&quot; [UOC:GVG]</rdfs:comment>
        <rdfs:label>mega base pair</rdfs:label>
        <oboInOwl1:hasExactSynonym>Mb</oboInOwl1:hasExactSynonym>
        <oboInOwl1:hasExactSynonym>megabasepair</oboInOwl1:hasExactSynonym>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0000330 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0000330">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/UO_1000244"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/has_prefix"/>
                        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UO_0000292"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_1000244"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/has_prefix"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UO_0000292"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>&quot;A unit equal to one billion base pairs.&quot; [UOC:GVG]</rdfs:comment>
        <rdfs:label>giga base pair</rdfs:label>
        <oboInOwl1:hasExactSynonym>Gb</oboInOwl1:hasExactSynonym>
        <oboInOwl1:hasExactSynonym>gigabasepair</oboInOwl1:hasExactSynonym>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0010001 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0010001">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_1010001"/>
        <rdfs:comment>&quot;An area unit which is equal to an area enclosed by a square with sides each 1 micrometer long.&quot; [NIST:NIST]</rdfs:comment>
        <rdfs:label>square micrometer</rdfs:label>
        <oboInOwl1:hasExactSynonym>square micrometre</oboInOwl1:hasExactSynonym>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0010002 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0010002">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/UO_1000264"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/has_prefix"/>
                        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UO_0000297"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_1000264"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/has_prefix"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UO_0000297"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>&quot;An electrical conduction unit which is equal to one thousandth of a siemen or 10^[-3] siemens.&quot; [NIST:NIST]</rdfs:comment>
        <rdfs:label>millisiemens</rdfs:label>
        <oboInOwl1:hasRelatedSynonym>mS</oboInOwl1:hasRelatedSynonym>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0010003 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0010003">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_0000067"/>
        <rdfs:comment>&quot;A specific concentration unit which is equal to 1 micromole in a given volume of one thousandth of a cubic meter.&quot; [NIST:NIST]</rdfs:comment>
        <rdfs:label>micromole per litre</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0010004 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0010004">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_0000067"/>
        <rdfs:comment>&quot;A specific concentration unit which is equal to 1 micromole of a given substance per kilogram of solvent.&quot; [UOB:LKSR]</rdfs:comment>
        <rdfs:label>micromole per kilogram</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0010005 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0010005">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_0000060"/>
        <rdfs:comment>&quot;A speed/velocity unit which is equal to the speed of an object traveling 1 millimeter distance in one day.&quot; [UOB:LKSR]</rdfs:comment>
        <rdfs:label>millimeters per day</rdfs:label>
        <oboInOwl1:hasExactSynonym>mm/day</oboInOwl1:hasExactSynonym>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0010008 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0010008">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_0000060"/>
        <rdfs:comment>&quot;A speed/velocity unit which is equal to the speed of an object traveling 1 kilometer distance in one hour.&quot; [NIST:NIST]</rdfs:comment>
        <rdfs:label>kilometer per hour</rdfs:label>
        <oboInOwl1:hasExactSynonym>kilometre per hour</oboInOwl1:hasExactSynonym>
        <oboInOwl1:hasExactSynonym>km/h</oboInOwl1:hasExactSynonym>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0010009 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0010009">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_0000002"/>
        <rdfs:comment>&quot;A mass unit which is equal to 1/12 the mass of 12C&quot; [Wikipedia:Wikipedia]</rdfs:comment>
        <rdfs:label>milli</rdfs:label>
        <oboInOwl1:hasExactSynonym>mDa</oboInOwl1:hasExactSynonym>
        <oboInOwl1:hasExactSynonym>milli unified atomic mass unit</oboInOwl1:hasExactSynonym>
        <oboInOwl1:hasExactSynonym>millidalton</oboInOwl1:hasExactSynonym>
        <oboInOwl1:hasExactSynonym>mmu</oboInOwl1:hasExactSynonym>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0010010 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0010010">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_1010010"/>
        <rdfs:comment>&quot;An area unit which is equal to an area of 10,000 square meters. Equivalent to 2.471 acres.&quot; [Wikipedia:Wikipedia]</rdfs:comment>
        <rdfs:label>hectare</rdfs:label>
        <oboInOwl1:hasExactSynonym>HA</oboInOwl1:hasExactSynonym>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0010011 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0010011">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_0000045"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_1010011"/>
        <rdfs:comment>&quot;A length unit which is equal to 0.0254 metres.&quot; [Wikipedia:Wikpiedia]</rdfs:comment>
        <rdfs:label>inch</rdfs:label>
        <oboInOwl1:hasExactSynonym>in</oboInOwl1:hasExactSynonym>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0010012 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0010012">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_0000045"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_1010012"/>
        <rdfs:comment>&quot;A length unit which is equal to 0.0254 millimetres.&quot; [Wikipedia:Wikpiedia]</rdfs:comment>
        <rdfs:label>thou</rdfs:label>
        <oboInOwl1:hasExactSynonym>mil</oboInOwl1:hasExactSynonym>
        <oboInOwl1:hasExactSynonym>th</oboInOwl1:hasExactSynonym>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0010013 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0010013">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_0000045"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_1010013"/>
        <rdfs:comment>&quot;A length unit which is equal to 0.3048 metres, or 12 inches.&quot; [Wikipedia:Wikpiedia]</rdfs:comment>
        <rdfs:label>foot</rdfs:label>
        <oboInOwl1:hasExactSynonym>ft</oboInOwl1:hasExactSynonym>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0010014 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0010014">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_0000045"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_1010014"/>
        <rdfs:comment>&quot;A length unit which is equal to 0.9144 metres, or 3 feet.&quot; [Wikipedia:Wikpiedia]</rdfs:comment>
        <rdfs:label>yard</rdfs:label>
        <oboInOwl1:hasExactSynonym>yd</oboInOwl1:hasExactSynonym>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0010015 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0010015">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_0000045"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_1010015"/>
        <rdfs:comment>&quot;A length unit which is equal to 20.1168 metres, 66 feet, or 22 yards.&quot; [Wikipedia:Wikpiedia]</rdfs:comment>
        <rdfs:label>chain</rdfs:label>
        <oboInOwl1:hasExactSynonym>ch</oboInOwl1:hasExactSynonym>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0010016 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0010016">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_0000045"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_1010016"/>
        <rdfs:comment>&quot;A length unit which is equal to 20,116.8 metres, 660 feet, or 10 chains.&quot; [Wikipedia:Wikpiedia]</rdfs:comment>
        <rdfs:label>furlong</rdfs:label>
        <oboInOwl1:hasExactSynonym>fur</oboInOwl1:hasExactSynonym>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0010017 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0010017">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_0000045"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_1010017"/>
        <rdfs:comment>&quot;A length unit which is equal to 1,609.344 metres, or 8 furlongs.&quot; [Wikipedia:Wikpiedia]</rdfs:comment>
        <rdfs:label>mile</rdfs:label>
        <oboInOwl1:hasExactSynonym>mi</oboInOwl1:hasExactSynonym>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0010018 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0010018">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_0000045"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_1010018"/>
        <rdfs:comment>&quot;A length unit which is equal to 3 miles, or 4,828.032 metres&quot; [Wikipedia:Wikpiedia]</rdfs:comment>
        <rdfs:label>league</rdfs:label>
        <oboInOwl1:hasExactSynonym>lea</oboInOwl1:hasExactSynonym>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0010019 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0010019">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_1010019"/>
        <rdfs:comment>&quot;A maritime length unit is one used primarily at sea.&quot; [Wikipedia:Wikpiedia]</rdfs:comment>
        <rdfs:label>maritime length unit</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0010020 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0010020">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_1010020"/>
        <rdfs:comment>&quot;A maritime length unit which is equal to 6.08 feet, or 1.853184 metres&quot; [Wikipedia:Wikpiedia]</rdfs:comment>
        <rdfs:label>fathom</rdfs:label>
        <oboInOwl1:hasExactSynonym>ftm</oboInOwl1:hasExactSynonym>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0010021 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0010021">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_1010021"/>
        <rdfs:comment>&quot;A maritime length unit which is equal to 608 feet, 100 fathoms, or 185.3184 metres&quot; [Wikipedia:Wikpiedia]</rdfs:comment>
        <rdfs:label>cable</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0010022 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0010022">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_1010022"/>
        <rdfs:comment>&quot;A maritime length unit which is equal to 6,080 feet, 10 cables, or 1,853.184 metres&quot; [Wikipedia:Wikpiedia]</rdfs:comment>
        <rdfs:label>nautical mile</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0010023 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0010023">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_1010023"/>
        <rdfs:comment>&quot;An area unit which is equal to an area of 25.292,852,64 square meters, or 1 square rod.&quot; [Wikipedia:Wikipedia]</rdfs:comment>
        <rdfs:label>perch</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0010024 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0010024">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_1010024"/>
        <rdfs:comment>&quot;An area unit which is equivalent to 1 furlong x 1 rod. This is equal to an area of 1,011.714,1056 square meters, or 40 square rods.&quot; [Wikipedia:Wikipedia]</rdfs:comment>
        <rdfs:label>rood</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0010025 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0010025">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_1010025"/>
        <rdfs:comment>&quot;An area unit which is equivalent to 1 furlong x 1 chain. This is equal to an area of 4,046.856,4224 square meters, or 43,500 square feet.&quot; [Wikipedia:Wikipedia]</rdfs:comment>
        <rdfs:label>acre</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0010026 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0010026">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_1010026"/>
        <rdfs:comment>&quot;An imperial volume unit which is equivalent to 28.413,0625 millilitres.&quot; [Wikipedia:Wikipedia]</rdfs:comment>
        <rdfs:label>fluid ounce</rdfs:label>
        <oboInOwl1:hasExactSynonym>fl oz</oboInOwl1:hasExactSynonym>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0010027 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0010027">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_1010027"/>
        <rdfs:comment>&quot;An imperial volume unit which is equivalent to 142.065,3125 millilitres.&quot; [Wikipedia:Wikipedia]</rdfs:comment>
        <rdfs:label>gill</rdfs:label>
        <oboInOwl1:hasExactSynonym>gi</oboInOwl1:hasExactSynonym>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0010028 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0010028">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_1010028"/>
        <rdfs:comment>&quot;An imperial volume unit which is equivalent to 568.261,25 millilitres.&quot; [Wikipedia:Wikipedia]</rdfs:comment>
        <rdfs:label>pint</rdfs:label>
        <oboInOwl1:hasExactSynonym>pt</oboInOwl1:hasExactSynonym>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0010029 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0010029">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_1010029"/>
        <rdfs:comment>&quot;An imperial volume unit which is equivalent to 1,136.5225 millilitres, or two pints.&quot; [Wikipedia:Wikipedia]</rdfs:comment>
        <rdfs:label>quart</rdfs:label>
        <oboInOwl1:hasExactSynonym>qt</oboInOwl1:hasExactSynonym>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0010030 -->

