    <!-- http://purl.obolibrary.org/obo/UBERON_0002329 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0002329">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CARO_0000000"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0005423"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0007503"/>
