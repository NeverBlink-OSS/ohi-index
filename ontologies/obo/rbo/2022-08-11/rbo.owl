    <!-- http://purl.obolibrary.org/obo/GO_0009314 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GO_0009314">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0009628"/>
