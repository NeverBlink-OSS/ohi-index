        <rdfs:label>nanosievert</rdfs:label>
        <oboInOwl1:hasExactSynonym>nSv</oboInOwl1:hasExactSynonym>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0000145 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0000145">
