        <owl:annotatedTarget>transforms from</owl:annotatedTarget>
        <oboInOwl:hasDbXref>SIO:000657</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/RO_0002495 -->

    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/RO_0002495">
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/RO_0002207"/>
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/RO_0002494"/>
        <obo:IAO_0000115>x immediate transformation of y iff x immediately succeeds y temporally at a time boundary t, and all of the matter present in x at t is present in y at t, and all the matter in y at t is present in x at t</obo:IAO_0000115>
        <oboInOwl:hasDbXref>RO:0002495</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>direct_transformation_of</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>immediately transforms from</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>uberon</oboInOwl:hasOBONamespace>
        <oboInOwl:id>immediate_transformation_of</oboInOwl:id>
        <oboInOwl:shorthand>immediate_transformation_of</oboInOwl:shorthand>
        <rdfs:label>immediate transformation of</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/SIO_000658"/>
    </owl:ObjectProperty>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/RO_0002495"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>direct_transformation_of</owl:annotatedTarget>
