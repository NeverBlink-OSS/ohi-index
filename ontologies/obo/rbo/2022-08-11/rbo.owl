        <obo:IAO_0000111 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">x-ray</obo:IAO_0000111>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Electromagnetic radiation with photon energies approximately between 0.1 and 120 keV. The upper end of the x-ray spectrum overlaps with the lower end of the gamma ray spectrum.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Jack Miller</obo:IAO_0000117>
        <obo:IAO_0000118 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">x-ray</obo:IAO_0000118>
        <obo:IAO_0000119 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://son.nasa.gov/tass/content/electrospectrum.htm</obo:IAO_0000119>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">x-ray radiation</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/RBO_00005014 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/RBO_00005014">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000040"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A material entity which emits radiation</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Jack Miller</obo:IAO_0000117>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">radiation source</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/RBO_00005015 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/RBO_00005015">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OBI_0000272"/>
        <obo:IAO_0000111 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sham irradiation</obo:IAO_0000111>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A protocol in which a sample is kept under conditions identical to irradiated samples, without exposure</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Jack Miller</obo:IAO_0000117>
        <obo:IAO_0000118 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sham</obo:IAO_0000118>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sham irradiation</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/RBO_00005016 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/RBO_00005016">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000104"/>
        <obo:IAO_0000111 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">fractionation protocol</obo:IAO_0000111>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A protocol for administering a total radiation dose in two or more increments separated by a specified time interval</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Jack Miller</obo:IAO_0000117>
        <obo:IAO_0000118 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">fractionation protocol</obo:IAO_0000118>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">radiation fractionation protocol</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/RBO_00005017 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/RBO_00005017">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/RBO_00000016"/>
        <obo:IAO_0000111 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">cis-lunar space</obo:IAO_0000111>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The region of space between the Earth and the Moon</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Jack Miller</obo:IAO_0000117>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">cis-lunar space</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/RBO_00005018 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/RBO_00005018">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/RBO_00000016"/>
        <obo:IAO_0000111 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">lunar orbit</obo:IAO_0000111>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A region of space defined by a regular, repeating path of a specified object about Earth&apos;s moon</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Jack Miller</obo:IAO_0000117>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">lunar orbit</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/RBO_00005019 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/RBO_00005019">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/RBO_00000016"/>
        <obo:IAO_0000111 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">lunar surface</obo:IAO_0000111>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The area of the lunar landmass exposed to space</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Jack Miller</obo:IAO_0000117>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">lunar surface</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/RBO_00005020 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/RBO_00005020">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/RBO_00000016"/>
        <obo:IAO_0000111 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">cis-Mars space</obo:IAO_0000111>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The region of space between the Earth and Mars</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Jack Miller</obo:IAO_0000117>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">cis-Mars space</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/RBO_00005021 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/RBO_00005021">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/RBO_00000016"/>
        <obo:IAO_0000111 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Mars orbit</obo:IAO_0000111>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A region of space defined by a regular, repeating path of a specified object about Mars</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Jack Miller</obo:IAO_0000117>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Mars orbit</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/RBO_00005022 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/RBO_00005022">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/RBO_00000016"/>
        <obo:IAO_0000111 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Mars surface</obo:IAO_0000111>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The area of the Mars landmass exposed to the Martian atmosphere</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Jack Miller</obo:IAO_0000117>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Mars surface</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/RBO_00005023 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/RBO_00005023">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/RBO_00000016"/>
        <obo:IAO_0000111 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">interplanetary space</obo:IAO_0000111>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The region of space in the Solar System between planets</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Jack Miller</obo:IAO_0000117>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">interplanetary space</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/RBO_00005024 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/RBO_00005024">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/RBO_00000016"/>
        <obo:IAO_0000111 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">planet surface</obo:IAO_0000111>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The outermost solid or liquid area of a planet</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Jack Miller</obo:IAO_0000117>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">planet surface</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/RBO_00005025 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/RBO_00005025">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PATO_0001744"/>
        <obo:IAO_0000111 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">non-irradiated</obo:IAO_0000111>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An organism or material entity kept unexposed to radiation, for purposes of comparison to a similar organism or material entity that has been exposed to radiation</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Jack Miller</obo:IAO_0000117>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">non-irradiated</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/RBO_00005026 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/RBO_00005026">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/RBO_00000082"/>
        <obo:IAO_0000111 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ground analog experiment</obo:IAO_0000111>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A study at a ground facility designed so as to replicate one or more conditions in space (e.g. radiation, microgravity, isolation)</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Jack Miller</obo:IAO_0000117>
        <obo:IAO_0000118 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ground analog</obo:IAO_0000118>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ground analog study</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/RBO_00005027 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/RBO_00005027">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/RBO_00000082"/>
        <obo:IAO_0000111 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ground control</obo:IAO_0000111>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An study at a ground facility designed so as to replicate conditions in space (e.g. radiation, microgravity, isolation) with the exception of one condition, so as to ascertain the effects of that condition on an organism or instrument</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Jack Miller</obo:IAO_0000117>
        <obo:IAO_0000118 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ground control</obo:IAO_0000118>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ground control study</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/RBO_00005028 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/RBO_00005028">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_01001488"/>
        <obo:IAO_0000111 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">irradiation protocol</obo:IAO_0000111>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A protocol for administering radiation to a sample</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Jack Miller</obo:IAO_0000117>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">irradiation protocol</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/RBO_00005029 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/RBO_00005029">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/RBO_00000024"/>
        <obo:IAO_0000111 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">radiation fraction</obo:IAO_0000111>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">One of the series of individual doses administered to a sample in a fractionated irradiation.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Jack Miller</obo:IAO_0000117>
        <obo:IAO_0000118 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">fraction</obo:IAO_0000118>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">radiation fraction</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/RBO_00005030 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/RBO_00005030">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/RBO_00000029"/>
        <obo:IAO_0000111 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">radiation fraction interval</obo:IAO_0000111>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Time between fractions in a fractionated irradiation.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Jack Miller</obo:IAO_0000117>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">radiation fraction interval</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/RBO_00005031 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/RBO_00005031">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OBI_0002983"/>
        <obo:IAO_0000111 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">high altitude</obo:IAO_0000111>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The region of the atmosphere above 8000 feet above sea level. Altitudes above 12000 feet are sometimes referred to as very high altitude, and above 18000 feet as extremely high altitude.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Jack Miller</obo:IAO_0000117>
        <obo:IAO_0000119 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://www.medicinenet.com/high_altitude/definition.htm</obo:IAO_0000119>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">high altitude</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/RBO_00005032 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/RBO_00005032">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/RBO_00005025"/>
        <obo:IAO_0000111 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sham</obo:IAO_0000111>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A radiation quality resulting from a material entity being kept under similar conditions as an irradiated material entity</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Jack Miller</obo:IAO_0000117>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sham-irradiated</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/RBO_00005033 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/RBO_00005033">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_01001488"/>
        <obo:IAO_0000111 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">parabolic flight</obo:IAO_0000111>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An aircraft which flies a series of parabolic arcs to simulate micrgravity.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Jack Miller</obo:IAO_0000117>
        <obo:IAO_0000118 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Vomit Comet</obo:IAO_0000118>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">parabolic flight aircraft</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/RBO_00005034 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/RBO_00005034">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_01001488"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An aircraft which flies at altitudes greater than commercial aircraft altitudes for research purposes.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Jack Miller</obo:IAO_0000117>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">high altitude research aircraft</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/RBO_00005035 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/RBO_00005035">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_01001488"/>
        <obo:IAO_0000111 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">UAV</obo:IAO_0000111>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An research aircraft designed to operate without crew members, either autonomously or under control from a ground station</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Jack Miller</obo:IAO_0000117>
        <obo:IAO_0000118 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">UAV</obo:IAO_0000118>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">uncrewed aerial vehicle</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/RBO_00005036 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/RBO_00005036">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/RBO_00005003"/>
        <obo:IAO_0000111 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">HZE</obo:IAO_0000111>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Fully ionized atomic nuclei with 2 or more protons and energies in excess of tens of MeV per nucleon</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Jack Miller</obo:IAO_0000117>
        <obo:IAO_0000118 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">HZE</obo:IAO_0000118>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">highly charged energetic nuclei</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/RBO_00005037 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/RBO_00005037">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/RBO_00000082"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A study of a response to radiation conditioned by prior administration of radiation of a different type and/or at a different dose or dose rate</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Jack Miller</obo:IAO_0000117>
        <obo:IAO_0000118 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">adaptive</obo:IAO_0000118>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">adaptive radiation response study</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/RBO_00005038 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/RBO_00005038">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/RBO_00000029"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The total dose administered in a series of radiation fractions divided by the elapsed time between the beginning of the first exposure fraction and the end of the last exposure fraction</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Jack Miller</obo:IAO_0000117>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">average fractionated dose rate</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/RBO_00005039 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/RBO_00005039">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/RBO_00005014"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A device which exposes samples to gamma radiation.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Jack Miller</obo:IAO_0000117>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">gamma irradiator</rdfs:label>
    </owl:Class>
    


