        <obo:IAO_0000115>A performance status value specification designed by the Eastern Cooperative Oncology Group to assess disease progression and its affect on the daily living abilities of the patient.</obo:IAO_0000115>
        <obo:IAO_0000117>Chris Stoeckert, Helena Ellis</obo:IAO_0000117>
        <obo:IAO_0000118>ECOG score</obo:IAO_0000118>
        <obo:IAO_0000119>NCI BBRB, OBI</obo:IAO_0000119>
        <obo:IAO_0000234>NCI BBRB</obo:IAO_0000234>
        <rdfs:label>Eastern Cooperative Oncology Group score value specification</rdfs:label>
    </owl:Class>
    


