        </rdfs:subClassOf>
        <obo:IAO_0000115>The layer of glia and differentiating neurons that forms as a second layer around the germinal neuroepithium; as this develops it comes to lie between the ventricular and marginal layers and includes the basal and alar plates. Develops into neurons and glia forming a gray matter layer.</obo:IAO_0000115>
        <oboInOwl:hasDbXref rdf:resource="http://braininfo.rprc.washington.edu/centraldirectory.aspx?ID=1367"/>
        <oboInOwl:hasDbXref>EMAPA:17148</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>EMAPA:35360</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>neural tube intermediate zone</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>uberon</oboInOwl:hasOBONamespace>
        <oboInOwl:hasRelatedSynonym>future brain marginal layer</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>UBERON:0004061</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#pheno_slim"/>
        <rdfs:label>neural tube mantle layer</rdfs:label>
    </owl:Class>
