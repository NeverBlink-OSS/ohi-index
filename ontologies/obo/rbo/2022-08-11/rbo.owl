    <!-- http://purl.obolibrary.org/obo/UO_0000104 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0000104">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/UO_1000099"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/has_prefix"/>
                        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UO_0000303"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_1000099"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/has_prefix"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UO_0000303"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>&quot;A volume unit which is equal to 10^[-15] L.&quot; [NIST:NIST]</rdfs:comment>
        <rdfs:label>femtoliter</rdfs:label>
        <oboInOwl1:hasExactSynonym>femtolitre</oboInOwl1:hasExactSynonym>
        <oboInOwl1:hasExactSynonym>fl</oboInOwl1:hasExactSynonym>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0000105 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0000105">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000003"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_0000000"/>
        <obo:IAO_0000111>frequency unit</obo:IAO_0000111>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/uo.owl"/>
        <rdfs:comment>&quot;A unit which is a standard measure of the number of repetitive actions in a particular time.&quot; [NIST:NIST]</rdfs:comment>
        <rdfs:label>frequency unit</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0000106 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0000106">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_1000106"/>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0000107 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0000107">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_0000000"/>
        <rdfs:comment>&quot;A unit which is a standard measure of the force is applied when a mass is accelerated.&quot; [NIST:NIST]</rdfs:comment>
        <rdfs:label>force unit</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0000108 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0000108">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_1000108"/>
        <rdfs:comment>&quot;A force unit which is equal to the force required to cause an acceleration of 1m/s2 of a mass of 1 Kg in the direction of the force.&quot; [NIST:NIST]</rdfs:comment>
        <rdfs:label>newton</rdfs:label>
        <oboInOwl1:hasExactSynonym>N</oboInOwl1:hasExactSynonym>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0000109 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0000109">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_0000000"/>
        <rdfs:comment>&quot;A unit which is a standard measure of the force applied to a given area.&quot; [NIST:NIST]</rdfs:comment>
        <rdfs:label>pressure unit</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0000110 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0000110">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_1000110"/>
        <rdfs:comment>&quot;A pressure unit which is equal to the pressure or stress on a surface caused by a force of 1 newton spread over a surface of 1 m^[2].&quot; [NIST:NIST]</rdfs:comment>
        <rdfs:label>pascal</rdfs:label>
        <oboInOwl1:hasExactSynonym>Pa</oboInOwl1:hasExactSynonym>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0000111 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0000111">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_0000000"/>
        <rdfs:comment>&quot;A unit which is a standard measure of the work done by a certain force (gravitational, electric, magnetic, force of inertia, etc).&quot; [NIST:NIST]</rdfs:comment>
        <rdfs:label>energy unit</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0000112 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0000112">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_1000112"/>
        <rdfs:comment>&quot;An energy unit which is equal to the energy required when a force of 1 newton moves an object 1 meter in the direction of the force.&quot; [NIST:NIST]</rdfs:comment>
        <rdfs:label>joule</rdfs:label>
        <oboInOwl1:hasExactSynonym>J</oboInOwl1:hasExactSynonym>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0000113 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0000113">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_0000000"/>
        <rdfs:comment>&quot;A unit which is a standard measure power or the rate of doing work.&quot; [NIST:NIST]</rdfs:comment>
        <rdfs:label>power unit</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0000114 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0000114">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_1000114"/>
        <rdfs:comment>&quot;A power unit which is equal to the power used when work is done at the rate of 1 joule per second.&quot; [NIST:NIST]</rdfs:comment>
        <rdfs:label>watt</rdfs:label>
        <oboInOwl1:hasExactSynonym>W</oboInOwl1:hasExactSynonym>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0000115 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0000115">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_0000157"/>
        <rdfs:comment>&quot;A unit which is a standard measure of the luminous flux incident on a unit area.&quot; [Wikipedia:Wikipedia]</rdfs:comment>
        <rdfs:label>illuminance unit</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0000116 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0000116">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_1000116"/>
        <rdfs:comment>&quot;An illuminance unit which is equal to the illuminance produced by 1 lumen evenly spread over an area 1 m^[2].&quot; [NIST:NIST]</rdfs:comment>
        <rdfs:label>lux</rdfs:label>
        <oboInOwl1:hasExactSynonym>lx</oboInOwl1:hasExactSynonym>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0000117 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0000117">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_0000157"/>
        <rdfs:comment>&quot;A unit which is a standard measure of the flow of radiant energy.&quot; [Wikipedia:Wikipedia]</rdfs:comment>
        <rdfs:label>luminous flux unit</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0000118 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0000118">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_1000118"/>
        <rdfs:comment>&quot;A luminous flux unit which is equal to the luminous flux emitted into 1 steradian by a point source of 1 candela.&quot; [NIST:NIST]</rdfs:comment>
        <rdfs:label>lumen</rdfs:label>
        <oboInOwl1:hasExactSynonym>lm</oboInOwl1:hasExactSynonym>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0000119 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0000119">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_0000000"/>
        <rdfs:comment>&quot;A unit which is a standard measure of the amount of the action of a catalyst.&quot; [NIST:NIST]</rdfs:comment>
        <rdfs:label>catalytic activity unit</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0000120 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0000120">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_1000120"/>
        <rdfs:comment>&quot;A catalytic unit activity which is equal to the activity of a catalyst in moles per second, such as the amount of an enzyme needed to transform one mole of substrate per second.&quot; [NIST:NIST]</rdfs:comment>
        <rdfs:label>katal</rdfs:label>
        <oboInOwl1:hasExactSynonym>kat</oboInOwl1:hasExactSynonym>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0000121 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0000121">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_0000000"/>
        <rdfs:comment>&quot;A unit which is a standard measure of the figure or space formed by the junction of two lines or planes.&quot; [Wikipedia:Wikipedia]</rdfs:comment>
        <rdfs:label>angle unit</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0000122 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0000122">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_0000121"/>
        <rdfs:comment>&quot;A unit which is a standard measure of the angle formed by two straight lines in the same plane.&quot; [Wikipedia:Wikipedia]</rdfs:comment>
        <rdfs:label>plane angle unit</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0000123 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0000123">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_1000123"/>
        <rdfs:comment>&quot;A plane angle unit which is equal to the angle subtended at the center of a circle by an arc equal in length to the radius of the circle, approximately 57 degrees 17 minutes and 44.6 seconds.&quot; [NIST:NIST]</rdfs:comment>
        <rdfs:label>radian</rdfs:label>
        <oboInOwl1:hasExactSynonym>rad</oboInOwl1:hasExactSynonym>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0000124 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0000124">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_0000121"/>
        <rdfs:comment>&quot;A unit which is a standard measure of the angle formed by three or more planes intersecting at a common point.&quot; [Wikipedia:Wikipedia]</rdfs:comment>
        <rdfs:label>solid angle unit</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0000125 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0000125">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_1000125"/>
        <rdfs:comment>&quot;A solid angle unit which is equal to the solid angle subtended at the center of a sphere by an area on the surface of the sphere that is equal to the radius squared.&quot; [NIST:NIST]</rdfs:comment>
        <rdfs:label>steradian</rdfs:label>
        <oboInOwl1:hasExactSynonym>sr</oboInOwl1:hasExactSynonym>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0000127 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0000127">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000003"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_0000046"/>
        <obo:IAO_0000115>A derived unit which is a standard measure of the amount of radiation emitted by a given radiation source as well as the amount of radiation absorbed or deposited in a specific material by a radiation source.</obo:IAO_0000115>
        <obo:IAO_0000115>A unit which is a standard measure of the amount of radiation emitted by a given radiation source as well as the amount of radiation absorbed or deposited in a specific material by a radiation source.</obo:IAO_0000115>
        <rdfs:comment>&quot;A unit which is a standard measure of the amount of radiation emitted by a given radiation source as well as the amount of radiation absorbed or deposited in a specific material by a radiation source.&quot; [OCRBS:OCRBS]</rdfs:comment>
        <rdfs:label>radiation unit</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0000128 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0000128">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_0000127"/>
        <rdfs:comment>&quot;A unit which is a standard measure of the transformation (disintegration) rate of a radioactive substance.&quot; [DEFRA:DEFRA]</rdfs:comment>
        <rdfs:label>activity (of a radionuclide) unit</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0000129 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0000129">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_0000127"/>
        <obo:IAO_0000115>A derived unit which is a standard measure of the energy imparted by ionizing radiation to unit mass of matter such as tissue.</obo:IAO_0000115>
        <obo:IAO_0000115>A unit which is a standard measure of the energy imparted by ionizing radiation to unit mass of matter such as tissue.</obo:IAO_0000115>
        <rdfs:comment>&quot;A unit which is a standard measure of the energy imparted by ionizing radiation to unit mass of matter such as tissue.&quot; [DEFRA:DEFRA]</rdfs:comment>
        <rdfs:label>absorbed dose unit</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0000130 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0000130">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_0000127"/>
        <rdfs:comment>&quot;A unit which is a standard measure of the expression of dose in terms of its biological effect.&quot; [ORCBS:ORCBS]</rdfs:comment>
        <rdfs:label>dose equivalent unit</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0000131 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0000131">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_0000127"/>
        <rdfs:comment>&quot;A unit which is a standard measure of the quantity that expresses the ability of radiation to ionize air and thereby create electric charges which can be collected and measured.&quot; [ORCBS:ORCBS]</rdfs:comment>
        <rdfs:label>exposure unit</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0000132 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0000132">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_1000132"/>
        <rdfs:comment>&quot;An activity (of a radionuclide) unit which is equal to the activity of a quantity of radioactive material in which one nucleus decays per second or there is one atom disintegration per second (dps).&quot; [NIST:NIST]</rdfs:comment>
        <rdfs:label>becquerel</rdfs:label>
        <oboInOwl1:hasExactSynonym>Bq</oboInOwl1:hasExactSynonym>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0000133 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0000133">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_1000133"/>
        <rdfs:comment>&quot;An activity (of a radionuclide) unit which is equal to the activity of a quantity of radioactive material in which there are 3.7 x 10^[10] atom disintegration per second (dps).&quot; [ORCBS:ORCBS]</rdfs:comment>
        <rdfs:label>curie</rdfs:label>
        <oboInOwl1:hasExactSynonym>Ci</oboInOwl1:hasExactSynonym>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0000134 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0000134">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_1000134"/>
        <rdfs:comment>&quot;An absorbed dose unit which is equal to the absorption of one joule of radiation energy by one kilogram of matter.&quot; [NIST:NIST]</rdfs:comment>
        <rdfs:label>gray</rdfs:label>
        <oboInOwl1:hasExactSynonym>Gy</oboInOwl1:hasExactSynonym>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0000135 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0000135">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_1000135"/>
        <rdfs:comment>&quot;An absorbed dose unit which is equal to 0.01 gray (Gy).&quot; [Wikipedia:Wikipedia]</rdfs:comment>
        <rdfs:label>rad</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0000136 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0000136">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_1000136"/>
        <rdfs:comment>&quot;An exposure unit which is equal to the amount of radiation required to liberate positive and negative charges of one electrostatic unit of charge in 1 cm^[3] of air at standard temperature and pressure (STP). This corresponds to the generation of approximately 2.0810^[9] ion pairs.&quot; [Wikipedia:Wikipedia]</rdfs:comment>
        <rdfs:label>roentgen</rdfs:label>
        <oboInOwl1:hasExactSynonym>R</oboInOwl1:hasExactSynonym>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0000137 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0000137">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_1000137"/>
        <rdfs:comment>&quot;A dose equivalent unit which is equal to the absorption of one joule of radiation energy by one kilogram of matter.&quot; [NIST:NIST]</rdfs:comment>
        <rdfs:label>sievert</rdfs:label>
        <oboInOwl1:hasExactSynonym>Sv</oboInOwl1:hasExactSynonym>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0000138 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0000138">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
