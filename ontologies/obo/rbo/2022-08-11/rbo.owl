        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_00002264"/>
        <obo:IAO_0000115>Industrial wastes are liquid, solid and gaseous wastes originating from the manufacture of specific products.</obo:IAO_0000115>
        <obo:IAO_0000116>This will become a defined class, with subclasses added through inference based on material having a &apos;waste role&apos; and being associated with industrial entities.</obo:IAO_0000116>
        <oboInOwl:hasBroadSynonym>industrial waste</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasOBONamespace>ENVO</oboInOwl:hasOBONamespace>
        <oboInOwl:id>ENVO:00002267</oboInOwl:id>
        <rdfs:label>industrial waste material</rdfs:label>
    </owl:Class>
