    <!-- http://purl.obolibrary.org/obo/RBO_00000041 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/RBO_00000041">
        <rdf:type rdf:resource="http://purl.obolibrary.org/obo/RBO_00000045"/>
        <obo:IAO_0000111 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">JEM</obo:IAO_0000111>
        <obo:IAO_0000112 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The experiment was conducted on the Japanese Experiment Module</obo:IAO_0000112>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A Japanese science module for the International Space Station developed by JAXA. It is the largest single ISS module, and is attached to the Harmony module. The first two pieces of the module were launched on Space Shuttle missions STS-123 and STS-124.</obo:IAO_0000115>
        <obo:IAO_0000119 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Wikipedia</obo:IAO_0000119>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">JEM|Kibo</oboInOwl:hasExactSynonym>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ISS-Japanese Experiment Module</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/RBO_00000042 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/RBO_00000042">
        <rdf:type rdf:resource="http://purl.obolibrary.org/obo/RBO_00000045"/>
        <obo:IAO_0000111 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Columbus</obo:IAO_0000111>
        <obo:IAO_0000112 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The experiment was conducted on the Columbus module on the ISS</obo:IAO_0000112>
