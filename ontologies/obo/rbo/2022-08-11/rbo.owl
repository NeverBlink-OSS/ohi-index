    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_01001684">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_01000281"/>
        <obo:IAO_0000115 xml:lang="en">A layer which separates two portions of environmental material which possess 1) differing compositions, 2) a discontinuity of some property, or 3) some derivative of some property in a direction normal to the interface.</obo:IAO_0000115>
