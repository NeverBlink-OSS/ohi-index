        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CL_0002371"/>
        <obo:IAO_0000115>An endothelial progenitor cell that participates in angiogenesis during development.</obo:IAO_0000115>
        <oboInOwl:created_by>tmeehan</oboInOwl:created_by>
        <oboInOwl:creation_date>2011-02-28T04:20:39Z</oboInOwl:creation_date>
        <oboInOwl:hasOBONamespace>cell</oboInOwl:hasOBONamespace>
        <oboInOwl:id>CL:0002546</oboInOwl:id>
        <rdfs:comment>See CL:0002619.</rdfs:comment>
        <rdfs:label>embryonic blood vessel endothelial progenitor cell</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CL_0002672 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CL_0002672">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CL_0000048"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001062"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002202"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/CL_0000133"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A multi-fate stem cell that can give rise to different retinal cell types including rod and cone cells.</obo:IAO_0000115>
        <oboInOwl:created_by>tmeehan</oboInOwl:created_by>
        <oboInOwl:creation_date>2011-08-16T02:38:01Z</oboInOwl:creation_date>
        <oboInOwl:hasOBONamespace>cell</oboInOwl:hasOBONamespace>
        <oboInOwl:id>CL:0002672</oboInOwl:id>
        <rdfs:label>retinal progenitor cell</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CL_0002676 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CL_0002676">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CL_0000031"/>
