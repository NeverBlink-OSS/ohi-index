            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>&quot;An electric potential difference unit which is equal to one thousand volts or 10^[3] V.&quot; [UOC:GVG]</rdfs:comment>
        <rdfs:label>kilovolt</rdfs:label>
        <oboInOwl1:hasExactSynonym>kV</oboInOwl1:hasExactSynonym>
