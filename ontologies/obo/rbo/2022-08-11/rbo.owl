            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>&quot;A dose equivalent unit which is equal to one thousandth of a sievert or 10^[-3] Sv.&quot; [NIST:NIST]</rdfs:comment>
        <rdfs:label>millisievert</rdfs:label>
        <oboInOwl1:hasExactSynonym>mSv</oboInOwl1:hasExactSynonym>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0000139 -->

