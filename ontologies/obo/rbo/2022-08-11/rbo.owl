        <oboInOwl:hasDbXref>UMLS:C0226532</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>face vein</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>vein of face</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>uberon</oboInOwl:hasOBONamespace>
        <oboInOwl:hasRelatedSynonym>anterior facial vein</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>vena facialis anterior</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>UBERON:0001653</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#uberon_slim"/>
