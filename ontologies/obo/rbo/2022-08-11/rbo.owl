                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UO_0000297"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>&quot;An electric potential difference unit which is equal to one thousandth of a volt or 10^[-3] V.&quot; [UOC:GVG]</rdfs:comment>
        <rdfs:label>millivolt</rdfs:label>
        <oboInOwl1:hasExactSynonym>mV</oboInOwl1:hasExactSynonym>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0000248 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0000248">
