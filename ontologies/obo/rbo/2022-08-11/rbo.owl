        <oboInOwl:hasDbXref>XAO:0000028</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ZFA:0000105</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>vertebrate epidermis</oboInOwl:hasExactSynonym>
