        <oboInOwl:hasRelatedSynonym>4th branchial arch artery</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>4th pharyngeal arch artery</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>systemic arch</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>UBERON:0003121</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#pheno_slim"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#vertebrate_core"/>
        <rdfs:comment>proximal right subclavian</rdfs:comment>
        <rdfs:label>pharyngeal arch artery 4</rdfs:label>
    </owl:Class>
