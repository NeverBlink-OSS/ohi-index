        <oboInOwl:hasDbXref>OpenCyc:Mx4rwVFqO5wpEbGdrcN5Y29ycA</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS:C0003956</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>ascending thoracic aorta</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>pars ascendens aortae</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>uberon</oboInOwl:hasOBONamespace>
        <oboInOwl:hasRelatedSynonym>aorta ascendens</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>pars ascendens aortae</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>UBERON:0001496</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#pheno_slim"/>
