    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UBERON_0007832"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/UBPROP_0000001"/>
        <owl:annotatedTarget>Anatomical cluster by which the hind limbs are supported and attached to the vertebral column.[AAO]</owl:annotatedTarget>
        <oboInOwl:date_retrieved rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2012-06-20</oboInOwl:date_retrieved>
        <oboInOwl:external_class>AAO:0000426</oboInOwl:external_class>
        <oboInOwl:ontology rdf:datatype="http://www.w3.org/2001/XMLSchema#string">AAO</oboInOwl:ontology>
        <oboInOwl:source rdf:datatype="http://www.w3.org/2001/XMLSchema#string">AAO:LAP</oboInOwl:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UBERON_0007832"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/UBPROP_0000001"/>
        <owl:annotatedTarget>Anatomical cluster that consists of the paired basipterygia which support the pelvic fin.[TAO]</owl:annotatedTarget>
        <oboInOwl:date_retrieved rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2012-08-14</oboInOwl:date_retrieved>
        <oboInOwl:external_class>TAO:0000565</oboInOwl:external_class>
        <oboInOwl:ontology rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TAO</oboInOwl:ontology>
        <oboInOwl:source rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TAO:wd</oboInOwl:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UBERON_0007832"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/UBPROP_0000001"/>
        <owl:annotatedTarget>Girdle skeleton consisting of a set of bones linking the axial series to the hindlimb/fin skeleton and offering anchoring areas for hindlimb/fin and caudal musculature.[VSAO]</owl:annotatedTarget>
        <oboInOwl:date_retrieved rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2012-08-14</oboInOwl:date_retrieved>
        <oboInOwl:external_class>VSAO:0000155</oboInOwl:external_class>
        <oboInOwl:ontology rdf:datatype="http://www.w3.org/2001/XMLSchema#string">VSAO</oboInOwl:ontology>
        <oboInOwl:source rdf:resource="https://orcid.org/0000-0002-6601-2165"/>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UBERON_0007832"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/UBPROP_0000003"/>
        <owl:annotatedTarget>The pelvic girdle is never joined by contributions of dermal bone. From its first appearance in placoderms, the pelvic girdle is exclusively endoskeletal. It arose from pterygiophores, perhaps several times, in support of the fin.[well established][VHOG]</owl:annotatedTarget>
        <oboInOwl:date_retrieved rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2012-09-17</oboInOwl:date_retrieved>
        <oboInOwl:external_class>VHOG:0000305</oboInOwl:external_class>
        <oboInOwl:ontology rdf:datatype="http://www.w3.org/2001/XMLSchema#string">VHOG</oboInOwl:ontology>
        <oboInOwl:source rdf:resource="http://bgee.unil.ch/"/>
        <oboInOwl:source>ISBN:978-0072528305 Kardong KV, Vertebrates: Comparative Anatomy, Function, Evolution (2006) p.333</oboInOwl:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UBERON_0007832"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/UBPROP_0000012"/>
        <owl:annotatedTarget>Note that the VSAO and many ontologies use the label &apos;pelvic girdle&apos; to denote the skeletal region specifically. We place the EHDAA2 class here, note that this includes the pre-cartilage condensation as parts</owl:annotatedTarget>
        <oboInOwl:external_ontology rdf:datatype="http://www.w3.org/2001/XMLSchema#string">VSAO</oboInOwl:external_ontology>
    </owl:Axiom>
