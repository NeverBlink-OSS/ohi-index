        <obo:GENEPIO_0000004>Stx toxin type</obo:GENEPIO_0000004>
        <obo:GENEPIO_0000005>metadata feedback</obo:GENEPIO_0000005>
        <obo:IAO_0000112>Stx1 or Stx2</obo:IAO_0000112>
        <obo:IAO_0000115>A pathogenic shiga toxin produced by STEC E. coli.</obo:IAO_0000115>
        <obo:IAO_0000119>GROUP: IRIDA Ontology (Emma)</obo:IAO_0000119>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/genepio/core_slim.owl"/>
        <rdfs:label xml:lang="en">Stx toxin type datum</rdfs:label>
    </owl:Class>
    


