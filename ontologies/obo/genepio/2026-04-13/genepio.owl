        <rdfs:label xml:lang="en">draft IRIDA standard</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/GENEPIO_0001830 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GENEPIO_0001830">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NCIT_C103180"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000120"/>
        <obo:IAO_0000115 xml:lang="en">ISO 3166-1 is part of the ISO 3166 standard published by the International Organization for Standardization (ISO), and defines codes for the names of countries, dependent territories, and special areas of geographical interest.</obo:IAO_0000115>
        <obo:IAO_0000117>Damion Dooley</obo:IAO_0000117>
        <obo:IAO_0000119 rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://en.wikipedia.org/wiki/ISO_3166-2</obo:IAO_0000119>
        <rdfs:label xml:lang="en">ISO3166-1</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/GENEPIO_0001831 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GENEPIO_0001831">
