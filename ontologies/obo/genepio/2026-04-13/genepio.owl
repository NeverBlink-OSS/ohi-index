        <oboInOwl:hasExactSynonym>STEMI</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>acute-ST segment elevation myocardial infarction</oboInOwl:hasExactSynonym>
        <rdfs:label>ST-elevation myocardial infarction</rdfs:label>
    </owl:Class>
    


