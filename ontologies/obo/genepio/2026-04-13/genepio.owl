    <!-- http://purl.obolibrary.org/obo/GENEPIO_0100279 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GENEPIO_0100279">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GENEPIO_0100293"/>
        <obo:IAO_0000114>requires discussion</obo:IAO_0000114>
        <obo:IAO_0000115 xml:lang="en">A variant designation which is 1) a variant of the Severe Acute Respiratory Syndrome Coronavirus 2 (SARS-CoV-2), 2) containing genetic mutates that may increase binding affinity to human cells, 3) linked to rapid spread in human populations, 4) is being monitored, and 5) denoted as a lower risk than a Variant of Interest (VOI).</obo:IAO_0000115>
        <obo:IAO_0000118 xml:lang="en">Variant Under Monitoring (VUM)</obo:IAO_0000118>
        <dcterms:contributor rdf:resource="https://orcid.org/0000-0002-1107-9135"/>
        <dcterms:contributor rdf:resource="https://orcid.org/0000-0002-8844-9165"/>
        <dcterms:contributor rdf:resource="https://orcid.org/0000-0002-9578-0788"/>
        <dcterms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2022-01-19T18:23:15.862Z</dcterms:date>
        <oboInOwl:hasExactSynonym xml:lang="en">VBM</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">VUM</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Variant Being Monitored</oboInOwl:hasExactSynonym>
        <rdfs:comment xml:lang="en">PHA4GE Definition: A category used for indicating that a variant of the Severe Acute Respiratory Syndrome Coronavirus 2 (SARS-CoV-2) containing genetic mutations that may increase binding affinity to human cells and linked to rapid spread in human populations is being monitored. This category denotes less risk than a Variant of Interest (VOI).</rdfs:comment>
        <rdfs:label xml:lang="en">variant under monitoring (SARS-CoV-2)</rdfs:label>
    </owl:Class>
    


