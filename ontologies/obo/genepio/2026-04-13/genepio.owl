    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UBERON_0010363 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0010363">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0004765"/>
        <obo:IAO_0000115>A skeletal element that has the potential to participate in endochondral ossification, and may participate in intramembranous ossification.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/uberon.owl"/>
