                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://purl.obolibrary.org/obo/GENEPIO_0001919"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000428"/>
        <obo:IAO_0000117>Damion Dooley</obo:IAO_0000117>
        <rdfs:comment xml:lang="en">This should cover all interval data</rdfs:comment>
        <rdfs:label xml:lang="en">1D coordinate</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/GENEPIO_0001861 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GENEPIO_0001861">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GENEPIO_0001858"/>
        <rdfs:subClassOf>
