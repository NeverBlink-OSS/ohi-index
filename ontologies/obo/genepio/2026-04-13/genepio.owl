        <oboInOwl:hasExactSynonym>Embryonic Structure or System</oboInOwl:hasExactSynonym>
        <rdfs:label>Embryonic Structure or System</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C3426 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NCIT_C3426">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NCIT_C3671"/>
        <obo:IAO_0000115>A circumscribed inflammatory and often suppurating lesion on the skin or an internal mucous surface resulting in necrosis of tissue.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/ncit.owl"/>
        <oboInOwl:hasExactSynonym>ULCER</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Ulcer</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Ulcerated</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Ulceration</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Ulcerative</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Ulcers</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>ulcer</oboInOwl:hasExactSynonym>
        <rdfs:label>Ulcer</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C3430 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NCIT_C3430">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NCIT_C156660"/>
        <obo:IAO_0000115>A non-neoplastic or neoplastic disorder affecting the urinary system.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/ncit.owl"/>
        <oboInOwl:hasExactSynonym>Disorder of Urinary System</oboInOwl:hasExactSynonym>
