        <oboInOwl:hasExactSynonym xml:lang="en">prior Monkeypox antiviral treatment slot</oboInOwl:hasExactSynonym>
        <rdfs:comment xml:lang="en">PCDS: If known, provide information about whether the individual had a previous Mpox antiviral treatment. Select a value from the pick list.</rdfs:comment>
        <rdfs:label xml:lang="en">prior mpox antiviral treatment</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/GENEPIO_0100535 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GENEPIO_0100535">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GENEPIO_0102273"/>
        <obo:GENEPIO_0000162 xml:lang="en">PCDS: Antiviral treatment for any infection during the prior Mpox infection period.</obo:GENEPIO_0000162>
        <obo:IAO_0000112>PCDS: AZT was administered for HIV infection during the prior Mpox infection.</obo:IAO_0000112>
        <obo:IAO_0000114>metadata incomplete</obo:IAO_0000114>
        <obo:IAO_0000115 xml:lang="en">A data field which describes the antiviral treatment for any infection during the prior Moneypox infection period.</obo:IAO_0000115>
        <obo:IAO_0000118 xml:lang="en">PCDS:prior_antiviral_treatment_during_prior_mpox_infection</obo:IAO_0000118>
        <dcterms:contributor rdf:resource="https://orcid.org/0000-0002-1107-9135"/>
        <dcterms:contributor rdf:resource="https://orcid.org/0000-0002-8844-9165"/>
        <dcterms:contributor rdf:resource="https://orcid.org/0000-0002-9578-0788"/>
        <dcterms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-04-24T00:42:14Z</dcterms:date>
        <oboInOwl:hasBroadSynonym xml:lang="en">prior antiviral treatment during prior Monkeypox infection</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">prior antiviral treatment during prior Monkeypox infection slot</oboInOwl:hasExactSynonym>
        <rdfs:comment xml:lang="en">PCDS: Provide a description of any antiviral treatment administered for viral infections (not including Mpox treatment) during the prior Mpox infection period. This field is meant to capture concurrent treatment information.</rdfs:comment>
        <rdfs:label xml:lang="en">prior antiviral treatment during prior mpox infection</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/GENEPIO_0100548 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GENEPIO_0100548">
