        <obo:IAO_0000412 rdf:resource="http://www.ebi.ac.uk/efo/efo.owl"/>
        <oboInOwl:hasExactSynonym>clinical event</oboInOwl:hasExactSynonym>
        <rdfs:label>clinical temporal measurement</rdfs:label>
    </owl:Class>
    


