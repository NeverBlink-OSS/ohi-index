        <obo:OBI_0001886>Specimen ID</obo:OBI_0001886>
        <oboInOwl:hasSynonym xml:lang="en">sample identifier</oboInOwl:hasSynonym>
        <rdfs:label xml:lang="en">specimen identifier</rdfs:label>
