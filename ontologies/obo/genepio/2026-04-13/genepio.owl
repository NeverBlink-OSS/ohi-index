        <rdfs:label>superficial intraparotid lymph node</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UBERON_0015926 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0015926">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0015870"/>
