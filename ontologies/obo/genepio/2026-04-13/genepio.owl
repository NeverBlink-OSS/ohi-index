        <rdfs:label xml:lang="en">counting</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/APOLLO_SV_00000056 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/APOLLO_SV_00000056">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/APOLLO_SV_00000153"/>
        <obo:IAO_0000117 xml:lang="en">Mathias Brochhausen</obo:IAO_0000117>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/apollo_sv.owl"/>
        <rdfs:comment xml:lang="en">Motivating use case is to cover Synthia data, and possibly configuration/output of the MRSA simulator in the MIDAS community (CA-MRSA Repast).</rdfs:comment>
