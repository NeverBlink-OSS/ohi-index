        <oboInOwl:hasDbXref>http://www.langual.org/langual_thesaurus.asp?termid=H0141</oboInOwl:hasDbXref>
        <rdfs:label xml:lang="en">food modification process</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_03460144 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_03460144">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_03460159"/>
        <obo:IAO_0000115 xml:lang="en">A claim that sodium has been added to an edible product.</obo:IAO_0000115>
