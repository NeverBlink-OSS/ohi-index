        <oboInOwl:hasDbXref>UMLS:C0587955</oboInOwl:hasDbXref>
        <rdfs:label>Abnormal urine cytology</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/HP_0012622 -->

