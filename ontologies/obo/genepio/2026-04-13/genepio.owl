        <oboInOwl:hasExactSynonym>ng/ul</oboInOwl:hasExactSynonym>
        <rdfs:label>nanogram per microliter</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/UO_0010053">
        <obo:IAO_0000115>A unit of mass concentration defined as the number of micrograms of a substance per 250 ml Wheaton bottle.</obo:IAO_0000115>
