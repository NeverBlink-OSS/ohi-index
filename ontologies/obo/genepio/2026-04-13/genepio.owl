        <obo:IAO_0000115>A non-neoplastic disorder that affects the gastrointestinal tract, anus, liver, biliary system, and pancreas. Representative examples include infections, ulcers, cirrhosis, and diverticulosis.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/ncit.owl"/>
