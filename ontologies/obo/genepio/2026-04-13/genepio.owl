        <oboInOwl:hasDbXref>Wikipedia:Synovial_bursa</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>galen:Bursa</oboInOwl:hasDbXref>
        <rdfs:label>synovial bursa</rdfs:label>
    </owl:Class>
    


