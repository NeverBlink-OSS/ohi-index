        <oboInOwl:hasExactSynonym>Pharmaceutical Agent</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Pharmaceuticals</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Pharmacologic Agent</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Pharmacologic Substance</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Pharmacological Substance</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Therapeutic Agent</oboInOwl:hasExactSynonym>
