        <obo:IAO_0000117>Damion Dooley</obo:IAO_0000117>
        <rdfs:label xml:lang="en">exposure to individual with diarrhea</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/GENEPIO_0001554 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GENEPIO_0001554">
