        <oboInOwl:hasDbXref>GAID:252</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MESH:D002061</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>NCIT:C33717</oboInOwl:hasDbXref>
