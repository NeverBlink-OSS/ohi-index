        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_03501108"/>
        <obo:IAO_0000115 xml:lang="en">A passenger train which runs along an undergroud rail system.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/envo.owl"/>
        <oboInOwl:hasExactSynonym xml:lang="en">subway</oboInOwl:hasExactSynonym>
