    <!-- http://purl.obolibrary.org/obo/GENEPIO_0005677 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GENEPIO_0005677">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GENEPIO_0102280"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000577"/>
        <obo:GENEPIO_0000162 xml:lang="en">PCDS: A non-unique string identifier assigned to a sample or specimen by a laboratory group within the Public Health Agency of Canada’s National Microbiology Laboratory (NML).</obo:GENEPIO_0000162>
        <obo:IAO_0000112>PCDS: 24-001237</obo:IAO_0000112>
        <obo:IAO_0000114>pending final vetting</obo:IAO_0000114>
        <obo:IAO_0000115 xml:lang="en">A data field which describes a string identifier assigned to a sample or specimen by a laboratory group within the Public Health Agency of Canada’s National Microbiology Laboratory (NML).</obo:IAO_0000115>
        <obo:IAO_0000116>These metadata fields are defined specifically to describe Public Health Agency of Canada’s (PHAC) National Microbiology Laboratory (NML) data fields. They are organizational constructs intended to support a particular template and underlying database and should not be reused to model metadata outside the intended context. Where possible, more general, template‑independent terms should be used instead.</obo:IAO_0000116>
        <obo:IAO_0000118 xml:lang="en">PCDS:nml_lab number</obo:IAO_0000118>
        <obo:IAO_0000233 rdf:resource="https://github.com/GenEpiO/genepio/issues/111"/>
        <dcterms:contributor rdf:resource="http://purl.obolibrary.org/obo/genepio/components/specification.owl#NMLB-DOT"/>
        <dcterms:contributor rdf:resource="https://orcid.org/0000-0001-5275-8866"/>
        <dcterms:contributor rdf:resource="https://orcid.org/0000-0002-1107-9135"/>
        <dcterms:contributor rdf:resource="https://orcid.org/0000-0002-9578-0788"/>
        <dcterms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-03-06T11:22:46Z</dcterms:date>
        <oboInOwl:hasBroadSynonym xml:lang="en">NML lab number</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasBroadSynonym xml:lang="en">National Microbiology Laboratory lab number</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasBroadSynonym xml:lang="en">PHAC NML lab number</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasBroadSynonym xml:lang="en">Public Health Agency of Canada National Microbiology Laboratory lab number</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">NML lab number slot</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">NML lab sample number field</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">National Microbiology Laboratory lab number field</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">National Microbiology Laboratory lab number slot</oboInOwl:hasExactSynonym>
        <rdfs:comment xml:lang="en">PCDS: Enter the NML lab number exactly as generated and assigned by the NML Branch of the Public Health Agency of Canada. This identifier is used for internal tracking and linkage of specimens within NML laboratory workflows. Do not alter the formatting or substitute identifiers from other systems or organizations.</rdfs:comment>
        <rdfs:label xml:lang="en">NML lab sample ID</rdfs:label>
        <rdfs:seeAlso>https://www.canada.ca/en/public-health/programs/national-microbiology-laboratory.html</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/GENEPIO_0005678 -->

