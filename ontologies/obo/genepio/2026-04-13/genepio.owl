    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/GENEPIO_0000102 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GENEPIO_0000102">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GENEPIO_0001659"/>
