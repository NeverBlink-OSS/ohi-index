        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_00002679"/>
        <obo:IAO_0000115 xml:lang="en">A herring fillet is a fillet cut of herring</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/foodon.owl"/>
        <rdfs:label xml:lang="en">herring fillet</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_00002742 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_00002742">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_00002320"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_00002679"/>
        <obo:IAO_0000115 xml:lang="en">A fillet cut of a tuna fish.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/foodon.owl"/>
        <rdfs:label xml:lang="en">tuna fillet</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_00002882 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_00002882">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_00001041"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_00004478"/>
        <obo:IAO_0000115 xml:lang="en">A beef cut that is derived from the 6th, 7th and 8th rib of the rib primal.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/foodon.owl"/>
        <rdfs:label xml:lang="en">beef short rib</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_00002886 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_00002886">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_03510115"/>
        <obo:IAO_0000115 xml:lang="en">Synbiotic claim refers to food ingredients or dietary supplements combining probiotics and prebiotics in a form of synergism that beneficially affect the host.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/foodon.owl"/>
        <rdfs:label xml:lang="en">synbiotic claim</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_00002954 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_00002954">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_00001041"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_00004477"/>
        <obo:IAO_0000115 xml:lang="en">A cut of beef from the primal rib, one of the nine primal cuts of beef. While the entire rib section comprises ribs six through 12, a standing rib roast may contain anywhere from two to seven ribs.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/foodon.owl"/>
        <rdfs:label xml:lang="en">beef prime rib roast</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_00002986 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_00002986">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_03308311"/>
        <obo:IAO_0000115 xml:lang="en">A fish steak, alternatively known as a fish cutlet, is a cut of fish which is cut perpendicular to the spine and can either include the bones or be boneless.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/foodon.owl"/>
        <rdfs:label xml:lang="en">fish steak</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_00003001 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_00003001">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_03530146"/>
        <obo:IAO_0000115 xml:lang="en">A thin slice of meat from the leg or ribs of veal, pork, chicken, or mutton.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/foodon.owl"/>
        <rdfs:label xml:lang="en">cutlet</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_00003004 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_00003004">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/COB_0000022"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_03420164"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000468"/>
        <obo:IAO_0000115 xml:lang="en">A whole animal.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/foodon.owl"/>
        <oboInOwl:hasDbXref rdf:resource="http://www.langual.org/langual_thesaurus.asp?termid=B1297"/>
        <rdfs:label xml:lang="en">animal</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_00003029 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_00003029">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_00004478"/>
        <obo:IAO_0000115 xml:lang="en">A beef meat cut that has a flat-cut appearance.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/foodon.owl"/>
        <rdfs:label xml:lang="en">beef steak</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_00003301 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_00003301">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_00004470"/>
        <obo:IAO_0000115 xml:lang="en">A beef primal cut that comes from the area below the backbone .</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/foodon.owl"/>
        <rdfs:label xml:lang="en">beef loin</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_00003302 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_00003302">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_00003301"/>
        <obo:IAO_0000115 xml:lang="en">A cut of beef corresponding to the psoas major muscle, which is very tender.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/foodon.owl"/>
        <rdfs:label xml:lang="en">beef tenderloin</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_00003303 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_00003303">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_00003301"/>
        <obo:IAO_0000115 xml:lang="en">A boneless steak cut from the sirloin region</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/foodon.owl"/>
        <rdfs:label xml:lang="en">beef top loin steak</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_00003304 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_00003304">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_00003029"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_00003301"/>
        <obo:IAO_0000115 xml:lang="en">A beef steak that is prepared from the beef short loin. The maximum width of the tenderloin must be at least 1/2 inch (13mm) when measured parallel to the length of the backbone.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/foodon.owl"/>
        <rdfs:label xml:lang="en">beef T-bone steak</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_00003305 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_00003305">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_00003029"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_00003301"/>
        <obo:IAO_0000115 xml:lang="en">A beef steak that is prepared from the beef short loin. The maximum width of the tenderloin must be atleast 1.25 inches (3.2cm) when measured parallel to the length of the backbone.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/foodon.owl"/>
        <rdfs:label xml:lang="en">beef porterhouse steak</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_00003343 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_00003343">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_00004478"/>
        <obo:IAO_0000115 xml:lang="en">A steak cut of beef taken from the smaller end of the tenderloin, or psoas major of the cow carcass, usually a steer or heifer.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/foodon.owl"/>
        <rdfs:label xml:lang="en">filet mignon (North America)</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_00003344 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_00003344">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_02010016"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_02020368"/>
        <obo:IAO_0000115 xml:lang="en">A butchery cut of chicken that is typically boneless.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/foodon.owl"/>
        <rdfs:label xml:lang="en">chicken fillet</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_00003346 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_00003346">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_03530050"/>
        <obo:IAO_0000115 xml:lang="en">A fruit ripeness characteristic in which a fruit has surpassed ripeness and is undergoing decomposition.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/foodon.owl"/>
        <rdfs:label xml:lang="en">overripe</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_00003347 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_00003347">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_03530050"/>
        <obo:IAO_0000115 xml:lang="en">A fruit ripeness characteristic in which a fruit has some ripe part(s) or is about to achieve full maturity.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/foodon.owl"/>
        <rdfs:label xml:lang="en">slightly ripe</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_00003356 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_00003356">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_00002682"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_03311126"/>
        <obo:IAO_0000115 xml:lang="en">A pet food that has not been heat treated or otherwise preserved.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/foodon.owl"/>
        <rdfs:label xml:lang="en">pet food (raw)</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_00003357 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_00003357">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_00002682"/>
        <obo:IAO_0000115 xml:lang="en">A food item intended to provide pleasure or reward to an animal, and which might not be nutritious.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/foodon.owl"/>
        <rdfs:label xml:lang="en">pet treat</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_00003368 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_00003368">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000040"/>
        <obo:IAO_0000115 xml:lang="en">Food contact materials are materials that are intended to be in contact with food. These can be things that are quite obvious like a glass or a can for soft drinks as well as machinery in a food factory or a coffee machine.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/foodon.owl"/>
        <rdfs:label xml:lang="en">food contact material</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_00003387 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_00003387">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_03530211"/>
        <obo:IAO_0000115 xml:lang="en">Cultivation of plants within a polytunnel or similar tunnel.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/foodon.owl"/>
        <rdfs:label xml:lang="en">tunnel farming</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_00003388 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_00003388">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_03530154"/>
        <obo:IAO_0000115 xml:lang="en">The rearing of domesticated animals for food.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/foodon.owl"/>
        <rdfs:label xml:lang="en">food animal rearing</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_00003389 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_00003389">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_00003388"/>
        <obo:IAO_0000115 xml:lang="en">An approach to animal husbandry designed to maximize production, while minimizing costs by keeping livestock such as cattle, poultry, and fish at high stocking densities, at large scale, and using automated feeding systems.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/foodon.owl"/>
        <rdfs:label xml:lang="en">industrial livestock production</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_00003390 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_00003390">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_03530211"/>
        <obo:IAO_0000115 xml:lang="en">A technology-based approach toward food production that aims to provide optimal growing conditions throughout the development of a crop located within an enclosed growing structure such as a greenhouse or building.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/foodon.owl"/>
        <rdfs:label xml:lang="en">controlled environment agriculture (CEA) production</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_00003391 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_00003391">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_00003388"/>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/foodon.owl"/>
        <rdfs:label xml:lang="en">aquaculture production</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_00003392 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_00003392">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_00003391"/>
        <obo:IAO_0000115 xml:lang="en">Aquatic farmed food production located offshore, in coastal areas or in freshwater lakes, open-net pens, or “cages”, that allow for free exchange between the farm and the surrounding environment.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/foodon.owl"/>
        <rdfs:label xml:lang="en">aquaculture open-pen rearing</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_00003393 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_00003393">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_00003391"/>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/foodon.owl"/>
        <rdfs:label xml:lang="en">aquaculture closed containment pen rearing</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_00003594 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_00003594">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_03301077"/>
        <obo:IAO_0000115 xml:lang="en">The flesh of fish</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/foodon.owl"/>
        <rdfs:label xml:lang="en">fish meat</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_00003872 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_00003872">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_00001282"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_00004530"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_03530027"/>
        <obo:IAO_0000115 xml:lang="en">A meat made up from the beef cut is known as sirloin. Ground sirloin is ground sirloin meat.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/foodon.owl"/>
        <rdfs:label xml:lang="en">ground sirloin</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_00003912 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_00003912">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_03450006"/>
        <obo:IAO_0000115 xml:lang="en">A Japanese cooking method in which food is broiled or grilled with a glaze of soy sauce, mirin, and sugar.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/foodon.owl"/>
        <rdfs:label xml:lang="en">teriyaki cooking method</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_00003926 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_00003926">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_03530146"/>
        <obo:IAO_0000115 xml:lang="en">An animal meat (cut) and an output of simple random sampling.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/foodon.owl"/>
        <rdfs:label xml:lang="en">random sample animal meat cut</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_00004088 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_00004088">
