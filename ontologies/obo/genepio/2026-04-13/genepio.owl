        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/apollo_sv.owl"/>
        <rdfs:label xml:lang="en">count of simulated exposed population</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/APOLLO_SV_00000020 -->

