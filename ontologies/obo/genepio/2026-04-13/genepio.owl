        <oboInOwl:hasExactSynonym xml:lang="en">underground train</oboInOwl:hasExactSynonym>
        <oboInOwl:hasNarrowSynonym xml:lang="en">London Underground</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasNarrowSynonym xml:lang="en">SkyTrain</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasNarrowSynonym xml:lang="en">Tube</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasNarrowSynonym xml:lang="en">U-Bahn</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasNarrowSynonym xml:lang="en">Underground</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasNarrowSynonym xml:lang="en">metropolitana</oboInOwl:hasNarrowSynonym>
        <rdfs:label xml:lang="en">subway train</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ENVO_03501121 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_03501121">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_01000420"/>
        <obo:IAO_0000115 xml:lang="en">A building part which is a narrow hall or passage in a building with rooms leading off it.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/envo.owl"/>
        <oboInOwl:hasBroadSynonym xml:lang="en">hall</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasBroadSynonym xml:lang="en">passage</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">hallway</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">building corridor</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ENVO_03501127 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_03501127">
