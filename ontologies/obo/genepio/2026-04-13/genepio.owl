    <!-- http://purl.obolibrary.org/obo/GENEPIO_0002027 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GENEPIO_0002027">
        <obo:IAO_0000115 xml:lang="en">An ordinal variable is a categorical variable whose values have sequential order, but no distance metric between them.</obo:IAO_0000115>
        <obo:IAO_0000117>Damion Dooley</obo:IAO_0000117>
        <obo:IAO_0100001 rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://purl.obolibrary.org/obo/STATO_0000228</obo:IAO_0100001>
        <rdfs:label xml:lang="en">obsolete: ordinal variable</rdfs:label>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    </owl:Class>
    


