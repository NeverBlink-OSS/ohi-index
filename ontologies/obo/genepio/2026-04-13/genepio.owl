        <oboInOwl:hasExactSynonym>Non-Neoplastic Hematologic and Lymphoid Cell Disorder</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Non-Neoplastic Hematopoietic and Lymphoid Cell Disorder</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>nonmalignant hematologic disorder</oboInOwl:hasExactSynonym>
        <rdfs:label>Non-Neoplastic Hematopoietic and Lymphoid Cell Disorder</rdfs:label>
