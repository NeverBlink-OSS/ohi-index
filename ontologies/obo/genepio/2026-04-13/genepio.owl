        <rdfs:label xml:lang="en">environmental project relevance</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/GENEPIO_0001578 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GENEPIO_0001578">
