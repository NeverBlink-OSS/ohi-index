        <obo:IAO_0000115>An interaction between an exposure stressor and an exposure_receptor.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/ecto.owl"/>
        <rdfs:label>exposure event</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ExO_0000038 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ExO_0000038">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GENEPIO_0001170"/>
        <rdfs:subClassOf rdf:nodeID="genid40"/>
        <rdfs:subClassOf rdf:nodeID="genid42"/>
        <obo:GENEPIO_0001763>depth:1</obo:GENEPIO_0001763>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000428"/>
        <obo:IAO_0000115 xml:lang="en">The condition of an organism in all aspects (e.g., functional or metabolic efficiency).</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">See technical discussion about logic of assigning health status: 
https://www.w3.org/2001/sw/BestPractices/OEP/Lists-of-values-20040625/</obo:IAO_0000116>
        <obo:IAO_0000119 xml:lang="en">https://en.wikipedia.org/wiki/Medical_state</obo:IAO_0000119>
        <oboInOwl:created_by>cmattin</oboInOwl:created_by>
        <oboInOwl:hasExactSynonym xml:lang="en">condition</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">medical condition</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">medical state</oboInOwl:hasExactSynonym>
        <rdfs:comment xml:lang="en">Damion Dooley note: GenEpiO includes various health status descriptors here; many are annotated as included in the American AHA HIPPA or United Kingdom NHS terminologies.  The challenge is to map them or order them in such a way that merged data can be analyzed.</rdfs:comment>
        <rdfs:label xml:lang="en">subject health status</rdfs:label>
        <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://semanticscience.org/resource/SIO_010057</rdfs:seeAlso>
    </owl:Class>
    <owl:Restriction rdf:nodeID="genid40">
        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002350"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/GENEPIO_0001837"/>
    </owl:Restriction>
    <owl:Restriction rdf:nodeID="genid42">
        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002350"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/GENEPIO_0001845"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ExO_0000038"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#subClassOf"/>
        <owl:annotatedTarget rdf:nodeID="genid40"/>
        <rdfs:label xml:lang="en">Condition</rdfs:label>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ExO_0000038"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#subClassOf"/>
        <owl:annotatedTarget rdf:nodeID="genid42"/>
        <rdfs:label xml:lang="en">Condition</rdfs:label>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ExO_0000057 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ExO_0000057">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EPO_0000016"/>
        <obo:IAO_0000115 xml:lang="en">The process of drawing in by breathing.</obo:IAO_0000115>
        <obo:IAO_0000412 xml:lang="en">http://purl.obolibrary.org/obo/ExO_0000057</obo:IAO_0000412>
        <rdfs:label xml:lang="en">inhalation</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FIX_0000278 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FIX_0000278">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GENEPIO_0001626"/>
        <obo:IAO_0000115 xml:lang="en">Redox potential, measured relative to a hydrogen cell, indicating oxidation or reduction potential</obo:IAO_0000115>
        <obo:IAO_0000118>E&apos;</obo:IAO_0000118>
        <obo:IAO_0000118>oxidation-reduction potential</obo:IAO_0000118>
        <obo:IAO_0000119 xml:lang="en">MIxS</obo:IAO_0000119>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/fix.owl"/>
        <rdfs:label>redox potential</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FLU_0000976 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FLU_0000976">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GENEPIO_0001258"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000428"/>
        <obo:IAO_0000115 xml:lang="en">A symptom onset date is a date-time entity that marks the start of one or more reported symptoms pertaining to an episode of human or animal illness</obo:IAO_0000115>
        <obo:IAO_0000117>Damion Dooley</obo:IAO_0000117>
        <rdfs:label xml:lang="en">symptom onset date</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_00001002 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_00001002">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_03400361"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000428"/>
        <obo:IAO_0000115>A substance, usually composed primarily of carbohydrates, fats, water and/or proteins, that can be eaten or drunk by an animal or human being for nutrition or pleasure.</obo:IAO_0000115>
        <obo:IAO_0000115 xml:lang="en">Food material for humans and animals which is processed with the intention that it be consumable as a whole or added to other food products.</obo:IAO_0000115>
        <obo:IAO_0000117>Damion Dooley</obo:IAO_0000117>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/foodon.owl"/>
        <rdfs:label xml:lang="en">food product</rdfs:label>
        <rdfs:label xml:lang="en">foodon product type</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_00001006 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_00001006">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_00001092"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_00005501"/>
        <obo:IAO_0000115>A food product made of meat, the skeletal muscle and associated fat, and other edible tissues such as organs, livers, skin, brains, bone marrow, kidneys, or lungs, of mammals.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/foodon.owl"/>
        <oboInOwl:hasDbXref rdf:resource="https://bioregistry.io/reference/siren:F17332"/>
        <rdfs:label xml:lang="en">mammalian meat food product</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_00001015 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_00001015">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_00001002"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_00004331"/>
        <obo:IAO_0000115 xml:lang="en">A food product which has as a defining ingredient some plant material.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/foodon.owl"/>
        <rdfs:label xml:lang="en">plant food product</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_00001038 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_00001038">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_00002663"/>
        <obo:IAO_0000115 xml:lang="en">A food product made from domestic pig meat (Sus domesticus or Sus scrofa scrofa).</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/foodon.owl"/>
        <rdfs:label xml:lang="en">pork meat food product</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_00001040 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_00001040">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_00001131"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_02020149"/>
        <obo:IAO_0000115 xml:lang="en">A food product that is derived from some chicken meat.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/foodon.owl"/>
        <rdfs:label xml:lang="en">chicken meat food product</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_00001041 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_00001041">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_00001134"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_02020889"/>
        <obo:IAO_0000115 xml:lang="en">A food product that is derived from some cow.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/foodon.owl"/>
        <rdfs:label xml:lang="en">cow food product</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_00001049 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_00001049">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_00001038"/>
        <obo:IAO_0000115>A cut of meat (a meat chop) cut perpendicularly to the spine of the pig and usually containing a rib or part of a vertebra, served as an individual portion.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/foodon.owl"/>
        <rdfs:label xml:lang="en">pork chop food product</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_00001092 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_00001092">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_00004242"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_00005502"/>
        <obo:IAO_0000115 xml:lang="en">A food product which is derived from or produced by an animal that has a vertibrae.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/foodon.owl"/>
        <rdfs:label xml:lang="en">vertebrate food product</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_00001131 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_00001131">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_00001283"/>
        <obo:IAO_0000115 xml:lang="en">A food product made from domesticated bird meat.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/foodon.owl"/>
        <rdfs:label xml:lang="en">poultry meat food product</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_00001132 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_00001132">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_00001006"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_00005689"/>
        <obo:IAO_0000115 xml:lang="en">Suidae is a family of artiodactyl mammals which are commonly called pigs, hogs or boars. In addition to numerous fossil species, 17 extant species are currently recognized (or 18 counting domestic pigs and wild boars separately), classified into between four and eight genera. The family includes the domestic pig, Sus scrofa domesticus or Sus domesticus, in addition to numerous species of wild pig, such as babirusas and warthogs. All suids, or swine, are native to the Old World, ranging from Asia to Europe and Africa.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/foodon.owl"/>
        <rdfs:label xml:lang="en">swine food product</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_00001134 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_00001134">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_00001006"/>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/foodon.owl"/>
        <rdfs:label xml:lang="en">bovine meat food product</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_00001143 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_00001143">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_00001002"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_00004336"/>
        <obo:IAO_0000115 xml:lang="en">A food product consisting of an edible fungi or mushroom or yeast.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/foodon.owl"/>
        <rdfs:label xml:lang="en">fungus food product</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_00001145 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_00001145">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_00001002"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_03420116"/>
        <obo:IAO_0000115 xml:lang="en">Microbial material derived from one or more microorganisms including bacteria, mold, and yeast.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/foodon.owl"/>
        <rdfs:label xml:lang="en">microbial food material</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_00001176 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_00001176">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_00004242"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_00005522"/>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/foodon.owl"/>
        <rdfs:label xml:lang="en">invertebrate food product</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_00001180 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_00001180">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_03311737"/>
        <obo:IAO_0000115 xml:lang="en">Food product that is 1) ready or nearly ready for consumption; 2) usually a composite of several foods or ingredients that often belong to distinct product types; 3) usually formulated, mixed and partially or fully cooked.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/foodon.owl"/>
        <rdfs:label xml:lang="en">prepared food product</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_00001181 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_00001181">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_00002645"/>
        <obo:IAO_0000115 xml:lang="en">Food material which is cooked.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/foodon.owl"/>
        <rdfs:label xml:lang="en">food (cooked)</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_00001184 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_00001184">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_03420116"/>
        <obo:IAO_0000115 xml:lang="en">Material which derives from algae (including single-celled microalgae and  multicellular macroalgae).</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/foodon.owl"/>
        <oboInOwl:hasDbXref rdf:resource="https://bioregistry.io/reference/siren:F10419"/>
        <rdfs:label xml:lang="en">algae material</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_00001248 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_00001248">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_00001092"/>
        <obo:IAO_0000115 xml:lang="en">A fish food product includes products made from any fish species (aquatic vertebrate with gills and fins).</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/foodon.owl"/>
        <rdfs:label xml:lang="en">fish food product</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_00001251 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_00001251">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_00001092"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_02020050"/>
        <obo:IAO_0000115 xml:lang="en">A food product that is derived from some avian animal.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/foodon.owl"/>
        <rdfs:label xml:lang="en">avian food product</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_00001282 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_00001282">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_00001041"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_02000412"/>
        <obo:IAO_0000115 xml:lang="en">Beef that has been ground.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/foodon.owl"/>
        <rdfs:label xml:lang="en">beef (ground)</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_00001283 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_00001283">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_00001251"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_02020686"/>
        <obo:IAO_0000115 xml:lang="en">A food product that is derived from some poultry.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/foodon.owl"/>
        <rdfs:label xml:lang="en">poultry food product</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_00001286 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_00001286">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_00001131"/>
        <obo:IAO_0000115 xml:lang="en">A turkey meat food product is any food product made predominantly of turkey parts.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/foodon.owl"/>
        <rdfs:label xml:lang="en">turkey meat food product</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_00001304 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_00001304">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_03460119"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_03470107"/>
        <obo:IAO_0000115 xml:lang="en">A fermentation process in which either carbohydrates, proteins or fats are modified through microbial, enzymatic and/or other biological process.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/foodon.owl"/>
        <oboInOwl:hasDbXref rdf:resource="http://www.langual.org/langual_thesaurus.asp?termid=J0104"/>
        <rdfs:label xml:lang="en">food fermentation</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_00001567 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_00001567">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_03530146"/>
        <obo:IAO_0000115 xml:lang="en">A cut of meat that is initially separated from the carcass of an animal during butchering.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/foodon.owl"/>
        <rdfs:label xml:lang="en">animal primal cut</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_00001714 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_00001714">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_00002403"/>
        <obo:IAO_0000115 xml:lang="en">Food material which normally exists as an ingredient to another food material, rather than eaten on its own.  This includes chemical food components.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/foodon.owl"/>
        <rdfs:label xml:lang="en">food material component</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_00001820 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_00001820">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_00001248"/>
        <obo:IAO_0000115 xml:lang="en">A product deriving from mahi-mahi or common dolphinfish (Coryphaena hippurus) also widely called dorado and dolphin.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/foodon.owl"/>
        <rdfs:label xml:lang="en">dolphinfish food product</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_00001950 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_00001950">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_00001248"/>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/foodon.owl"/>
        <rdfs:label xml:lang="en">herring food product</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_00001992 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_00001992">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_00002236"/>
        <obo:IAO_0000115 xml:lang="en">Lamb meat food product is a meat product taken from a lamb, a sheep less than a year old.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/foodon.owl"/>
        <rdfs:label xml:lang="en">lamb meat food product</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_00002147 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_00002147">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_00002403"/>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/foodon.owl"/>
        <rdfs:label xml:lang="en">food material by consumer group</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_00002236 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_00002236">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_00001006"/>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/foodon.owl"/>
        <rdfs:label xml:lang="en">sheep meat food product</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_00002320 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_00002320">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_00001248"/>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/foodon.owl"/>
        <rdfs:label xml:lang="en">tuna food product</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_00002403 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_00002403">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_00010483"/>
        <obo:IAO_0000115 xml:lang="en">Any substance that can be consumed by an organism to satisfy nutritional or other health needs, or to provide a social or organoleptic food experience</obo:IAO_0000115>
        <obo:IAO_0000119 rdf:resource="https://en.wikipedia.org/wiki/Food"/>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/envo.owl"/>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/foodon.owl"/>
        <oboInOwl:hasExactSynonym xml:lang="en">food</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">foodstuff</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">nourishment</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">sustenance</oboInOwl:hasExactSynonym>
        <rdfs:comment xml:lang="en">This class is the top of FOODON&apos;s main food product hierarchy which is described in the https://www.foodon.org website, and can be searched in lookup services like https://www.ebi.ac.uk/ols/</rdfs:comment>
        <rdfs:label xml:lang="en">food material</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_00002404 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_00002404">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_03450005"/>
        <obo:IAO_0000115 xml:lang="en">Roasting is a baking process when the food being baked is meats</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/foodon.owl"/>
        <rdfs:label xml:lang="en">meat roasting</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_00002419 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_00002419">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_03460130"/>
        <obo:IAO_0000115 xml:lang="en">A food evaporation process is the process of removing water from a food.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/foodon.owl"/>
        <rdfs:label xml:lang="en">food evaporation process</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_00002451 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_00002451">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/COB_0000035"/>
        <obo:IAO_0000115 xml:lang="en">A process involving the physical transformation of a food source or food product into some derived organic material or food product</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/foodon.owl"/>
        <rdfs:label xml:lang="en">food transformation process</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_00002452 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_00002452">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_00003004"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_00005522"/>
        <obo:IAO_0000115 xml:lang="en">Invertebrates are animals that neither possess nor develop a vertebral column (commonly known as a backbone or spine), derived from the notochord. This includes all animals apart from the subphylum Vertebrata.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/foodon.owl"/>
        <rdfs:label xml:lang="en">invertebrate animal</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_00002454 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_00002454">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_00002403"/>
        <obo:IAO_0000115 xml:lang="en">Food material which has been categorized by a characteristic such as granularity or temperature.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/foodon.owl"/>
        <rdfs:label xml:lang="en">food material by characteristic</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_00002462 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_00002462">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_03450026"/>
        <obo:IAO_0000115 xml:lang="en">A form of frying characterized by the use of minimal cooking oil or fat (compared to shallow frying or deep frying); typically using just enough oil to lubricate the pan. A pan fry takes place at lower heat than does a sauté.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/foodon.owl"/>
        <rdfs:label xml:lang="en">shallow frying</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_00002470 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_00002470">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PATO_0001241"/>
        <obo:IAO_0000115 xml:lang="en">A physical object quality which describes a characteristic of some food material.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/foodon.owl"/>
        <rdfs:label xml:lang="en">food material characteristic</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_00002502 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_00002502">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_00001038"/>
        <obo:IAO_0000115 xml:lang="en">Ham is pork from a leg cut that has been preserved by wet or dry curing, with or without smoking.  As a processed meat, the term &quot;ham&quot; includes both whole cuts of meat and ones that have been mechanically formed.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/foodon.owl"/>
        <rdfs:label xml:lang="en">ham food product</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_00002570 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_00002570">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_00001038"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_00004483"/>
        <obo:IAO_0000115 xml:lang="en">A cut of meat from a pig, that comes from the tissue along the dorsal side of the rib cage.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/foodon.owl"/>
        <rdfs:label xml:lang="en">pork loin</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_00002572 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_00002572">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_00002574"/>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/foodon.owl"/>
        <rdfs:label xml:lang="en">cut of beef, british</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_00002573 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_00002573">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_00002572"/>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/foodon.owl"/>
        <rdfs:label xml:lang="en">beef rump cut (british)</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_00002574 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_00002574">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_02000403"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_03530146"/>
        <obo:IAO_0000115 xml:lang="en">A cut of beef that is a primal, sub-primal or retail cut.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/foodon.owl"/>
        <rdfs:label xml:lang="en">butchery cut of beef</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_00002645 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_00002645">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_00002403"/>
        <obo:IAO_0000115 xml:lang="en">Food material organized by the process which it results from.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/foodon.owl"/>
        <rdfs:label xml:lang="en">food material by process</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_00002648 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_00002648">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_03450002"/>
        <obo:IAO_0000115 xml:lang="en">A method of precooking food where a liquid is heated to just below the boiling point. Often used to retard the spoiling of milk.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/foodon.owl"/>
        <rdfs:label xml:lang="en">food scalding</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_00002663 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_00002663">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_00001132"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_02021649"/>
        <obo:IAO_0000115 xml:lang="en">A food product that is derived from some pig.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/foodon.owl"/>
        <rdfs:label xml:lang="en">pig food product</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_00002679 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_00002679">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_02010016"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_03308311"/>
        <obo:IAO_0000115 xml:lang="en">A fish fillet, from the French word filet meaning a thread or strip, is the flesh of a fish which has been cut or sliced away from the bone by cutting lengthwise along one side of the fish parallel to the backbone.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/foodon.owl"/>
        <rdfs:label xml:lang="en">fish fillet</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_00002680 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_00002680">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_00001820"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_00002679"/>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/foodon.owl"/>
        <rdfs:label xml:lang="en">mahi mahi fillet</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_00002682 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_00002682">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_03309997"/>
        <obo:IAO_0000115 xml:lang="en">Pet food is plant or animal material intended for consumption by pets.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/foodon.owl"/>
        <rdfs:label xml:lang="en">pet food</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_00002690 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_00002690">
