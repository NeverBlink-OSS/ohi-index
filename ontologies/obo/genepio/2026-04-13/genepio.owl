        <oboInOwl:hasDbXref rdf:resource="http://www.langual.org/langual_thesaurus.asp?termid=P0189"/>
        <rdfs:label xml:lang="en">infant as food consumer, 0 - 3 months</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_03510190 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_03510190">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_03510263"/>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/foodon.owl"/>
        <oboInOwl:hasDbXref rdf:resource="http://www.langual.org/langual_thesaurus.asp?termid=P0190"/>
        <rdfs:label xml:lang="en">infant as food consumer, 3 - 6 months</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_03510191 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_03510191">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_03510266"/>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/foodon.owl"/>
        <oboInOwl:hasDbXref rdf:resource="http://www.langual.org/langual_thesaurus.asp?termid=P0191"/>
        <rdfs:label xml:lang="en">infant as food consumer, 6 - 12 months</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_03510192 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_03510192">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_03510020"/>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/foodon.owl"/>
        <oboInOwl:hasDbXref rdf:resource="http://www.langual.org/langual_thesaurus.asp?termid=P0192"/>
        <rdfs:label xml:lang="en">toddler as food consumer, 12 months and onwards</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_03510193 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_03510193">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_03510115"/>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/foodon.owl"/>
        <oboInOwl:hasDbXref rdf:resource="http://www.langual.org/langual_thesaurus.asp?termid=P0193"/>
        <rdfs:label xml:lang="en">low alcohol claim</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_03510194 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_03510194">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_03510115"/>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/foodon.owl"/>
        <oboInOwl:hasDbXref rdf:resource="http://www.langual.org/langual_thesaurus.asp?termid=P0194"/>
        <rdfs:label xml:lang="en">probiotic claim</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_03510195 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_03510195">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_03510017"/>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/foodon.owl"/>
        <oboInOwl:hasDbXref rdf:resource="http://www.langual.org/langual_thesaurus.asp?termid=P0195"/>
        <rdfs:label xml:lang="en">full fat claim</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_03510196 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_03510196">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_03510017"/>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/foodon.owl"/>
        <oboInOwl:hasDbXref rdf:resource="http://www.langual.org/langual_thesaurus.asp?termid=P0196"/>
        <rdfs:label xml:lang="en">trans fat claim</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_03510197 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_03510197">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_03510159"/>
        <obo:IAO_0000115 xml:lang="en">Food Quality/Food Assurance Claim indicates, with reference to the product branding, labelling or packaging, whether the product is stamped with a quality mark, as approved by the governing authority, such as USDA for USA products [Source: GS1].</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/foodon.owl"/>
        <oboInOwl:hasDbXref rdf:resource="http://www.langual.org/langual_thesaurus.asp?termid=P0197"/>
        <rdfs:label xml:lang="en">food quality claim</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_03510198 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_03510198">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_03510124"/>
        <obo:IAO_0000115 xml:lang="en">It should be noted that such claims are illegal in some countries, e.g. Denmark, and that other countries, e.g. United Kingdom, are calling for an end to the use of terms such as &apos;diabetic&apos; or &apos;suitable for diabetics&apos; on food labels.
The European Commission is considering how foods intended specifically for people with diabetes can be controlled.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/foodon.owl"/>
        <oboInOwl:hasDbXref rdf:resource="http://www.langual.org/langual_thesaurus.asp?termid=P0198"/>
        <rdfs:label xml:lang="en">diabetic or suitable for diabetics claim</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_03510199 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_03510199">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_03510126"/>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/foodon.owl"/>
        <oboInOwl:hasDbXref rdf:resource="http://www.langual.org/langual_thesaurus.asp?termid=P0199"/>
        <rdfs:label xml:lang="en">vegan/vegetarian or suitability for vegan/vegetarian claim</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_03510200 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_03510200">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_03510115"/>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/foodon.owl"/>
        <oboInOwl:hasDbXref rdf:resource="http://www.langual.org/langual_thesaurus.asp?termid=P0200"/>
        <rdfs:label xml:lang="en">no pork added claim</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_03510201 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_03510201">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_03510115"/>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/foodon.owl"/>
        <oboInOwl:hasDbXref rdf:resource="http://www.langual.org/langual_thesaurus.asp?termid=P0201"/>
        <rdfs:label xml:lang="en">no beef added claim</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_03510202 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_03510202">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_03510065"/>
        <obo:IAO_0000115 xml:lang="en">Food that is promoted as being either high or low in protein.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/foodon.owl"/>
        <oboInOwl:hasDbXref rdf:resource="http://www.langual.org/langual_thesaurus.asp?termid=P0202"/>
        <rdfs:label xml:lang="en">protein special claim</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_03510203 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_03510203">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_03510202"/>
        <obo:IAO_0000115 xml:lang="en">A claim that a food is high in protein, and any claim likely to have the same meaning for the consumer, may only be made where at least 20 % of the energy value of the food is provided by protein [REGULATION (EC) No 1924/2006 Corrigendum 2007-01-18].</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/foodon.owl"/>
        <oboInOwl:hasDbXref rdf:resource="http://www.langual.org/langual_thesaurus.asp?termid=P0203"/>
        <rdfs:label xml:lang="en">high protein food</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_03510204 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_03510204">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_03510210"/>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/foodon.owl"/>
        <oboInOwl:hasDbXref rdf:resource="http://www.langual.org/langual_thesaurus.asp?termid=P0204"/>
        <rdfs:label xml:lang="en">natural source of vitamins and or minerals claim</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_03510205 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_03510205">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_03510049"/>
        <obo:IAO_0000115 xml:lang="en">A claim that a food is a source of fibre, and any claim likely to have the same meaning for the consumer, may only be made where the product contains at least 3 g of fibre per 100 g or at least 1,5 g of fibre per 100 kcal [REGULATION (EC) No 1924/2006 Corrigendum 2007-01-18].</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/foodon.owl"/>
        <oboInOwl:hasDbXref rdf:resource="http://www.langual.org/langual_thesaurus.asp?termid=P0205"/>
        <rdfs:label xml:lang="en">source of fibre</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_03510206 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_03510206">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_03510202"/>
        <obo:IAO_0000115 xml:lang="en">A claim that a food is a source of protein, and any claim likely to have the same meaning for the consumer, may only be made where at least 12 % of the energy value of the food is provided by protein. [REGULATION (EC) No 1924/2006 Corrigendum].</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/foodon.owl"/>
        <oboInOwl:hasDbXref rdf:resource="http://www.langual.org/langual_thesaurus.asp?termid=P0206"/>
        <rdfs:label xml:lang="en">source of protein</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_03510207 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_03510207">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_03510095"/>
        <obo:IAO_0000115 xml:lang="en">A claim that a food contains a nutrient or another substance, for which specific conditions are not laid down in this Regulation, or any claim likely to have the same meaning for the consumer, may only be made where the product complies with all the applicable provisions of this Regulation, and in particular Article 5. For vitamins and minerals the conditions of the claim &quot;source of&quot;shall apply. [REGULATION (EC) No 1924/2006 Corrigendum 2007-01-18].</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/foodon.owl"/>
        <oboInOwl:hasDbXref rdf:resource="http://www.langual.org/langual_thesaurus.asp?termid=P0207"/>
        <rdfs:label xml:lang="en">contains {name of the nutrient or other substance} nutrition claim</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_03510208 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_03510208">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_03510095"/>
        <obo:IAO_0000115 xml:lang="en">A claim stating that the content in one or more nutrients, other than vitamins and minerals, has been increased, and any claim likely to have the same meaning for the consumer, may only be made where the product meets the conditions for the claim &quot;source of&quot;and the increase in content is at least 30 % compared to a similar product. [Forordning (EF) nr. 1924/2006 Berigtigelse 2007-01-18].</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/foodon.owl"/>
        <oboInOwl:hasDbXref rdf:resource="http://www.langual.org/langual_thesaurus.asp?termid=P0208"/>
        <rdfs:label xml:lang="en">increased {name of nutrient} nutrition claim</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_03510209 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_03510209">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_03510059"/>
        <obo:IAO_0000115 xml:lang="en">Where a food naturally meets the condition(s) laid down in this Annex for the use of a nutritional claim, the term &quot;naturally/natural&quot;may be used as a prefix to the claim [REGULATION (EC) No 1924/2006 Corrigendum2007-01-18].</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/foodon.owl"/>
        <oboInOwl:hasDbXref rdf:resource="http://www.langual.org/langual_thesaurus.asp?termid=P0209"/>
        <rdfs:label xml:lang="en">&quot;naturally/natural&quot;label claim</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_03510210 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_03510210">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_03510095"/>
        <obo:IAO_0000115 xml:lang="en">A claim that a food is a source of vitamins and/or minerals, and any claim likely to have the same meaning for the consumer, may only be made where the product contains at least a significant amount as defined in the Annex to Directive 90/496/EEC or an amount provided for by derogations granted according to Article 6 of Regulation (EC) No 1925/2006 of the European Parliament and of the Council of 20 December 2006 on the addition of vitamins and minerals and of certain other substances to foods [REGULATION (EC) No 1924/2006 Corrigendum2007-01-18].</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/foodon.owl"/>
        <oboInOwl:hasDbXref rdf:resource="http://www.langual.org/langual_thesaurus.asp?termid=P0210"/>
        <rdfs:label xml:lang="en">source of {name of vitamin/s}  and/or {name of mineral/s} nutrition claim</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_03510211 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_03510211">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_03510095"/>
        <obo:IAO_0000115 xml:lang="en">A claim that a food is high in vitamins and/or minerals, and any claim likely to have the same meaning for the consumer, may only be made where the product contains at least twice the value of &quot;source of [NAME OF VITAMIN/S] and/or [NAME OF MINERAL/S]&quot; [REGULATION (EC) No 1924/2006 Corrigendum 2007-01-18].</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/foodon.owl"/>
        <oboInOwl:hasDbXref rdf:resource="http://www.langual.org/langual_thesaurus.asp?termid=P0211"/>
        <rdfs:label xml:lang="en">high {name of vitamin/s} and/or {name of mineral/s} nutrition claim</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_03510212 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_03510212">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_03510095"/>
        <obo:IAO_0000115 xml:lang="en">A claim stating that the content in one or more nutrients has been reduced, and any claim likely to have the same meaning for the consumer, may only be made where the reduction in content is at least 30 % compared to a similar product, except for micronutrients, where a 10 % difference in the reference values as set in Directive 90/496/EEC shall be acceptable, and for sodium, or the equivalent value for salt, where a 25 % difference shall be acceptable. [REGULATION (EC) No 1924/2006 Corrigendum 2007-01-18].</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/foodon.owl"/>
        <oboInOwl:hasDbXref rdf:resource="http://www.langual.org/langual_thesaurus.asp?termid=P0212"/>
        <rdfs:label xml:lang="en">reduced {name of nutrient} nutrition claim</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_03510213 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_03510213">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_03602001"/>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/foodon.owl"/>
        <oboInOwl:hasDbXref rdf:resource="http://www.langual.org/langual_thesaurus.asp?termid=P0213"/>
        <rdfs:label xml:lang="en">food allergen labelling</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_03510214 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_03510214">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_03510213"/>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/foodon.owl"/>
        <oboInOwl:hasDbXref rdf:resource="http://www.langual.org/langual_thesaurus.asp?termid=P0214"/>
        <rdfs:label xml:lang="en">food allergen labelling about cereals containing gluten and products thereof</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_03510215 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_03510215">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_03510213"/>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/foodon.owl"/>
        <oboInOwl:hasDbXref rdf:resource="http://www.langual.org/langual_thesaurus.asp?termid=P0215"/>
        <rdfs:label xml:lang="en">food allergen labelling about crustaceans and products thereof</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_03510216 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_03510216">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_03510213"/>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/foodon.owl"/>
        <oboInOwl:hasDbXref rdf:resource="http://www.langual.org/langual_thesaurus.asp?termid=P0216"/>
        <rdfs:label xml:lang="en">food allergen labelling about eggs and products thereof</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_03510217 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_03510217">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_03510213"/>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/foodon.owl"/>
        <oboInOwl:hasDbXref rdf:resource="http://www.langual.org/langual_thesaurus.asp?termid=P0217"/>
        <rdfs:label xml:lang="en">food allergen labelling about fish and products thereof</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_03510218 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_03510218">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_03510213"/>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/foodon.owl"/>
        <oboInOwl:hasDbXref rdf:resource="http://www.langual.org/langual_thesaurus.asp?termid=P0218"/>
        <rdfs:label xml:lang="en">food allergen labelling about peanuts and products thereof</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_03510219 -->

