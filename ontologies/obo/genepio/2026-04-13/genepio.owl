        <oboInOwl:hasDbXref rdf:resource="http://www.langual.org/langual_thesaurus.asp?termid=N0028"/>
        <rdfs:label xml:lang="en">Cryovac bag plastic surface</rdfs:label>
    </owl:Class>
    


