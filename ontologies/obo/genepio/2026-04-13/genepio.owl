    <!-- http://purl.obolibrary.org/obo/NCIT_C113124 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NCIT_C113124">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NCIT_C113122"/>
        <obo:IAO_0000115>A blood collection tube that contains a vacuum, allowing it to draw blood through a needle to fill the tube.</obo:IAO_0000115>
