        <obo:GENEPIO_0000162 xml:lang="en">PCDS: The version number of the flow cell used for generating sequence data.</obo:GENEPIO_0000162>
        <obo:IAO_0000112>PCDS: R.9.4.1</obo:IAO_0000112>
        <obo:IAO_0000114>metadata incomplete</obo:IAO_0000114>
        <obo:IAO_0000118 xml:lang="en">PCDS:sequencing_flow_cell_version</obo:IAO_0000118>
