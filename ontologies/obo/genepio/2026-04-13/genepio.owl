    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GENEPIO_0001552">
        <obo:IAO_0000117>Damion Dooley</obo:IAO_0000117>
        <obo:IAO_0000231>Found to be redudant with another term, deprecrated in favor of said term.</obo:IAO_0000231>
        <obo:IAO_0100001 rdf:resource="http://purl.obolibrary.org/obo/GENEPIO_0100212"/>
