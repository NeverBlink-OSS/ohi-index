        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000123"/>
        <obo:IAO_0000115 xml:lang="en">The NIFSTD ontology of the Neuroscience Information Framework is composed of a collection of OWL modules with separate modules covering major domains of neuroscience: anatomy, cell, subcellular, molecule, organism, function and dysfunction.</obo:IAO_0000115>
        <obo:IAO_0000117>Damion Dooley</obo:IAO_0000117>
