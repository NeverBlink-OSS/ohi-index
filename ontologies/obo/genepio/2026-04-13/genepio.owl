        <oboInOwl:hasExactSynonym>presymphysial node</oboInOwl:hasExactSynonym>
        <rdfs:label>presymphysial lymph node</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UBERON_0015895 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0015895">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0009006"/>
        <obo:IAO_0000115>One of the deep inguinal lymph nodes located in or adjacent to the femoral canal; sometimes mistaken for a femoral hernia when enlarged.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/uberon.owl"/>
        <oboInOwl:hasDbXref>BTO:0004550</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>FMA:44303</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>nodus inguinales profundi proximalis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>nodus lymphoideus inguinales profundi proximalis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>proximal deep inguinal node</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>proximal inguinal lymph node</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>rosenmuller&apos;s gland</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>rosenmuller&apos;s node</oboInOwl:hasExactSynonym>
        <rdfs:label>proximal deep inguinal lymph node</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UBERON_0015917 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0015917">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000029"/>
        <obo:IAO_0000115>A lymph node that is located close to the surface.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/uberon.owl"/>
        <oboInOwl:hasDbXref>FMA:12767</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>NCIT:C102716</oboInOwl:hasDbXref>
        <rdfs:label>superficial lymph node</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UBERON_0015918 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0015918">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000029"/>
        <obo:IAO_0000115>A lymph node that is located deeper within the organism, further from the surface.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/uberon.owl"/>
        <oboInOwl:hasDbXref>FMA:12768</oboInOwl:hasDbXref>
        <rdfs:label>deep lymph node</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UBERON_0015922 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0015922">
