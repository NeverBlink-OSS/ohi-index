        <oboInOwl:hasAlternativeId>HP:0004883</oboInOwl:hasAlternativeId>
        <oboInOwl:hasDbXref>UMLS:C4025279</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>Respiratory distress necessitating mechanical ventilation</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Respiratory distress requiring endotracheal intubation</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Respiratory distress requiring mechanical ventilation</oboInOwl:hasExactSynonym>
        <rdfs:label>Respiratory failure requiring assisted ventilation</rdfs:label>
    </owl:Class>
    


