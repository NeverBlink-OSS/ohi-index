        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/uberon.owl"/>
        <oboInOwl:hasDbXref>MA:0003028</oboInOwl:hasDbXref>
        <rdfs:label>subcutaneous lymph node</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UBERON_0015469 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0015469">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000029"/>
        <obo:IAO_0000115>The splenic lymph nodes (or pancreaticolienal) accompany the lienal (splenic) artery, and are situated in relation to the posterior surface and upper border of the pancreas; one or two members of this group are found in the gastrolienal ligament. Their afferents are derived from the stomach, spleen, and pancreas, their efferents join the celiac group of preaortic glands.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/uberon.owl"/>
        <oboInOwl:hasDbXref>FMA:66187</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MA:0003074</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SCTID:80088008</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Wikipedia:Splenic_lymph_nodes</oboInOwl:hasDbXref>
        <rdfs:label>splenic lymph node</rdfs:label>
    </owl:Class>
    


