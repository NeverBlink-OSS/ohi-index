        <oboInOwl:hasExactSynonym>Pregnancies</oboInOwl:hasExactSynonym>
        <rdfs:label>pregnancy</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ebi.ac.uk/efo/EFO_0004302 -->

