        <oboInOwl:hasExactSynonym>SEXUAL PARTNER</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Sexual Partner</oboInOwl:hasExactSynonym>
        <rdfs:label>Sexual Partner</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C103180 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NCIT_C103180">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NCIT_C81893"/>
