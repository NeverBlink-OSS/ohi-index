    <!-- http://purl.obolibrary.org/obo/MONDO_0011382 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MONDO_0011382">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MONDO_0006025"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MONDO_0019050"/>
        <obo:IAO_0000115>Sickle cell anemias are chronic hemolytic diseases that may induce three types of acute accidents: severe anemia, severe bacterial infections, and ischemic vasoocclusive accidents (VOA) caused by sickle-shaped red blood cells obstructing small blood vessels and capillaries. Many diverse complications can occur.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/mondo.owl"/>
