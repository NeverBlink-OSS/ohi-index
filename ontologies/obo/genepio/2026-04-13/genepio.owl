        <obo:IAO_0000115 xml:lang="en">A livespan history item is a date-associated event pertaining to the life of a subject.</obo:IAO_0000115>
        <obo:IAO_0000117 xml:lang="en">Damion Dooley</obo:IAO_0000117>
