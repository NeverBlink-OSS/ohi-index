        <oboInOwl:inSubset rdf:resource="http://purl.oboInOwllibrary.org/oboInOwl/mondo#otar"/>
        <rdfs:label>interstitial lung disease</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/MONDO_0016218 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MONDO_0016218">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MONDO_0000590"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MONDO_0002254"/>
        <obo:IAO_0000115>A spectrum of rare post-infectious neuropathies that usually occur in otherwise healthy patients. GBS is clinically heterogeneous and encompasses acute inflammatory demyelinating polyradiculoneuropathy (AIDP), acute motor axonal neuropathy (AMAN) and acute motor-sensory axonal neuropathy (AMSAN), Miller-Fisher syndrome (MFS) and some other regional variants.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/mondo.owl"/>
