        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/genepio/core_slim.owl"/>
        <rdfs:label xml:lang="en">soluble inorganic material concentration</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/GENEPIO_0000039 -->

