        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000428"/>
        <obo:IAO_0000115 xml:lang="en">A data item that is a set of entities, referenced by mention, that don&apos;t necessarily have something in common.</obo:IAO_0000115>
        <obo:IAO_0000117 xml:lang="en">0000-0002-8844-9165</obo:IAO_0000117>
        <obo:IAO_0000117>0000-0002-9578-0788</obo:IAO_0000117>
