        <obo:IAO_0000115 xml:lang="en">A crustacean allergy triggered by Litopenaeus vannamei.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/doid.owl"/>
        <rdfs:label xml:lang="en">white shrimp allergy</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/DOID_0060530 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_0060530">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_0060523"/>
        <obo:IAO_0000115 xml:lang="en">A mollusc allergy triggered by snails.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/doid.owl"/>
        <rdfs:label xml:lang="en">snail allergy</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/DOID_0060531 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_0060531">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_0060530"/>
        <obo:IAO_0000115 xml:lang="en">A snail allergy triggered by the horned turban snail.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/doid.owl"/>
        <rdfs:label xml:lang="en">horned turban snail allergy</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/DOID_0060564 -->

