        <oboInOwl:hasExactSynonym>Dehydration</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Exsiccosis</oboInOwl:hasExactSynonym>
        <rdfs:label>Dehydration</rdfs:label>
