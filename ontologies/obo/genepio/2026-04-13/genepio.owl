        <obo:GENEPIO_0000001>Assembly QC</obo:GENEPIO_0000001>
        <obo:GENEPIO_0000004>Annotation Source</obo:GENEPIO_0000004>
        <obo:GENEPIO_0000005>Standard Term</obo:GENEPIO_0000005>
        <obo:IAO_0000112>annotation source description</obo:IAO_0000112>
        <obo:IAO_0000115>For cases where annotation was provided by a community jamboree or model organism database rather than by a specific submitter</obo:IAO_0000115>
        <obo:IAO_0000119>GROUP: MIxS</obo:IAO_0000119>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/genepio/core_slim.owl"/>
        <rdfs:label>genome annotation source</rdfs:label>
    </owl:Class>
    


