    <!-- http://purl.obolibrary.org/obo/FOODON_03440011 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_03440011">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_00002470"/>
        <obo:IAO_0000115 xml:lang="en">Used to broadly characterize a food product based on the extent of heat applied. Heat treatment affects the flavor and textural characteristics of a food and thus consumer preparation time. Heat treatment causes chemical changes and/or reduction of enzyme and of microbial activity and thus affects food safety and shelflife. Specifics of preparation are covered by *G. COOKING METHOD* and *H. TREATMENT APPLIED*. [FDA CFSAN 1995]</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/foodon.owl"/>
        <oboInOwl:hasDbXref rdf:resource="http://www.langual.org/langual_thesaurus.asp?termid=F0011"/>
        <rdfs:label xml:lang="en">extent of food heat treatment</rdfs:label>
    </owl:Class>
    


