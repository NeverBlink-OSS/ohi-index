        <rdfs:comment xml:lang="en">PCDS: If known, provide information about whether the individual had a previous Mpox infection. Select a value from the pick list.</rdfs:comment>
        <rdfs:label xml:lang="en">prior mpox infection status</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/GENEPIO_0100533 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GENEPIO_0100533">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GENEPIO_0102276"/>
