        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001988"/>
        <obo:IAO_0000115>A dark greenish mass that accumulates in the bowel during fetal life and is discharged shortly after birth.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/uberon.owl"/>
        <oboInOwl:hasDbXref>BTO:0000838</oboInOwl:hasDbXref>
