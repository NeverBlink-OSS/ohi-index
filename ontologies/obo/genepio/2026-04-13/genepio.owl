        <rdfs:label>aminoglycoside</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_478164 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_478164">
