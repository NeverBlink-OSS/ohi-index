    <!-- http://purl.obolibrary.org/obo/ENVO_03501145 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_03501145">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_01000426"/>
        <obo:IAO_0000115 xml:lang="en">A room in which emergency medical care is provided.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/envo.owl"/>
        <oboInOwl:hasExactSynonym xml:lang="en">A&amp;E room</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">ER room</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">EW room</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">accident &amp; emergency department room</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">casualty department room</oboInOwl:hasExactSynonym>
