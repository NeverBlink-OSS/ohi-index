        <oboInOwl:hasDbXref rdf:resource="http://www.langual.org/langual_thesaurus.asp?termid=H0189"/>
        <oboInOwl:hasDbXref rdf:resource="http://www.langual.org/langual_thesaurus.asp?termid=P0185"/>
        <rdfs:label xml:lang="en">iodized claim</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_03510186 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_03510186">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_03510095"/>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/foodon.owl"/>
        <oboInOwl:hasDbXref rdf:resource="http://www.langual.org/langual_thesaurus.asp?termid=P0186"/>
        <rdfs:label xml:lang="en">unfortified claim</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_03510187 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_03510187">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_03510126"/>
        <obo:IAO_0000115 xml:lang="en">Characterized by adherence to the dietary practices required by Islamic law (Webster&apos;s).</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/foodon.owl"/>
        <oboInOwl:hasDbXref rdf:resource="http://www.langual.org/langual_thesaurus.asp?termid=P0187"/>
        <rdfs:label xml:lang="en">halal claim</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_03510188 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_03510188">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_03510026"/>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/foodon.owl"/>
        <oboInOwl:hasDbXref rdf:resource="http://www.langual.org/langual_thesaurus.asp?termid=P0188"/>
        <rdfs:label xml:lang="en">adult human as food consumer</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_03510189 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_03510189">
