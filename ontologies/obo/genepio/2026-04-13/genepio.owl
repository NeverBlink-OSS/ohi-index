        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_00004483"/>
        <obo:IAO_0000115 xml:lang="en">A primal skeletal area of a pig that extends from groin to ankle.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/foodon.owl"/>
        <rdfs:label xml:lang="en">pork leg</rdfs:label>
