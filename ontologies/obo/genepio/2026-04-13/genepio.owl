    <!-- http://purl.obolibrary.org/obo/MONDO_0011122 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MONDO_0011122">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MONDO_0003916"/>
        <obo:IAO_0000115>A disorder involving an excessive amount of body fat.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/mondo.owl"/>
        <oboInOwl:hasDbXref>DOID:9970</oboInOwl:hasDbXref>
