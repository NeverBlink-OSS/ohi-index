        <obo:IAO_0000119>https://en.wikipedia.org/wiki/Restaurant</obo:IAO_0000119>
        <obo:IAO_0100001 rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://purl.obolibrary.org/obo/ENVO_01000934</obo:IAO_0100001>
