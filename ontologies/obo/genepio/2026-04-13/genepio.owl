    <!-- http://purl.obolibrary.org/obo/UBERON_0001157 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0001157">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000168"/>
        <obo:IAO_0000115>The proximal-distal subdivision of colon that runs transversely across the upper part of the abdomen, from the right to the left colic flexure. Continuous with the descending colon[BTO,modified].</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/uberon.owl"/>
