        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NCIT_C36278"/>
        <obo:IAO_0000115>Symptoms, physical examination results, and/or laboratory test results related to the cardiovascular system.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/ncit.owl"/>
        <oboInOwl:hasExactSynonym>CARDIOVASCULAR SYSTEM</oboInOwl:hasExactSynonym>
