        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000115>A genome is the sum of genetic material within a cell or virion.</obo:IAO_0000115>
        <obo:IAO_0000117>Damion Dooley</obo:IAO_0000117>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/so.owl"/>
        <oboInOwl:hasDbXref>http://en.wikipedia.org/wiki/Genome</oboInOwl:hasDbXref>
        <rdfs:label>genome</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/SO_0001027 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/SO_0001027">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/SO_0001507"/>
        <obo:IAO_0000115>A genotype is a variant genome, complete or incomplete.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/so.owl"/>
        <oboInOwl:hasDbXref>http://en.wikipedia.org/wiki/Genotype</oboInOwl:hasDbXref>
        <rdfs:label>genotype</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/SO_0001082 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/SO_0001082">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/SO_0000700"/>
