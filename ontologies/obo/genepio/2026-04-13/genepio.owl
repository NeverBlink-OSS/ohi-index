        </rdfs:subClassOf>
        <obo:GENEPIO_0000005>AHA HIPPA: http://www.aha.org/content/00-10/overview0302.pdf</obo:GENEPIO_0000005>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000120"/>
        <obo:IAO_0000115 xml:lang="en">Good - Vital signs are stable and within normal limits. Patient is conscious and comfortable. Indicators are excellent.</obo:IAO_0000115>
        <obo:IAO_0000117 xml:lang="en">Damion Dooley</obo:IAO_0000117>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/GENEPIO_0001837"/>
