    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GENEPIO_0001880">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GENEPIO_0001869"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/OBI_0002135"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000428"/>
        <obo:IAO_0000116 xml:lang="en">As mentioned here: http://www.datypic.com/sc/xsd11/t-xsd_dateTimeStamp.html , we could change this to dateTimeStamp if we need to enforce a time zone?</obo:IAO_0000116>
        <obo:IAO_0000117>Damion Dooley</obo:IAO_0000117>
        <rdfs:comment xml:lang="en">Some dates don&apos;t belong to a range other than the overall timeline.

Other dates associated with a process fall within a range that has a start and end bound.</rdfs:comment>
        <rdfs:label xml:lang="en">datetime linear coordinate</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/GENEPIO_0001881 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GENEPIO_0001881">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GENEPIO_0001880"/>
        <obo:GENEPIO_0001920>$year/$month/$day</obo:GENEPIO_0001920>
        <obo:GENEPIO_1919 rdf:datatype="http://www.w3.org/2000/01/rdf-schema#Literal">/^(:&lt;year&gt;(19|20)\d\d)([- /.])(:&lt;month&gt;0[1-9]|1[012])\2(:&lt;day&gt;0[1-9]|[12][0-9]|3[01])$/
/^(:&lt;month&gt;0[1-9]|1[012])([- /.])(:&lt;day&gt;0[1-9]|[12][0-9]|3[01])\2(:&lt;year&gt;(19|20)\d\d)$/ 
/^(:&lt;day&gt;0[1-9]|[12][0-9]|3[01])([- /.])(:&lt;month&gt;0[1-9]|1[012])\2(:&lt;year&gt;(19|20)\d\d)$/</obo:GENEPIO_1919>
        <obo:GENEPIO_1921>$year/$month/$day</obo:GENEPIO_1921>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000428"/>
        <obo:IAO_0000115 xml:lang="en">A datetime set item is a datetime that has been grouped semantically under a given type of process</obo:IAO_0000115>
        <obo:IAO_0000117>Damion Dooley</obo:IAO_0000117>
        <rdfs:comment xml:lang="en">The instant is subject to the level of granularity of the observed time.  Year / Month / Day / Hour / Minute / Second</rdfs:comment>
        <rdfs:label xml:lang="en">datetime set item</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/GENEPIO_0001882 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GENEPIO_0001882">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GENEPIO_0001883"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000428"/>
        <obo:IAO_0000117>Damion Dooley</obo:IAO_0000117>
        <rdfs:label xml:lang="en">created date</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/GENEPIO_0001883 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GENEPIO_0001883">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GENEPIO_0001881"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000428"/>
        <obo:IAO_0000117>Damion Dooley</obo:IAO_0000117>
        <rdfs:label xml:lang="en">entity history item</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/GENEPIO_0001884 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GENEPIO_0001884">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GENEPIO_0001859"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000428"/>
        <obo:IAO_0000117>Damion Dooley</obo:IAO_0000117>
        <rdfs:label xml:lang="en">n-dimensional entity</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/GENEPIO_0001885 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GENEPIO_0001885">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GENEPIO_0001884"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/GENEPIO_0001996"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002180"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/GENEPIO_0001870"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002180"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://purl.obolibrary.org/obo/GENEPIO_0001870"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000428"/>
        <obo:IAO_0000117>Damion Dooley</obo:IAO_0000117>
        <rdfs:comment xml:lang="en">Generic term allowing for different geometries.  Can encompass the infinite surface area of a plane, or some portion bounded by a circumference or polygon for example.</rdfs:comment>
        <rdfs:label xml:lang="en">surface area</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/GENEPIO_0001886 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GENEPIO_0001886">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NCIT_C16632"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000428"/>
        <obo:IAO_0000114 xml:lang="en">A designated area on earth is one or more areas defined by one or more boundaries.  A boundary can be defined by a polygon perimeter, a lat/long and radius, or a fiat-boundary geographic featureset like a named river channel or mountain ridge; it may have one or more names associated with it. Note that areas associated with a name may change their boundary definitions over time.</obo:IAO_0000114>
        <obo:IAO_0000117>Damion Dooley</obo:IAO_0000117>
        <rdfs:label xml:lang="en">designated area on Earth</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/GENEPIO_0001887 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GENEPIO_0001887">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GENEPIO_0001886"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000428"/>
        <obo:IAO_0000117>Damion Dooley</obo:IAO_0000117>
        <rdfs:label xml:lang="en">landmark</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/GENEPIO_0001888 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GENEPIO_0001888">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NCIT_C25621"/>
        <owl:disjointWith rdf:resource="http://purl.obolibrary.org/obo/NCIT_C25720"/>
        <obo:GENEPIO_1919>/^((:&lt;FSA&gt;[ABCEGHJKLMNPRSTVXY][0-9][ABCEGHJKLMNPRSTVWXYZ])) ?(:&lt;LDU&gt;[0-9][ABCEGHJKLMNPRSTVWXYZ][0-9])$/i, $FSA $LDU</obo:GENEPIO_1919>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000428"/>
        <obo:IAO_0000115 xml:lang="en">A Canadian postal code is a postal code that pertains to a geographic region of Canada.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">Note that a Canadian postal code can cover multiple communities.  Secondly, postal codes can be retired, and then reintroduced elsewhere.  Historical data associations may need to take the date of postal code mapping into account.</obo:IAO_0000116>
        <rdfs:label xml:lang="en">Canada postal code</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/GENEPIO_0001889 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GENEPIO_0001889">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000577"/>
        <obo:GENEPIO_1919>/^((:&lt;FSA&gt;[ABCEGHJKLMNPRSTVXY][0-9][ABCEGHJKLMNPRSTVWXYZ]))$/i, $FSA</obo:GENEPIO_1919>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000428"/>
        <obo:IAO_0000115 xml:lang="en">The &quot;Canadia postal code FSA&quot; is the leading FSA (Forward Sortation Area) 3 character portion of a full 6 character Canadian postal code.  It can be used to reduce the geographic granularity of a postal code for data generalization or obfuscation.</obo:IAO_0000115>
        <obo:IAO_0000117>Damion Dooley</obo:IAO_0000117>
        <rdfs:label xml:lang="en">Canada postal code FSA</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/GENEPIO_0001890 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GENEPIO_0001890">
        <obo:IAO_0000115 xml:lang="en">A &quot;USA zip code&quot; is a five digit (Zone Improvement Plan) or 9 digit postal code pertaining to a region of the United States of America. The optional trailing 4 digits of a 9 digit zip code provide greater granularity of delivery target.</obo:IAO_0000115>
        <obo:IAO_0000117>Damion Dooley</obo:IAO_0000117>
        <obo:IAO_0100001>http://purl.obolibrary.org/obo/NCIT_C25720</obo:IAO_0100001>
        <rdfs:label xml:lang="en">obsolete: US postal code</rdfs:label>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/GENEPIO_0001891 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GENEPIO_0001891">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000300"/>
        <obo:GENEPIO_1919>/^([a-zAA-Z0-9 _-&apos;)*$/</obo:GENEPIO_1919>
        <rdfs:label xml:lang="en">alphanumeric phrase</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/GENEPIO_0001892 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GENEPIO_0001892">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GENEPIO_0001741"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000428"/>
        <obo:IAO_0000117>Damion Dooley</obo:IAO_0000117>
        <rdfs:label xml:lang="en">entity history record</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/GENEPIO_0001893 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GENEPIO_0001893">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GENEPIO_0001741"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000428"/>
        <obo:IAO_0000117>Damion Dooley</obo:IAO_0000117>
        <rdfs:label xml:lang="en">generic range history record</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/GENEPIO_0001894 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GENEPIO_0001894">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GENEPIO_0001903"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000428"/>
        <obo:IAO_0000117>Damion Dooley</obo:IAO_0000117>
        <rdfs:label xml:lang="en">lingual set</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/GENEPIO_0001895 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GENEPIO_0001895">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GENEPIO_0001903"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000428"/>
        <obo:IAO_0000117>Damion Dooley</obo:IAO_0000117>
        <rdfs:label xml:lang="en">non-lingual set</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/GENEPIO_0001896 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GENEPIO_0001896">
        <owl:equivalentClass>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/GENEPIO_0001897"/>
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/GENEPIO_0001898"/>
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/GENEPIO_0001899"/>
                </owl:unionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OBI_0000938"/>
        <rdfs:label xml:lang="en">phone type</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/GENEPIO_0001897 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GENEPIO_0001897">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GENEPIO_0001896"/>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/GENEPIO_0001898 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GENEPIO_0001898">
