        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/mp.owl"/>
        <rdfs:label>abnormal cell physiology</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/MP_0031126 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MP_0031126">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MP_0000316"/>
        <obo:IAO_0000115>necrosis or death of soft tissue due to lack of blood flow resulting from injury, infection or other conditions that affect blood circulation</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/mp.owl"/>
        <oboInOwl:hasExactSynonym>gangrenous necrosis</oboInOwl:hasExactSynonym>
        <rdfs:label>gangrene</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/MP_0031127 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MP_0031127">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MP_0031126"/>
        <obo:IAO_0000115>a form of coagulative necrosis that develops in ischemic tissue, where the blood supply is inadequate to keep tissue viable, in the absence of superimposed microbial infection; can be due to peripheral artery disease or acute limb ischemia; the affected body part is dry, shrunken, and dark reddish-black and can fall off (autoamputate) if not removed surgically</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/mp.owl"/>
        <rdfs:comment>The term dry is used only when referring to a limb or to the gut; in other locations, this same type of necrosis is called an infarction, such as myocardial infarction</rdfs:comment>
        <rdfs:label>dry gangrene</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/NBO_0000313 -->

