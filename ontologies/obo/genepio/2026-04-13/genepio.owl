        <oboInOwl:hasExactSynonym>Joint stiffness</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Stiff joint</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Stiff joints</oboInOwl:hasExactSynonym>
        <rdfs:label>Joint stiffness</rdfs:label>
    </owl:Class>
    


