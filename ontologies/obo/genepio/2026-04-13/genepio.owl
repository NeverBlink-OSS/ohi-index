        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GENEPIO_0001170"/>
        <obo:IAO_0000115 xml:lang="en">A host hospital service status indicates the state of a host&apos;s interaction with hospital medical services.</obo:IAO_0000115>
