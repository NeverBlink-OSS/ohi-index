        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/foodon.owl"/>
        <oboInOwl:hasDbXref rdf:resource="http://www.langual.org/langual_thesaurus.asp?termid=P0125"/>
        <rdfs:label xml:lang="en">tooth decay-related claim</rdfs:label>
    </owl:Class>
    


