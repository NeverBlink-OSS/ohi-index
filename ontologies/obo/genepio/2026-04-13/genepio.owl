        <obo:GENEPIO_0000004>Soluble inorganic material</obo:GENEPIO_0000004>
        <obo:GENEPIO_0000005>GROUP: MIxS</obo:GENEPIO_0000005>
        <obo:IAO_0000112>soluble organic material name;measurement value</obo:IAO_0000112>
        <obo:IAO_0000115 xml:lang="en">A test specification which describes the concentration of substances such as ammonia, road-salt, sea-salt, cyanide, hydrogen sulfide, thiocyanates and thiosulfate in a sample.</obo:IAO_0000115>
        <obo:IAO_0000119>GROUP: MIxS enviro package</obo:IAO_0000119>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/genepio/core_slim.owl"/>
        <rdfs:label xml:lang="en">soluble inorganic material</rdfs:label>
    </owl:Class>
    


