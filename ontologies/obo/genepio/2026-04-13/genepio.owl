    <!-- http://purl.obolibrary.org/obo/MONDO_0020753 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MONDO_0020753">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MONDO_0005718"/>
        <obo:IAO_0000115>Infectious disease causes by viruses in the subfamily Orthocoronavirinae (coronaviruses). In humans, coronaviruses cause respiratory tract infections that can be mild, such as some cases of the common cold (among other possible causes, predominantly rhinoviruses), and others that can be lethal, such as SARS, MERS, and COVID-19.</obo:IAO_0000115>
