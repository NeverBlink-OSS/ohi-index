    <!-- http://purl.obolibrary.org/obo/UO_0000045 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0000045">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_0000000"/>
        <obo:IAO_0000115>A unit which is one of a particular measure to which all measures of that type can be related.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/uo.owl"/>
        <rdfs:label>base unit</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0000051 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0000051">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_0000000"/>
        <obo:IAO_0000115>A unit which represents a standard measurement of how much of a given substance there is mixed with another substance.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/uo.owl"/>
        <rdfs:label>concentration unit</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0000052 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0000052">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_0000182"/>
        <obo:IAO_0000115>A density unit which is a standard measure of the mass of a substance in a given volume.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/uo.owl"/>
        <oboInOwl:hasExactSynonym>mass per unit volume</oboInOwl:hasExactSynonym>
        <rdfs:label>mass density unit</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0000056 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0000056">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_0000095"/>
        <obo:IAO_0000115>A unit which is a standard measure of the volume of a homogeneous substance containing 6.02 x 1023 atoms or molecules.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/uo.owl"/>
        <rdfs:label>molar volume unit</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0000059 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0000059">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_0000095"/>
        <obo:IAO_0000115>A unit which is a standard measure of the volume of a given mass of substance (the reciprocal of density).</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/uo.owl"/>
        <rdfs:label>specific volume unit</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0000060 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0000060">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_0000000"/>
        <obo:IAO_0000115>A unit which is a standard measure of the rate of movement. Speed is measured in the same physical units of measurement as velocity, but does not contain the element of direction that velocity has. Speed is thus the magnitude component of velocity.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/uo.owl"/>
        <rdfs:label>speed/velocity unit</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0000067 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0000067">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_0000051"/>
        <obo:IAO_0000115>A concentration unit which is a standard measure of the number of moles of a given substance per kilogram of solvent.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/uo.owl"/>
        <rdfs:label>unit of molality</rdfs:label>
