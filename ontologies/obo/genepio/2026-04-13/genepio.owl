        <oboInOwl:hasAlternativeId>CHEBI:22189</oboInOwl:hasAlternativeId>
        <oboInOwl:hasAlternativeId>CHEBI:2406</oboInOwl:hasAlternativeId>
        <rdfs:label>acetate ester</rdfs:label>
    </owl:Class>
    


