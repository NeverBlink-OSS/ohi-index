    <!-- http://purl.obolibrary.org/obo/GENEPIO_0100941 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GENEPIO_0100941">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OBI_0002814"/>
        <obo:IAO_0000114>requires discussion</obo:IAO_0000114>
        <obo:IAO_0000115 xml:lang="en">A specimen collection device which is used to collect a single discrete samples from a specific location.</obo:IAO_0000115>
        <obo:IAO_0000116>Planned Obsolescence: this term is a placeholder for a term requested in another ontology. Once the appropriate ontology term is available, this term’s identifier will be obsoleted with a “term replaced by” id of the other term.</obo:IAO_0000116>
        <obo:IAO_0000118 xml:lang="en">grab sampler</obo:IAO_0000118>
        <dcterms:contributor rdf:resource="https://orcid.org/0000-0002-1107-9135"/>
        <dcterms:contributor rdf:resource="https://orcid.org/0000-0002-8844-9165"/>
        <dcterms:contributor rdf:resource="https://orcid.org/0000-0002-9578-0788"/>
        <dcterms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2023-11-20T16:24:25.000Z</dcterms:date>
        <rdfs:comment xml:lang="en">It typically consists of a container or scoop that can be manually triggered to open and close, allowing the user to &quot;grab&quot; a representative sample at a specific depth or location. Represents a “snapshot” of conditions at the moment of sampling, commonly used in water, wastewater and surface environmental sampling and alone does not account for temporal or spatial variability.</rdfs:comment>
        <rdfs:label xml:lang="en">grab sampling device</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/GENEPIO_0100942 -->

