    <!-- http://purl.obolibrary.org/obo/GENEPIO_0100615 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GENEPIO_0100615">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GENEPIO_0100632"/>
        <obo:GENEPIO_0000162 xml:lang="en">PCDS: A date recommended for the use of a product while at peak quality, this date is not a reflection of safety unless used on infant formula.</obo:GENEPIO_0000162>
        <obo:IAO_0000112>PCDS: 2020-05-25</obo:IAO_0000112>
        <obo:IAO_0000114>metadata incomplete</obo:IAO_0000114>
        <obo:IAO_0000115 xml:lang="en">A data field which describes the date recommended for the use of a product while at peak quality, this date is not a reflection of safety unless used on infant formula.</obo:IAO_0000115>
        <obo:IAO_0000118 xml:lang="en">PCDS:food_quality_date</obo:IAO_0000118>
        <dcterms:contributor rdf:resource="https://orcid.org/0000-0002-1107-9135"/>
        <dcterms:contributor rdf:resource="https://orcid.org/0000-0002-8844-9165"/>
        <dcterms:contributor rdf:resource="https://orcid.org/0000-0002-9578-0788"/>
        <dcterms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-04-24T00:42:14Z</dcterms:date>
        <oboInOwl:hasBroadSynonym xml:lang="en">food quality date</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasBroadSynonym xml:lang="en">food_quality_date</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">food quality date slot</oboInOwl:hasExactSynonym>
        <rdfs:comment xml:lang="en">PCDS: This date is typically labeled on a food product as &apos;best if used by&apos;, best by&apos;, &apos;use by&apos;, or &apos;freeze by&apos;. If the date is known, leave blank or provide a null value. Provide the date in ISO 8601 format, i.e. &apos;YYYY-MM-DD&apos;.</rdfs:comment>
        <rdfs:label xml:lang="en">food quality date</rdfs:label>
    </owl:Class>
    


