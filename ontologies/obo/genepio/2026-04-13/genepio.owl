    <!-- http://www.ebi.ac.uk/efo/EFO_0004918 -->

    <owl:Class rdf:about="http://www.ebi.ac.uk/efo/EFO_0004918">
        <rdfs:subClassOf rdf:resource="http://www.ebi.ac.uk/efo/EFO_0004949"/>
        <obo:IAO_0000115>The age, measured from some defined time point e.g. birth at which a subject (e.g. a human patient) is diagnosed with some disease e.g. breast cancer.</obo:IAO_0000115>
        <obo:IAO_0000117>Helen Parkinson</obo:IAO_0000117>
        <obo:IAO_0000119>http://purl.bioontology.org/ontology/SNOMEDCT/423493009</obo:IAO_0000119>
