        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/ncit.owl"/>
        <oboInOwl:hasExactSynonym>Other Anatomic Concept</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Other Anatomy Concept</oboInOwl:hasExactSynonym>
        <rdfs:label>Other Anatomic Concept</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C34144 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NCIT_C34144">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NCIT_C12219"/>
        <obo:IAO_0000115>Body tissue, region, surface, cavity, fluid, organ, or collection of organs present in, or associated with, an embryo.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/ncit.owl"/>
