        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_03500029"/>
        <obo:IAO_0000115 xml:lang="en">A surface of a Cryovac bag, a shrinkable version of pvdc used for vacuum packaging, e.g. of red meat.</obo:IAO_0000115>
