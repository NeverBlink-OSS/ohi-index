        <oboInOwl:hasDbXref>MedDRA:10005894</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>NCIt:C16358</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SNOMEDCT:60621009</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>BMI</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Quetelet&apos;s Index</oboInOwl:hasExactSynonym>
        <rdfs:label>body mass index</rdfs:label>
    </owl:Class>
    


