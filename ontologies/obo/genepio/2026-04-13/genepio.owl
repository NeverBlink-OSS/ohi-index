    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OMP_0000207">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GENEPIO_0001688"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000136"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/NCIT_C53471"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A microbial phenotype that is distinguished by the presence a specific surface antigen.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>serovar</oboInOwl:hasExactSynonym>
