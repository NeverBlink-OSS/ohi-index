        <oboInOwl:hasDbXref>UMLS:C2697661</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Wikipedia:Ileocolic_lymph_nodes</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>nodi lymphoidei ileocolici</oboInOwl:hasExactSynonym>
        <oboInOwl:hasNarrowSynonym>ileocecocolic lymph node</oboInOwl:hasNarrowSynonym>
        <rdfs:label>ileocolic lymph node</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UBERON_0016382 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0016382">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0002429"/>
