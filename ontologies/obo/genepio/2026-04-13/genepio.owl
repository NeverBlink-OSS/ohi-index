        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000115 xml:lang="en">Name of strain from which sample was obtained OR name of isolate from which sample was obtained.</obo:IAO_0000115>
        <obo:IAO_0000117 xml:lang="en">Damion Dooley</obo:IAO_0000117>
        <rdfs:label xml:lang="en">specimen strain or isolate identifier</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/GENEPIO_0002141 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GENEPIO_0002141">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000300"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/OBI_0002135"/>
                <owl:someValuesFrom>
                    <rdfs:Datatype>
                        <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
                        <owl:withRestrictions rdf:parseType="Collection">
                            <rdf:Description>
                                <xsd:pattern>\s*(\d(.\d{1,4})?|[1-8]\d(.\d{1,4})?|90(.0{1,4})?)\s*[WEwe]\s*(\d(.\d{1,4})?|[1-9]\d(.\d{1,4})?|1[0-7]\d(.\d{1,4})?|180(.0{1,4})?)\s*[NSns]\s*</xsd:pattern>
                            </rdf:Description>
                        </owl:withRestrictions>
                    </rdfs:Datatype>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000428"/>
        <obo:IAO_0000115 xml:lang="en">The geographical coordinates of the location where the sample was collected. Specify as degrees latitude and longitude in format &quot;d[d.dddd] N|S d[dd.dddd] W|E&quot;, eg, 38.98 N 77.11 W</obo:IAO_0000115>
        <obo:IAO_0000117 xml:lang="en">Damion Dooley</obo:IAO_0000117>
        <obo:IAO_0000119 xml:lang="en">https://www.ncbi.nlm.nih.gov/biosample/docs/attributes/</obo:IAO_0000119>
        <rdfs:label xml:lang="en">latitude and longitude coordinate (NCBI BioSample format)</rdfs:label>
    </owl:Class>
    


