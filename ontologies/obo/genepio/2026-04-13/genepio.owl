    <!-- http://purl.obolibrary.org/obo/UBERON_0000569 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0000569">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0003978"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0011185"/>
        <obo:IAO_0000115>The ileocecal valve is a sphincter muscle situated at the junction of the small intestine (ileum) and the large intestine. Its critical function is to limit the reflux of colonic contents into the ileum.</obo:IAO_0000115>
