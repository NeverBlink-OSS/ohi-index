        <obo:IAO_0000115 xml:lang="en">A whole breast that is obtained from a chicken.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/foodon.owl"/>
        <rdfs:label xml:lang="en">chicken breast</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_00002715 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_00002715">
