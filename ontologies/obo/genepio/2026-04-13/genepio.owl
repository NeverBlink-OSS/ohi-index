                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/GENEPIO_0000048"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002180"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onClass rdf:resource="http://purl.obolibrary.org/obo/GENEPIO_0000046"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002180"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onClass rdf:resource="http://purl.obolibrary.org/obo/GENEPIO_0000048"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000428"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/genepio/core_slim.owl"/>
        <rdfs:label xml:lang="en">PFGE test specification</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/GENEPIO_0000046 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GENEPIO_0000046">
