        <oboInOwl:hasExactSynonym>crib death</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>sudden infant death syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Sudden Infant Death Syndrome</rdfs:label>
    </owl:Class>
    


