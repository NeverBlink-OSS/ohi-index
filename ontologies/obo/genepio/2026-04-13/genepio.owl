                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002180"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PATO_0002390"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
