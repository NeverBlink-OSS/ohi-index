        <oboInOwl:hasAlternativeId>CHEBI:579539</oboInOwl:hasAlternativeId>
        <oboInOwl:hasAlternativeId>CHEBI:9995</oboInOwl:hasAlternativeId>
        <rdfs:label>viomycin</rdfs:label>
    </owl:Class>
    


