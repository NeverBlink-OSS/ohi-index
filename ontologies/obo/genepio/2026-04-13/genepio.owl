        <obo:IAO_0000115>Individuals who self-identify or are reported by authors as belonging to the Karitiana, an indigenous people of Brazil whose reservation is located in the western Amazon and whose language is part of the Arikém family.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/hancestro.owl"/>
        <oboInOwl:hasExactSynonym>Caritiana</oboInOwl:hasExactSynonym>
        <rdfs:label>Karitiana</rdfs:label>
    </owl:Class>
    


