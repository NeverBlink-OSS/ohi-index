    <!-- http://purl.obolibrary.org/obo/GENEPIO_0001862 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GENEPIO_0001862">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OBI_0001931"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000039"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UO_0000185"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/OBI_0001927"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/OBI_0001620"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/OBI_0002135"/>
                <owl:someValuesFrom>
                    <rdfs:Datatype>
                        <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
                        <owl:withRestrictions rdf:parseType="Collection">
                            <rdf:Description>
                                <xsd:minInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">-90.0</xsd:minInclusive>
                            </rdf:Description>
                            <rdf:Description>
                                <xsd:maxInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">90.0</xsd:maxInclusive>
                            </rdf:Description>
                        </owl:withRestrictions>
                    </rdfs:Datatype>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:GENEPIO_0001920>/^[N+](:&lt;lat&gt;\d(\.\d+)?)$/, $lat
/^S(:&lt;lat&gt;\d(\.\d+)?)$/,  &apos;-&apos; + $lat</obo:GENEPIO_0001920>
        <obo:GENEPIO_1919>/^(:&lt;lat&gt;[-S+N])?(:&lt;degree&gt;[1-8]?[0-9](:&lt;decimal&gt;\.\d{1,6})?)$/, $lat$degree.$decimal
/^(:&lt;lat&gt;[-S+N])?(:&lt;degree&gt;90(:&lt;decimal&gt;\.0{1,6})?))$/, $lat$degree.$decimal</obo:GENEPIO_1919>
        <obo:GENEPIO_1921>/^(\d(\.\d+)?)$/, &apos;+\1&apos;</obo:GENEPIO_1921>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000428"/>
        <obo:IAO_0000115 xml:lang="en">A decimal latitude measurement in degrees in conformance with the ISO 6709 standard.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">This is failing Hermit reasoner since it rejects totalDigits, and fractionDigits: 
&apos;has primitive data type&apos; exactly 1 xsd:decimal[&gt;= -90.0 , &lt;= 90.0 , totalDigits 8 , fractionDigits 6]&apos;</obo:IAO_0000116>
        <obo:IAO_0000117>Damion Dooley</obo:IAO_0000117>
        <rdfs:label xml:lang="en">latitude specification (ISO 6709)</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/GENEPIO_0001863 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GENEPIO_0001863">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OBI_0001931"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000039"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UO_0000185"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/OBI_0001927"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/OBI_0001621"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/OBI_0002135"/>
                <owl:someValuesFrom>
                    <rdfs:Datatype>
                        <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
                        <owl:withRestrictions rdf:parseType="Collection">
                            <rdf:Description>
                                <xsd:minInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">-180.0</xsd:minInclusive>
                            </rdf:Description>
                            <rdf:Description>
                                <xsd:maxInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">180.0</xsd:maxInclusive>
                            </rdf:Description>
                        </owl:withRestrictions>
                    </rdfs:Datatype>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:GENEPIO_1919>/^(:&lt;long&gt;[-W+E])?(:&lt;degree&gt;(1[0-7]|[1-9])?[0-9])(:&lt;decimal&gt;\.\d{1,6})?)$/, $long$degree.$decimal
/^(:&lt;long&gt;[-W+E])?(:&lt;degree&gt;180(:&lt;decimal&gt;\.0{1,6})?)$,$long$degree.$decimal</obo:GENEPIO_1919>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000428"/>
        <obo:IAO_0000115 xml:lang="en">A decimal longitude measurement in degrees in conformance with the ISO 6709 standard.</obo:IAO_0000115>
        <obo:IAO_0000117>Damion Dooley</obo:IAO_0000117>
        <rdfs:label xml:lang="en">longitude specification (ISO 6709)</rdfs:label>
    </owl:Class>
    


