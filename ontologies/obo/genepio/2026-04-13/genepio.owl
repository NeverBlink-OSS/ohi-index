        <obo:GENEPIO_0001763>depth:1</obo:GENEPIO_0001763>
        <obo:GENEPIO_0001763>lookup</obo:GENEPIO_0001763>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000428"/>
        <obo:IAO_0000115 xml:lang="en">A subject disease outcome is an assessment of the persistence of a given disease course in a subject (patient)</obo:IAO_0000115>
        <obo:IAO_0000117 xml:lang="en">Damion Dooley</obo:IAO_0000117>
        <rdfs:comment xml:lang="en">Note that this is closely related to OGMS_0000063 &quot;disease course&quot; that lists chronic, progressive, transient and accute processes.</rdfs:comment>
