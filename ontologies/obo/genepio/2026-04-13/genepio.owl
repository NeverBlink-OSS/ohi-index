        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_1579"/>
        <obo:IAO_0000115 xml:lang="en">A respiratory system disease which involves the upper respiratory tract.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/doid.owl"/>
        <rdfs:label xml:lang="en">upper respiratory tract disease</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/DOID_9801 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_9801">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_404"/>
        <obo:IAO_0000115 xml:lang="en">A gastrointestinal tuberculosis that results_in inflammation located_in peritoneum, which results in formation of tubercles. The infection has_symptom abdominal discomfort, has_symptom pain, has_symptom distention from gas or fluid, has_symptom digestive disturbances and has_symptom emaciation.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/doid.owl"/>
        <rdfs:label xml:lang="en">tuberculous peritonitis</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/DOID_9856 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_9856">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_0080015"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_4166"/>
        <obo:IAO_0000115 xml:lang="en">A syphilis that results_in a multisystem infection in the fetus via the placenta.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/doid.owl"/>
        <rdfs:label xml:lang="en">congenital syphilis</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/DOID_9861 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_9861">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_0050598"/>
        <obo:IAO_0000115 xml:lang="en">An extrapulmonary tuberculosis that results in formation of tiny lesions in all the organs.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/doid.owl"/>
        <rdfs:label xml:lang="en">miliary tuberculosis</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/DOID_9880 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_9880">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_8200"/>
        <obo:IAO_0000115 xml:lang="en">A tertiary syphilis that is manifested as aneurysm formation in the ascending aorta, caused by chronic inflammatory destruction of the vasa vasorum, insufficiency of the aortic valve, or narrowing of the coronary arteries.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/doid.owl"/>
        <rdfs:label xml:lang="en">cardiovascular syphilis</rdfs:label>
    </owl:Class>
    


