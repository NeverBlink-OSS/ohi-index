        <rdfs:label xml:lang="en">high energy food claim</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_03510061 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_03510061">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_03510065"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_03510103"/>
        <obo:IAO_0000115 xml:lang="en">All narrower term definitions extracted from 58 Federal Register 2302, January 6, 1993, part 101.60(c).</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/foodon.owl"/>
        <oboInOwl:hasDbXref rdf:resource="http://www.langual.org/langual_thesaurus.asp?termid=P0061"/>
