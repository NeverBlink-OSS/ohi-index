        <obo:IAO_0000115 xml:lang="en">A record identifier is an identifier for a database entry.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://semanticscience.org/ontology/sio.owl"/>
        <oboInOwl:hasDbXref xml:lang="en">PulseNet: Key</oboInOwl:hasDbXref>
