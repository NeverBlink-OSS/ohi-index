    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_03450004">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_03450002"/>
        <obo:IAO_0000115 xml:lang="en">Cooked at moderate to high levels of heat in which no liquid is added and only small amounts of fat may be added to prevent sticking.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/foodon.owl"/>
        <oboInOwl:hasDbXref>http://www.langual.org/langual_thesaurus.asp?termid=G0004</oboInOwl:hasDbXref>
        <rdfs:label xml:lang="en">cooking by dry heat</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_03450005 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_03450005">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_03450004"/>
        <obo:IAO_0000115 xml:lang="en">Cooked without moisture, covered or uncovered, in an oven.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/foodon.owl"/>
        <oboInOwl:hasDbXref>http://www.langual.org/langual_thesaurus.asp?termid=G0005</oboInOwl:hasDbXref>
        <rdfs:label xml:lang="en">food baking</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_03450006 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_03450006">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_03450004"/>
        <obo:IAO_0000115 xml:lang="en">Cooked without moisture under or over intense direct heat.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/foodon.owl"/>
        <oboInOwl:hasDbXref>http://www.langual.org/langual_thesaurus.asp?termid=G0006</oboInOwl:hasDbXref>
        <rdfs:label xml:lang="en">broiling or grilling</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_03450007 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_03450007">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_03450006"/>
        <obo:IAO_0000115 xml:lang="en">Cooked without moisture over direct heat from a charcoal fire.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/foodon.owl"/>
        <oboInOwl:hasDbXref>http://www.langual.org/langual_thesaurus.asp?termid=G0007</oboInOwl:hasDbXref>
        <rdfs:label xml:lang="en">charcoal broiling</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_03450008 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_03450008">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_03450004"/>
        <obo:IAO_0000115 xml:lang="en">Cooking on a flat surface at medium heat with only a sufficient amount of fat used to prevent sticking.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/foodon.owl"/>
        <oboInOwl:hasDbXref>http://www.langual.org/langual_thesaurus.asp?termid=G0008</oboInOwl:hasDbXref>
        <rdfs:label xml:lang="en">griddle cooking</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_03450009 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_03450009">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_03450004"/>
        <obo:IAO_0000115 xml:lang="en">Cooking by agitating the food over a dry, high heat source, resulting in exploding.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/foodon.owl"/>
        <oboInOwl:hasDbXref>http://www.langual.org/langual_thesaurus.asp?termid=G0009</oboInOwl:hasDbXref>
        <rdfs:label xml:lang="en">cooked by popping</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_03450010 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_03450010">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_03450004"/>
        <obo:IAO_0000115 xml:lang="en">Cooking with direct heat until the surface of the food is browned, usually associated with bread or sandwiches.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/foodon.owl"/>
        <oboInOwl:hasDbXref>http://www.langual.org/langual_thesaurus.asp?termid=G0010</oboInOwl:hasDbXref>
        <rdfs:label xml:lang="en">food toasting</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_03450011 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_03450011">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_03450002"/>
        <obo:IAO_0000115 xml:lang="en">Cooking in a microwave oven.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/foodon.owl"/>
        <oboInOwl:hasDbXref>http://www.langual.org/langual_thesaurus.asp?termid=G0011</oboInOwl:hasDbXref>
        <rdfs:label xml:lang="en">cooking by microwave</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_03450012 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_03450012">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_03450002"/>
        <obo:IAO_0000115 xml:lang="en">Cooking in varying amounts of water, water-based liquid or steam.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/foodon.owl"/>
        <oboInOwl:hasDbXref>http://www.langual.org/langual_thesaurus.asp?termid=G0012</oboInOwl:hasDbXref>
        <rdfs:label xml:lang="en">cooking by moist heat</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_03450013 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_03450013">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_03450012"/>
        <obo:IAO_0000115 xml:lang="en">A process of cooking by moist heat which is effected by hot water or water-based liquid in a container.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/foodon.owl"/>
        <oboInOwl:hasDbXref>http://www.langual.org/langual_thesaurus.asp?termid=G0013</oboInOwl:hasDbXref>
        <rdfs:label xml:lang="en">cooking in water or water-based liquid</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_03450014 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_03450014">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_03450013"/>
        <obo:IAO_0000115 xml:lang="en">A cooking in water or water-based liquid process in which the liquid is boiling.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/foodon.owl"/>
        <oboInOwl:hasDbXref>http://www.langual.org/langual_thesaurus.asp?termid=G0014</oboInOwl:hasDbXref>
        <rdfs:label xml:lang="en">boiling in container</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_03450015 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_03450015">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_03450014"/>
        <obo:IAO_0000115 xml:lang="en">Cooked in boiling water at 212 degrees F.; water that is not absorbed into the food product is discarded after cooking.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/foodon.owl"/>
        <oboInOwl:hasDbXref>http://www.langual.org/langual_thesaurus.asp?termid=G0015</oboInOwl:hasDbXref>
        <rdfs:label xml:lang="en">boiling and then draining</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_03450016 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_03450016">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_03450015"/>
        <obo:IAO_0000115 xml:lang="en">Cooked in boiling water at 212 degrees F. Liquid to solid ratio is greater than 2:1.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/foodon.owl"/>
        <oboInOwl:hasDbXref>http://www.langual.org/langual_thesaurus.asp?termid=G0016</oboInOwl:hasDbXref>
        <rdfs:label xml:lang="en">boiling in large amount of liquid</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_03450017 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_03450017">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_03450015"/>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/foodon.owl"/>
        <oboInOwl:hasDbXref>http://www.langual.org/langual_thesaurus.asp?termid=G0017</oboInOwl:hasDbXref>
        <rdfs:label xml:lang="en">boiling in small amount of liquid</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_03450018 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_03450018">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_03450014"/>
        <obo:IAO_0000115 xml:lang="en">Cooked in boiling water at 212 degrees F. The water incorporates itself into the product being cooked or is not discarded when cooking is complete.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/foodon.owl"/>
        <oboInOwl:hasDbXref>http://www.langual.org/langual_thesaurus.asp?termid=G0018</oboInOwl:hasDbXref>
        <rdfs:label xml:lang="en">boiling without draining</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_03450019 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_03450019">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_03450013"/>
        <obo:IAO_0000115 xml:lang="en">Browned initially in fat and then tightly covered and cooked over low heat in a small amount of water.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/foodon.owl"/>
        <oboInOwl:hasDbXref>http://www.langual.org/langual_thesaurus.asp?termid=G0019</oboInOwl:hasDbXref>
        <rdfs:label xml:lang="en">cooking by braising</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_03450020 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_03450020">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_03450013"/>
        <obo:IAO_0000115 xml:lang="en">Cooking in a moderate amount of liquid at just below the boiling point.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/foodon.owl"/>
        <oboInOwl:hasDbXref>http://www.langual.org/langual_thesaurus.asp?termid=G0020</oboInOwl:hasDbXref>
        <rdfs:label xml:lang="en">cooking by simmering</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_03450021 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_03450021">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_03450012"/>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/foodon.owl"/>
        <oboInOwl:hasDbXref>http://www.langual.org/langual_thesaurus.asp?termid=G0021</oboInOwl:hasDbXref>
        <rdfs:label xml:lang="en">cooking in steam</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_03450022 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_03450022">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_03450021"/>
        <obo:IAO_0000115 xml:lang="en">Cooked in a pressure cooker.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/foodon.owl"/>
        <oboInOwl:hasDbXref>http://www.langual.org/langual_thesaurus.asp?termid=G0022</oboInOwl:hasDbXref>
        <rdfs:label xml:lang="en">steaming with pressure</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_03450023 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_03450023">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_03450021"/>
        <obo:IAO_0000115 xml:lang="en">Cooked suspended above boiling water.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/foodon.owl"/>
        <oboInOwl:hasDbXref>http://www.langual.org/langual_thesaurus.asp?termid=G0023</oboInOwl:hasDbXref>
        <rdfs:label xml:lang="en">steaming without pressure</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_03450024 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_03450024">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_03450002"/>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/foodon.owl"/>
        <oboInOwl:hasDbXref>http://www.langual.org/langual_thesaurus.asp?termid=G0024</oboInOwl:hasDbXref>
        <rdfs:label xml:lang="en">cooking with fat or oil</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_03450025 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_03450025">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_03450024"/>
        <obo:IAO_0000115 xml:lang="en">Cooked by adding fat or oil to those foods that do not contain fat or oil that would render during the cooking process.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/foodon.owl"/>
        <oboInOwl:hasDbXref>http://www.langual.org/langual_thesaurus.asp?termid=G0025</oboInOwl:hasDbXref>
        <rdfs:label xml:lang="en">cooking with added fat or oil</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_03450026 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_03450026">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_03450025"/>
        <obo:IAO_0000115 xml:lang="en">Cooked with sufficient fat or oil to coat and moisten the food being prepared, but not cooked in enough fat or oil to immerse the food.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/foodon.owl"/>
        <oboInOwl:hasDbXref>http://www.langual.org/langual_thesaurus.asp?termid=G0026</oboInOwl:hasDbXref>
        <rdfs:label xml:lang="en">cooking in small amount of fat or oil</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_03450027 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_03450027">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_03450026"/>
        <obo:IAO_0000115 xml:lang="en">Cooking in a very small amount of very hot fat, turning and browning the food on all sides.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/foodon.owl"/>
        <oboInOwl:hasDbXref>http://www.langual.org/langual_thesaurus.asp?termid=G0027</oboInOwl:hasDbXref>
        <rdfs:label xml:lang="en">sautéing</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_03450028 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_03450028">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_03450026"/>
        <obo:IAO_0000115 xml:lang="en">Cooked by frying foods quickly over high heat, stirring constantly. Only enough cooking oil is used to coat the bottom of the pan.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/foodon.owl"/>
        <oboInOwl:hasDbXref>http://www.langual.org/langual_thesaurus.asp?termid=G0028</oboInOwl:hasDbXref>
        <rdfs:label xml:lang="en">stir-frying</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_03450029 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_03450029">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_03450025"/>
        <obo:IAO_0000115 xml:lang="en">Cooked in hot fat or oil deep enough to immerse the food entirely.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/foodon.owl"/>
        <oboInOwl:hasDbXref>http://www.langual.org/langual_thesaurus.asp?termid=G0029</oboInOwl:hasDbXref>
        <rdfs:label xml:lang="en">deep-frying process</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_03450030 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_03450030">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_03450024"/>
        <obo:IAO_0000115 xml:lang="en">Cooked in fat or oil rendered from the food being prepared.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/foodon.owl"/>
        <oboInOwl:hasDbXref>http://www.langual.org/langual_thesaurus.asp?termid=G0030</oboInOwl:hasDbXref>
        <rdfs:label xml:lang="en">cooking with inherent fat or oil</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_03450031 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_03450031">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_03450032"/>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/foodon.owl"/>
        <oboInOwl:hasDbXref>http://www.langual.org/langual_thesaurus.asp?termid=G0031</oboInOwl:hasDbXref>
        <rdfs:label xml:lang="en">heating container by immersion in water or steam</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_03450032 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_03450032">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_03450002"/>
        <obo:IAO_0000115 xml:lang="en">A food cooking method in which heat is transferred to the outside of a container.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/foodon.owl"/>
        <oboInOwl:hasDbXref>http://www.langual.org/langual_thesaurus.asp?termid=G0032</oboInOwl:hasDbXref>
        <rdfs:label xml:lang="en">heating container</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_03450033 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_03450033">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_03450032"/>
        <obo:IAO_0000115 xml:lang="en">Heating a container that is placed in another container filled with boiling water.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/foodon.owl"/>
        <oboInOwl:hasDbXref>http://www.langual.org/langual_thesaurus.asp?termid=G0033</oboInOwl:hasDbXref>
        <rdfs:label xml:lang="en">heating container in double boiler</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_03450034 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_03450034">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_03450032"/>
        <obo:IAO_0000115 xml:lang="en">Heating a container that is placed in another container filled with water kept near the boiling point.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/foodon.owl"/>
        <oboInOwl:hasDbXref>http://www.langual.org/langual_thesaurus.asp?termid=G0034</oboInOwl:hasDbXref>
        <rdfs:label xml:lang="en">heating container by water bath</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_03450035 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_03450035">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_03450025"/>
        <obo:IAO_0000115 xml:lang="en">A chinese cooking technique similar to sauteing in which thick slices or chunks of floured or battered ingredients are slow seared over moderate to low heat.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/foodon.owl"/>
        <oboInOwl:hasDbXref>http://www.langual.org/langual_thesaurus.asp?termid=G0035</oboInOwl:hasDbXref>
        <rdfs:label xml:lang="en">shallow frying process</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_03450036 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_03450036">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_03450013"/>
        <obo:IAO_0000115 xml:lang="en">Extracting flavor and other components from food sources by immersion in water, usually at near-boiling temperature.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/foodon.owl"/>
        <oboInOwl:hasDbXref>http://www.langual.org/langual_thesaurus.asp?termid=G0036</oboInOwl:hasDbXref>
        <rdfs:label xml:lang="en">steeping</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_03450037 -->

