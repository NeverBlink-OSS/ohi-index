        <oboInOwl:hasExactSynonym>Hematological Disorder</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Hematopoietic and Lymphoid Cell Disorder</oboInOwl:hasExactSynonym>
        <rdfs:label>Hematopoietic and Lymphoid Cell Disorder</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C26324 -->

