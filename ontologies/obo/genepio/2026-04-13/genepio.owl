        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/GENEPIO_0002047 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GENEPIO_0002047">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/COB_0001300"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000428"/>
        <obo:IAO_0000115 xml:lang="en">The commercial kit or product used to determine the MIC e.g. E-Test. If a commercial product was not used, include the type of media used.</obo:IAO_0000115>
        <obo:IAO_0000117 xml:lang="en">Damion Dooley</obo:IAO_0000117>
        <rdfs:label xml:lang="en">antimicrobial resistance testing method device or reagent</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/GENEPIO_0002048 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GENEPIO_0002048">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GENEPIO_0002036"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000428"/>
        <obo:IAO_0000117 xml:lang="en"></obo:IAO_0000117>
        <rdfs:label xml:lang="en">antimicrobial resistant plasmid type</rdfs:label>
    </owl:Class>
    


