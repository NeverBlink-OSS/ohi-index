        <oboInOwl:hasExactSynonym>Sex Designation</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Sex Parameter for Clinical Use</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Sex for Clinical Use</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>sex</oboInOwl:hasExactSynonym>
        <rdfs:label>Sex</rdfs:label>
    </owl:Class>
    


