        <obo:GENEPIO_0000006 xml:lang="en">ongoing pregnancy</obo:GENEPIO_0000006>
        <obo:IAO_0000115>The state of a female and/or her offspring, and the processes which occur, during the period from conception to birth or termination of the pregnancy.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/xco.owl"/>
        <rdfs:label>gestation</rdfs:label>
    </owl:Class>
    


