    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OBI_0000648">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000100"/>
        <obo:IAO_0000111>clustered data set</obo:IAO_0000111>
