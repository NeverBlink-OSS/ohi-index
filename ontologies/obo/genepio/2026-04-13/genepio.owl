        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GENEPIO_0100636"/>
        <obo:GENEPIO_0000162 xml:lang="en">PCDS: The name of the organization that performed the antimicrobial resistance testing.</obo:GENEPIO_0000162>
        <obo:IAO_0000112>PCDS: Canadian Food Inspection Agency (CFIA) [GENEPIO:0100552]</obo:IAO_0000112>
        <obo:IAO_0000114>metadata incomplete</obo:IAO_0000114>
        <obo:IAO_0000115 xml:lang="en">A data field which describes the name of the organization that performed the antimicrobial resistance (AMR) testing.</obo:IAO_0000115>
