        <oboInOwl:hasExactSynonym xml:lang="en">SRA accession slot</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Sequence Read Archive accession field</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Sequence Read Archive accession slot</oboInOwl:hasExactSynonym>
        <rdfs:comment xml:lang="en">PCDS: Store the accession assigned to the submitted &apos;run&apos;. NCBI-SRA accessions start with SRR.</rdfs:comment>
        <rdfs:label xml:lang="en">sra accession</rdfs:label>
    </owl:Class>
    


