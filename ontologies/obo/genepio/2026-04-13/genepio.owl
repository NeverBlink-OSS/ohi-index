    <!-- http://purl.obolibrary.org/obo/FOODON_03480020 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_03480020">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_00003368"/>
        <obo:GENEPIO_0000006 xml:lang="en">food packing medium</obo:GENEPIO_0000006>
        <obo:IAO_0000115 xml:lang="en">The medium in which the food is packed for preservation and handling or the medium surrounding homemade foods, e.g., peaches cooked in sugar syrup. The packing medium may provide a controlled environment for the food. It may also serve to improve palatability and consumer appeal.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/foodon.owl"/>
        <oboInOwl:hasDbXref rdf:resource="http://www.langual.org/langual_thesaurus.asp?termid=K0020"/>
        <rdfs:label xml:lang="en">food packing medium</rdfs:label>
    </owl:Class>
    


