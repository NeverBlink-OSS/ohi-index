    <!-- http://purl.obolibrary.org/obo/GENEPIO_0001736 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GENEPIO_0001736">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GENEPIO_0001626"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GENEPIO_0100586"/>
        <obo:GENEPIO_0000162 xml:lang="en">PCDS: The measured pH value indicating the acidity or basicity(alkalinity) of an aqueous solution.</obo:GENEPIO_0000162>
        <obo:IAO_0000112>PCDS: 7.4</obo:IAO_0000112>
        <obo:IAO_0000114>metadata incomplete</obo:IAO_0000114>
        <obo:IAO_0000115 xml:lang="en">A data field which describes the DataHarmonizer software and template version provenance.</obo:IAO_0000115>
        <obo:IAO_0000115 xml:lang="en">In chemistry, pH is a numeric scale used to specify the acidity or basicity(alkalinity) of an aqueous solution</obo:IAO_0000115>
        <obo:IAO_0000117 xml:lang="en">Damion Dooley</obo:IAO_0000117>
        <obo:IAO_0000118 xml:lang="en">PCDS:ph_measurement_value</obo:IAO_0000118>
        <obo:IAO_0000119 xml:lang="en">Wikipedia</obo:IAO_0000119>
        <dcterms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-04-13T17:18:02.461Z</dcterms:date>
        <rdfs:comment xml:lang="en">Normally falls within the bounds of 0 - 14</rdfs:comment>
        <rdfs:comment xml:lang="en">PCDS: Provide the numerical value of the measured pH.</rdfs:comment>
        <rdfs:label xml:lang="en">pH measurement</rdfs:label>
        <rdfs:label xml:lang="en">ph measurement value</rdfs:label>
    </owl:Class>
    


