        <rdfs:label xml:lang="en">polychotomous variable</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/STATO_0000090 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/STATO_0000090">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/STATO_0000087"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000115 xml:lang="en">a dichotomous variable  is a categorical variable  which is defined to have only 2 categories or possible values</obo:IAO_0000115>
        <obo:IAO_0000117 xml:lang="en">Alejandra Gonzalez-Beltran</obo:IAO_0000117>
        <obo:IAO_0000117>Orlaith Burke</obo:IAO_0000117>
        <obo:IAO_0000117 xml:lang="en">Philippe Rocca-Serra</obo:IAO_0000117>
        <obo:IAO_0000119 xml:lang="en">AGB-PRS</obo:IAO_0000119>
        <obo:IAO_0000119 xml:lang="en">http://udel.edu/~mcdonald/statvartypes.html</obo:IAO_0000119>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/stato.owl"/>
        <rdfs:comment>&apos;has part&apos; exactly 1 (&apos;categorical measurement datum&apos;
 and (&apos;has category label&apos; exactly 2 &apos;categorical label&apos;))</rdfs:comment>
        <rdfs:label xml:lang="en">dichotomous variable</rdfs:label>
    </owl:Class>
    


