        <oboInOwl:hasBroadSynonym xml:lang="en">related specimen primary identifier</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">related specimen primary ID slot</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">related specimen primary identifier field</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">related specimen primary identifier slot</oboInOwl:hasExactSynonym>
        <rdfs:comment xml:lang="en">PCDS: Store the primary ID of the related specimen previously submitted to the National Microbiology Laboratory so that the samples can be linked and tracked through the system.</rdfs:comment>
        <rdfs:label xml:lang="en">related specimen primary id</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/GENEPIO_0001131 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GENEPIO_0001131">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GENEPIO_0001644"/>
        <obo:GENEPIO_0000162 xml:lang="en">PCDS: The identifier assigned to a sequenced isolate in IRIDA.</obo:GENEPIO_0000162>
        <obo:IAO_0000112>PCDS: prov_rona_99</obo:IAO_0000112>
        <obo:IAO_0000114>metadata incomplete</obo:IAO_0000114>
        <obo:IAO_0000115 xml:lang="en">An identifier field which describes the identifer assigned to a sequenced isolate in Integrated Rapid Infectious Disease Analysis (IRIDA) bioinformatics platform.</obo:IAO_0000115>
        <obo:IAO_0000118 xml:lang="en">PCDS:irida_sample_name</obo:IAO_0000118>
        <dcterms:contributor rdf:resource="https://orcid.org/0000-0002-1107-9135"/>
        <dcterms:contributor rdf:resource="https://orcid.org/0000-0002-8844-9165"/>
        <dcterms:contributor rdf:resource="https://orcid.org/0000-0002-9578-0788"/>
        <dcterms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-04-24T00:42:14Z</dcterms:date>
        <oboInOwl:hasBroadSynonym xml:lang="en">IRIDA sample identifier</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasBroadSynonym xml:lang="en">IRIDA sample name</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">IRIDA sample ID</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">IRIDA sample identifier</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">IRIDA sample name</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Integrated Rapid Infectious Disease Analysis sample ID</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Integrated Rapid Infectious Disease Analysis sample identifier</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Integrated Rapid Infectious Disease Analysis sample name</oboInOwl:hasExactSynonym>
        <rdfs:comment xml:lang="en">PCDS: Store the IRIDA sample name. The IRIDA sample name will be created by the individual entering data into the IRIDA platform. IRIDA samples may be linked to metadata and sequence data, or just metadata alone. It is recommended that the IRIDA sample name be the same as, or contain, the specimen collector sample ID for better traceability. It is also recommended that the IRIDA sample name mirror the GISAID accession. IRIDA sample names cannot contain slashes. Slashes should be replaced by underscores. See IRIDA documentation for more information regarding special characters (https://irida.corefacility.ca/documentation/user/user/samples/#adding-a-new-sample).</rdfs:comment>
        <rdfs:label xml:lang="en">IRIDA sample ID</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/GENEPIO_0001133 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GENEPIO_0001133">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GENEPIO_0001644"/>
        <obo:GENEPIO_0000162 xml:lang="en">PCDS: The INSDC accession number assigned to the umbrella BioProject.</obo:GENEPIO_0000162>
        <obo:IAO_0000112>PCDS: PRJNA623807</obo:IAO_0000112>
        <obo:IAO_0000114>metadata incomplete</obo:IAO_0000114>
        <obo:IAO_0000115 xml:lang="en">An identifier field which describes the International Nucleotide Sequence Database Collaboration (INSDC) umbrella accession number of the BioProject to which the BioSample belongs.</obo:IAO_0000115>
        <obo:IAO_0000118 xml:lang="en">PCDS:umbrella_bioproject_accession</obo:IAO_0000118>
        <dcterms:contributor rdf:resource="https://orcid.org/0000-0002-1107-9135"/>
        <dcterms:contributor rdf:resource="https://orcid.org/0000-0002-8844-9165"/>
        <dcterms:contributor rdf:resource="https://orcid.org/0000-0002-9578-0788"/>
        <dcterms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-04-24T00:42:14Z</dcterms:date>
        <oboInOwl:hasBroadSynonym xml:lang="en">umbrella bioproject accession</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">umbrella bioproject accession slot</oboInOwl:hasExactSynonym>
        <rdfs:comment xml:lang="en">PCDS: Required if submission is linked to an umbrella BioProject. An umbrella BioProject links together related BioProjects. A valid BioProject umbrella accession has prefix PRJN, PRJE or PRJD. Your laboratory can have one or many BioProjects.</rdfs:comment>
        <rdfs:label xml:lang="en">umbrella bioproject accession</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/GENEPIO_0001136 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GENEPIO_0001136">
