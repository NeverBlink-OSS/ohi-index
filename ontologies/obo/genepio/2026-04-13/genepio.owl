        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0000083"/>
        <obo:IAO_0000115>Functional anomaly of the kidney persisting for at least three months.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/hp.owl"/>
        <oboInOwl:hasAlternativeId>HP:0000106</oboInOwl:hasAlternativeId>
        <oboInOwl:hasAlternativeId>HP:0001918</oboInOwl:hasAlternativeId>
