    </owl:Class>
    


    <!-- http://snomed.info/sct/22642004 -->

    <owl:Class rdf:about="http://snomed.info/sct/22642004">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OBI_0000070"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000428"/>
        <obo:IAO_0000115 xml:lang="en">An assay for detecting bacteria by subjecting them to strain-specific bacteriophages.</obo:IAO_0000115>
