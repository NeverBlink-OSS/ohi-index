        <obo:IAO_0000115 xml:lang="en">A Uniform Resource Locator or Universal Resource Locator (URL) is a specific character string that constitutes a reference to an Internet resource.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://semanticscience.org/ontology/sio.owl"/>
        <rdfs:label xml:lang="en">URL</rdfs:label>
    </owl:Class>
    


