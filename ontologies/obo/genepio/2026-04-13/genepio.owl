        <rdfs:comment xml:lang="en">NCBI lists project data type and other controlled vocabulary fields at : https://www.ncbi.nlm.nih.gov/books/NBK54364/</rdfs:comment>
        <rdfs:label xml:lang="en">NCBI BioProject standard</rdfs:label>
    </owl:Class>
