        <obo:IAO_0000115>Constipation of sudden onset and lasting for less than three months.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/hp.owl"/>
        <oboInOwl:hasDbXref>SNOMEDCT_US:197119006</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS:C0401148</oboInOwl:hasDbXref>
        <rdfs:label>Acute constipation</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/HP_0012531 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0012531">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0025142"/>
        <obo:IAO_0000115>An unpleasant sensory and emotional experience associated with actual or potential tissue damage, or described in terms of such damage.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/hp.owl"/>
        <oboInOwl:hasDbXref>SNOMEDCT_US:22253000</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS:C0030193</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>Pain</oboInOwl:hasExactSynonym>
        <rdfs:label>Pain</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/HP_0012614 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0012614">
