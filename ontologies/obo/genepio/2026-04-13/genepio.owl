    <!-- http://purl.obolibrary.org/obo/UBERON_0009778 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0009778">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0005906"/>
