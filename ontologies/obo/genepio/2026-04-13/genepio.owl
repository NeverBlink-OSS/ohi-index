    <!-- http://purl.obolibrary.org/obo/UBERON_0015865 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0015865">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0015860"/>
        <obo:IAO_0000115>Lymph nodes of the pancreatic tail and spleen, receiving afferents from both organs plus the greater curvature of the stomach; they drain to the celiac lymph nodes.</obo:IAO_0000115>
