    <!-- http://purl.obolibrary.org/obo/GENEPIO_0001765 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GENEPIO_0001765">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GENEPIO_0000091"/>
        <obo:IAO_0000115 xml:lang="en">Standard draft: describing the minimum information needed for submission to a public database.</obo:IAO_0000115>
        <obo:IAO_0000117>Damion Dooley</obo:IAO_0000117>
        <rdfs:label xml:lang="en">1 - standard draft</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/GENEPIO_0001766 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GENEPIO_0001766">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GENEPIO_0000091"/>
        <obo:IAO_0000115 xml:lang="en">High quality draft: describing sequences with little to no manual review.</obo:IAO_0000115>
        <obo:IAO_0000117>Damion Dooley</obo:IAO_0000117>
        <rdfs:label xml:lang="en">2 - high quality draft</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/GENEPIO_0001767 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GENEPIO_0001767">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GENEPIO_0000091"/>
        <obo:IAO_0000115 xml:lang="en">Improved high quality draft: in which data is either reviewed by people or machines to some extent to indicate that most of the genetic data is assembled correctly, but some errors may still be present.</obo:IAO_0000115>
        <obo:IAO_0000117>Damion Dooley</obo:IAO_0000117>
        <rdfs:label xml:lang="en">3 - improved high quality draft</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/GENEPIO_0001768 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GENEPIO_0001768">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GENEPIO_0000091"/>
        <obo:IAO_0000115 xml:lang="en">Annotation-directed improvement: in which genetic information in various gene regions is represented as accurately as possible.</obo:IAO_0000115>
        <obo:IAO_0000117>Damion Dooley</obo:IAO_0000117>
        <rdfs:label xml:lang="en">4 - annotation-directed improvement</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/GENEPIO_0001769 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GENEPIO_0001769">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GENEPIO_0000091"/>
        <obo:IAO_0000115 xml:lang="en">Non-contiguous finished: which includes sequences that have been reviewed by both people and machines and would be considered complete except for “recalcitrant regions” that are proving problematic for genome closure.</obo:IAO_0000115>
        <obo:IAO_0000117>Damion Dooley</obo:IAO_0000117>
        <rdfs:label xml:lang="en">5 - non-contiguous finished</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/GENEPIO_0001770 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GENEPIO_0001770">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GENEPIO_0000091"/>
        <obo:IAO_0000115 xml:lang="en">Finished: which describes un-gapped complete sequences that have minimal errors, if any. The biology of the microbe will determine whether this finished genome consists of more than one chromosome.</obo:IAO_0000115>
        <obo:IAO_0000117>Damion Dooley</obo:IAO_0000117>
        <rdfs:label xml:lang="en">6 - finished</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/GENEPIO_0001771 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GENEPIO_0001771">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GENEPIO_0001632"/>
        <obo:GENEPIO_0000001 xml:lang="en">Assembly QC</obo:GENEPIO_0000001>
        <obo:IAO_0000114 xml:lang="en">http://purl.obolibrary.org/obo/IAO_0000428</obo:IAO_0000114>
        <obo:IAO_0000115 xml:lang="en">The NG99 length is the same as the N99 length except that the length of the reference genome is used in the calculation rather than the sum of assembly contig lengths.</obo:IAO_0000115>
        <obo:IAO_0000117 xml:lang="en">Damion Dooley</obo:IAO_0000117>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/genepio/core_slim.owl"/>
        <rdfs:label xml:lang="en">contig NG99</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/GENEPIO_0001773 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GENEPIO_0001773">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GENEPIO_0000093"/>
        <obo:GENEPIO_0000001>Assembly QC</obo:GENEPIO_0000001>
        <obo:IAO_0000114>http://purl.obolibrary.org/obo/IAO_0000428</obo:IAO_0000114>
        <obo:IAO_0000115 xml:lang="en">An assembly quality control datum which is defined as number of contigs equal to or longer than the contig N50, when the genome size is factored into the calculation.</obo:IAO_0000115>
        <obo:IAO_0000117 xml:lang="en">Damion Dooley</obo:IAO_0000117>
        <rdfs:label xml:lang="en">contig LG50</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/GENEPIO_0001774 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GENEPIO_0001774">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GENEPIO_0000093"/>
        <obo:GENEPIO_0000001>Assembly QC</obo:GENEPIO_0000001>
        <obo:IAO_0000114>http://purl.obolibrary.org/obo/IAO_0000428</obo:IAO_0000114>
        <obo:IAO_0000115 xml:lang="en">Contig L99 is the number of contigs equal to or longer than contig N99. The length of the assembly itself is used in the calculation.</obo:IAO_0000115>
        <obo:IAO_0000117 xml:lang="en">Damion Dooley</obo:IAO_0000117>
        <rdfs:label xml:lang="en">contig L99</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/GENEPIO_0001775 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GENEPIO_0001775">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GENEPIO_0001610"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000428"/>
        <obo:IAO_0000115 xml:lang="en">A subject age at time of specimen extraction is the age (since birth) of the organism at the time a given specimen was extracted.</obo:IAO_0000115>
        <obo:IAO_0000117 xml:lang="en">Damion Dooley</obo:IAO_0000117>
        <rdfs:label xml:lang="en">subject age at time of specimen collection</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/GENEPIO_0001776 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GENEPIO_0001776">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GENEPIO_0000143"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000428"/>
        <obo:IAO_0000117 xml:lang="en">A public health related data standard involving a particular species of pathogen.</obo:IAO_0000117>
        <obo:IAO_0000117 xml:lang="en">Damion Dooley</obo:IAO_0000117>
        <rdfs:label xml:lang="en">pathogen specific data standard</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/GENEPIO_0001777 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GENEPIO_0001777">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GENEPIO_0000106"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000123"/>
        <obo:IAO_0000115 xml:lang="en">The draft tuberculosis contextual data standard is a data standard for the collection of contextual information of a given tuberculosis case that pertain to typing, clinical treatment, and potential research questions.</obo:IAO_0000115>
        <obo:IAO_0000117>Damion Dooley</obo:IAO_0000117>
        <rdfs:label xml:lang="en">draft tuberculosis contextual data standard</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/GENEPIO_0001778 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GENEPIO_0001778">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GENEPIO_0000106"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000428"/>
        <obo:IAO_0000115 xml:lang="en">The PulseNet Canada Salmonella submission standard details the fields required in a PuseNet Canada pathogen submission report for Salmonella in spreadsheet format</obo:IAO_0000115>
        <obo:IAO_0000117>Damion Dooley</obo:IAO_0000117>
        <rdfs:label xml:lang="en">draft PulseNet Canada Salmonella submission standard</rdfs:label>
        <rdfs:seeAlso>http://www.pulsenetinternational.org/assets/PulseNet/uploads/wgs/PND18-NCBI-Biosample-Submission.pdf</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/GENEPIO_0001779 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GENEPIO_0001779">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GENEPIO_0001289"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000136"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/GENEPIO_0001710"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A PFGE pattern resulting from DNA fragmentation induced by the Xbal enzyme.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="http://orcid.org/0000-0002-8844-9165"/>
        <rdfs:label xml:lang="en">PFGE Xbal pattern</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/GENEPIO_0001780 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GENEPIO_0001780">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GENEPIO_0001289"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000136"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/GENEPIO_0001713"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A PFGE pattern resulting from DNA fragmentation induced by the Blnl enzyme.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="http://orcid.org/0000-0002-8844-9165"/>
        <rdfs:label xml:lang="en">PFGE Blnl pattern</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/GENEPIO_0001781 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GENEPIO_0001781">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OBI_0001616"/>
        <obo:GENEPIO_0000006 xml:lang="en">NLEP ID</obo:GENEPIO_0000006>
        <obo:IAO_0000115 xml:lang="en">An NLEP ID is a unique identifier code for a sample registered with the Canadian &quot;National Laboratory for Enteric Pathogens&quot; (NLEP)</obo:IAO_0000115>
        <obo:IAO_0000117>Damion Dooley</obo:IAO_0000117>
        <obo:IAO_0000119 xml:lang="en">Pulsenet Canada spreadsheet.</obo:IAO_0000119>
        <rdfs:label xml:lang="en">National Laboratory for Enteric Pathogens Identifier</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/GENEPIO_0001782 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GENEPIO_0001782">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GENEPIO_0001491"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/GENEPIO_0001739"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/GENEPIO_0000024"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:GENEPIO_0000005>PulseNet spreadsheet</obo:GENEPIO_0000005>
        <obo:IAO_0000115 xml:lang="en">Date an uploaded sample was re-uploaded or had its metadata modified.</obo:IAO_0000115>
        <obo:IAO_0000117>Damion Dooley</obo:IAO_0000117>
        <oboInOwl:hasDbXref>PulseNet: UploadModifiedDate</oboInOwl:hasDbXref>
        <rdfs:label xml:lang="en">upload modified date</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/GENEPIO_0001783 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GENEPIO_0001783">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GENEPIO_0001058"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000428"/>
        <obo:IAO_0000115 xml:lang="en">A travel destination is a destination city (or populated place of some scale) which a given human has travelled to on a particular trip.</obo:IAO_0000115>
        <obo:IAO_0000117>Damion Dooley</obo:IAO_0000117>
        <rdfs:label xml:lang="en">travel destination</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/GENEPIO_0001784 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GENEPIO_0001784">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GENEPIO_0001258"/>
        <rdfs:subClassOf rdf:resource="http://www.ebi.ac.uk/efo/EFO_0000433"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000428"/>
        <obo:IAO_0000115 xml:lang="en">A symptom duration is a date-time entity which is the duration (in hours or days or weeks etc.) that one or more symptoms persist for in a particular human or animal</obo:IAO_0000115>
        <obo:IAO_0000117>Damion Dooley</obo:IAO_0000117>
        <rdfs:comment xml:lang="en">This may be a calculated field if symptoms are reported to cease on a particular date.  Often however symptom duration is reported more generally as a date or time range since cesation date is less certain.</rdfs:comment>
        <rdfs:label xml:lang="en">symptom duration</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/GENEPIO_0001785 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GENEPIO_0001785">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GENEPIO_0002162"/>
        <rdfs:subClassOf rdf:nodeID="genid224"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000428"/>
        <obo:IAO_0000115 xml:lang="en">The city where a specimen was collected (taken) from a subject or environment</obo:IAO_0000115>
        <obo:IAO_0000117>Damion Dooley</obo:IAO_0000117>
        <rdfs:label xml:lang="en">specimen collection location - city</rdfs:label>
    </owl:Class>
    <owl:Restriction rdf:nodeID="genid224">
        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/OBI_0001927"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/NCIT_C80234"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/GENEPIO_0001785"/>
