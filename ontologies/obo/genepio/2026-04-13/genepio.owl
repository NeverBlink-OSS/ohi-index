        <obo:IAO_0000115 xml:lang="en">The Integrated Taxonomic Information System (ITIS) contains authoritative taxonomic information on plants, animals, fungi, and microbes of North America and the world.</obo:IAO_0000115>
        <obo:IAO_0000117>Damion Dooley</obo:IAO_0000117>
