    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GENEPIO_0001538">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GENEPIO_0001537"/>
        <obo:IAO_0000115 xml:lang="en">An exposed person role is the role a person takes on who has been exposed to a pathogen.  In serious situations this may call for special treatment, e.g. quarantine.</obo:IAO_0000115>
        <obo:IAO_0000117>Damion Dooley</obo:IAO_0000117>
        <rdfs:label xml:lang="en">exposed person role</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/GENEPIO_0001541 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GENEPIO_0001541">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GENEPIO_0001537"/>
        <obo:IAO_0000231>Redundant with &quot;term replaced by&quot; entity.</obo:IAO_0000231>
        <obo:IAO_0100001 rdf:resource="http://purl.obolibrary.org/obo/GENEPIO_0100269"/>
        <rdfs:label xml:lang="en">obsolete: parent-guardian role</rdfs:label>
        <rdfs:label xml:lang="en">parent-guardian role</rdfs:label>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    </owl:Class>
    


