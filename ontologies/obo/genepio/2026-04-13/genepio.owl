    <!-- http://purl.obolibrary.org/obo/GENEPIO_0001818 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GENEPIO_0001818">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MI_0489"/>
