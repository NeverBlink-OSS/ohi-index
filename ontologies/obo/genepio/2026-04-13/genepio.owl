        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/GENEPIO_0001787 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GENEPIO_0001787">
