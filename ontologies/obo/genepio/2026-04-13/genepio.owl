        <obo:IAO_0000117 xml:lang="en">Damion Dooley</obo:IAO_0000117>
        <obo:IAO_0000119>https://www.ncbi.nlm.nih.gov/books/NBK54364/</obo:IAO_0000119>
        <rdfs:label xml:lang="en">other specimen scope</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/GENEPIO_0000012 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GENEPIO_0000012">
