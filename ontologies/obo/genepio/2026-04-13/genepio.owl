    <!-- http://purl.obolibrary.org/obo/NCIT_C26323 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NCIT_C26323">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NCIT_C35814"/>
        <obo:IAO_0000115>A non-neoplastic or neoplastic disorder that arises from the hematopoietic and lymphoid cells. Representative examples include disorders that affect the synthesis of hemoglobin, coagulation disorders, leukemias, and lymphomas.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/ncit.owl"/>
