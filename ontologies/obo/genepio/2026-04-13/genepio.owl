    <!-- http://purl.obolibrary.org/obo/GENEPIO_0001625 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GENEPIO_0001625">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GENEPIO_0002018"/>
        <obo:IAO_0000115 xml:lang="en">A subject disease stage is a measure of the acuteness of a subject organism&apos;s diagnosed disease, if any, at a given time in an investigation, study or specimen extraction event.</obo:IAO_0000115>
        <obo:IAO_0000117 xml:lang="en">Damion Dooley</obo:IAO_0000117>
