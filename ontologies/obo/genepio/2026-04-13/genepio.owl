        <oboInOwl:hasExactSynonym>Late Fetal Death</oboInOwl:hasExactSynonym>
        <rdfs:label>Late Fetal Death</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C113122 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NCIT_C113122">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OBI_0002088"/>
        <obo:IAO_0000115>A test tube, capillary tube, or other tube designed for the collection of blood.</obo:IAO_0000115>
