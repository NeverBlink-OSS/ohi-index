        <obo:IAO_0000117>https://orcid.org/0000-0002-1107-9135</obo:IAO_0000117>
        <obo:IAO_0000117>https://orcid.org/0000-0002-9578-0788</obo:IAO_0000117>
        <obo:IAO_0000118> contig identifier</obo:IAO_0000118>
        <obo:IAO_0000118>contig ID </obo:IAO_0000118>
