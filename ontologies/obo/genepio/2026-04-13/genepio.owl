    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GENEPIO_0001009">
        <obo:IAO_0000115 xml:lang="en">A restaurant or an eatery, is a business which prepares and serves food and drinks to customers in exchange for money.</obo:IAO_0000115>
