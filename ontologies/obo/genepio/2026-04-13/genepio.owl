    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C91108 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NCIT_C91108">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NCIT_C17600"/>
