    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GENEPIO_0001008">
        <obo:IAO_0100001>http://purl.obolibrary.org/obo/GENEPIO_0001007</obo:IAO_0100001>
        <rdfs:label xml:lang="en">obsolete: NCBI isolate AMR testing model</rdfs:label>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    </owl:Class>
    


