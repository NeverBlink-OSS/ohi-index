    </rdf:Description>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/UO_0010040">
        <obo:IAO_0000115>A metric teaspoon is a unit of measurement of volume widely used in cooking recipes and pharmaceutic prescriptions. It equals a 5mL volume.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/uo.owl"/>
        <oboInOwl:hasExactSynonym>metric teaspoon</oboInOwl:hasExactSynonym>
