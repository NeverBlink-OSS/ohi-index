    <!-- http://purl.obolibrary.org/obo/GENEPIO_0100586 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GENEPIO_0100586">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000027"/>
        <obo:IAO_0000112 xml:lang="en">The &quot;specimen collector sample ID&quot; is where one can store sample identifiers given by the specimen collector.</obo:IAO_0000112>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000428"/>
        <obo:IAO_0000114>to be replace with external ontology term</obo:IAO_0000114>
