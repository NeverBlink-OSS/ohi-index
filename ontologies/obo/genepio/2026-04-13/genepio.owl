                                <xsd:pattern>(1/2|1/2a|1/2b|1/2c|3a|3b|3c|4a|4ab|4b|4c|4d|4e|1|7)</xsd:pattern>
                            </rdf:Description>
                        </owl:withRestrictions>
                    </rdfs:Datatype>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">listeria antigen specification</rdfs:label>
    </owl:Class>
    


