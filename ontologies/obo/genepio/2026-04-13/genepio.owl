        <rdfs:label xml:lang="en">pre-existing condition</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/GENEPIO_0001550 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GENEPIO_0001550">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GENEPIO_0001812"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/GENEPIO_0001739"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/GENEPIO_0002026"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000428"/>
        <obo:IAO_0000115 xml:lang="en">To restore to the normal state after some pathologic process.</obo:IAO_0000115>
        <obo:IAO_0000117>Damion Dooley</obo:IAO_0000117>
        <obo:IAO_0000119 xml:lang="en">Dorland&apos;s Illustrated Medical Dictionary, 30th ed.</obo:IAO_0000119>
        <oboInOwl:hasExactSynonym xml:lang="en">improving</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">recovering</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">resolving health trend</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/GENEPIO_0001551 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GENEPIO_0001551">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GENEPIO_0001272"/>
        <obo:IAO_0000117>Damion Dooley</obo:IAO_0000117>
        <rdfs:label xml:lang="en">close interpersonal relationship exposure</rdfs:label>
    </owl:Class>
    


