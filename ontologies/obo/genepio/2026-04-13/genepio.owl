        <obo:IAO_0000114>requires discussion</obo:IAO_0000114>
        <obo:IAO_0000115 xml:lang="en">A sampling strategy in which samples are collected in order to research an outbreak which is associated with water.</obo:IAO_0000115>
        <obo:IAO_0000118 xml:lang="en">water associated outbreak investigation</obo:IAO_0000118>
        <dcterms:contributor rdf:resource="https://orcid.org/0000-0001-8008-8249"/>
