        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000040"/>
        <obo:GENEPIO_0000162 xml:lang="en">PCDS: The material constituents that comprise an environmental material.</obo:GENEPIO_0000162>
