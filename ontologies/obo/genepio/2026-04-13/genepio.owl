        <obo:IAO_0000114>metadata incomplete</obo:IAO_0000114>
        <obo:IAO_0000115 xml:lang="en">A prior infection data field which describes the date of diagnosis of the prior Monkeypox infection.</obo:IAO_0000115>
        <obo:IAO_0000118 xml:lang="en">PCDS:prior_mpox_infection_date</obo:IAO_0000118>
        <dcterms:contributor rdf:resource="https://orcid.org/0000-0002-1107-9135"/>
        <dcterms:contributor rdf:resource="https://orcid.org/0000-0002-8844-9165"/>
        <dcterms:contributor rdf:resource="https://orcid.org/0000-0002-9578-0788"/>
        <dcterms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-04-24T00:42:14Z</dcterms:date>
        <oboInOwl:hasBroadSynonym xml:lang="en">prior Monkeypox infection date</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">prior Monkeypox infection date slot</oboInOwl:hasExactSynonym>
        <rdfs:comment xml:lang="en">PCDS: Provide the date that the most recent prior infection was diagnosed. Provide the prior Mpox infection date in ISO 8601 standard format &apos;YYYY-MM-DD&apos;.</rdfs:comment>
        <rdfs:label xml:lang="en">prior mpox infection date</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/GENEPIO_0100534 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GENEPIO_0100534">
