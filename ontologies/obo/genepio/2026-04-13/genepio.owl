    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_03460220 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_03460220">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_03450012"/>
