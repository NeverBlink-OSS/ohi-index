        <obo:IAO_0000112>pick list (XbaI, BlnI)</obo:IAO_0000112>
        <obo:IAO_0000115>Restriction enzyme for first characterization</obo:IAO_0000115>
        <obo:IAO_0000119>GROUP: IRIDA Ontology (Emma)</obo:IAO_0000119>
        <rdfs:label xml:lang="en">primary enzyme (LMAAI)</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/GENEPIO_0000045 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GENEPIO_0000045">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GENEPIO_0001688"/>
