        <oboInOwl:hasExactSynonym>Low blood pressure</oboInOwl:hasExactSynonym>
        <rdfs:label>Hypotension</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/HP_0002625 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0002625">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0004936"/>
        <obo:IAO_0000115>Formation of a blot clot in a deep vein. The clot often blocks blood flow, causing swelling and pain. The deep veins of the leg are most often affected.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/hp.owl"/>
        <oboInOwl:hasDbXref>SNOMEDCT_US:128053003</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS:C0149871</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>Blood clot in a deep vein</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Deep vein thrombosis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Multiple deep venous thrombosis</oboInOwl:hasExactSynonym>
        <rdfs:label>Deep venous thrombosis</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/HP_0002633 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0002633">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0033353"/>
        <obo:IAO_0000115>Inflammation of blood vessel.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/hp.owl"/>
        <oboInOwl:hasDbXref>SNOMEDCT_US:31996006</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS:C0042384</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>Angiitis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Inflammation of blood vessel</oboInOwl:hasExactSynonym>
        <rdfs:label>Vasculitis</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/HP_0002637 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0002637">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0033401"/>
        <obo:IAO_0000115>Restriction of arterial blood supply to the brain associated with insufficient oxygenation to support the metabolic requirements of the tissue.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/hp.owl"/>
        <oboInOwl:hasDbXref>SNOMEDCT_US:287731003</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SNOMEDCT_US:389100007</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS:C0007786</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS:C0917798</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>Brain ischemia</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Cerebrovascular ischemia</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Disruption of blood oxygen supply to brain</oboInOwl:hasExactSynonym>
        <rdfs:label>Cerebral ischemia</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/HP_0002715 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0002715">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0000118"/>
        <obo:IAO_0000115>An abnormality of the immune system.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/hp.owl"/>
        <oboInOwl:hasAlternativeId>HP:0003257</oboInOwl:hasAlternativeId>
        <oboInOwl:hasAlternativeId>HP:0003346</oboInOwl:hasAlternativeId>
        <oboInOwl:hasAlternativeId>HP:0010986</oboInOwl:hasAlternativeId>
        <oboInOwl:hasDbXref>UMLS:C4021753</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>Abnormality of the immune system</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Immunological abnormality</oboInOwl:hasExactSynonym>
        <rdfs:comment>The immune system is composed of organs and interdependent cell types that collectively protect the body from infections and from the growth of tumor cells. The organs of the immune system comprise the bone marrow, the spleen, the thymus,the lymph nodes, and the cell types comprise B cells, T cells, natural killer cells, granulocytes,dendritic cells, and macrophages.</rdfs:comment>
        <rdfs:label>Abnormality of the immune system</rdfs:label>
    </owl:Class>
    


