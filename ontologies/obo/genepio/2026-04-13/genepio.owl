        <oboInOwl:hasExactSynonym>carpal/tarsal skeleton</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>mesopodial skeleton</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>mesopodium skeleton</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>skeletal parts of mesopodium</oboInOwl:hasExactSynonym>
        <rdfs:label>mesopodial skeleton</rdfs:label>
    </owl:Class>
    


