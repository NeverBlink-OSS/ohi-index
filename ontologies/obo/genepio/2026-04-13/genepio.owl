    <!-- http://purl.obolibrary.org/obo/GENEPIO_0100082 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GENEPIO_0100082">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GENEPIO_0100293"/>
        <obo:IAO_0000114>requires discussion</obo:IAO_0000114>
        <obo:IAO_0000115 xml:lang="en">A variant designation which is 1) a variant of the Severe Acute Respiratory Syndrome Coronavirus 2 (SARS-CoV-2), 2) believed to have genetic mutations that increase binding affinity to human cells, 3) linked to rapid spread in human populations, and 4) is being monitored.</obo:IAO_0000115>
        <obo:IAO_0000118 xml:lang="en">Variant of Concern (VOC)</obo:IAO_0000118>
        <dcterms:contributor rdf:resource="https://orcid.org/0000-0002-1107-9135"/>
        <dcterms:contributor rdf:resource="https://orcid.org/0000-0002-8844-9165"/>
        <dcterms:contributor rdf:resource="https://orcid.org/0000-0002-9578-0788"/>
        <dcterms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2022-01-19T18:23:15.862Z</dcterms:date>
        <oboInOwl:hasExactSynonym xml:lang="en">VOC</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">VoC</oboInOwl:hasExactSynonym>
        <rdfs:comment xml:lang="en">PHA4GE Definition: A category used for indicating that a variant of the Severe Acute Respiratory Syndrome Coronavirus 2 (SARS-CoV-2) containing genetic mutations believed to increase binding affinity to human cells and linked to rapid spread in human populations is being monitored.</rdfs:comment>
        <rdfs:label xml:lang="en">variant of concern (SARS-CoV-2)</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/GENEPIO_0100083 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GENEPIO_0100083">
