        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/hp.owl"/>
        <oboInOwl:hasAlternativeId>HP:0005127</oboInOwl:hasAlternativeId>
        <oboInOwl:hasAlternativeId>HP:0006701</oboInOwl:hasAlternativeId>
        <oboInOwl:hasDbXref>SNOMEDCT_US:45007003</oboInOwl:hasDbXref>
