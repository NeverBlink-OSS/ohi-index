        <rdfs:comment xml:lang="en">PCDS: If applicable, describe the material constituents for the environmental material. Multiple values can be provided, separated by a semi-colon.</rdfs:comment>
        <rdfs:label xml:lang="en">environmental material constituent</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/GENEPIO_0101203 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GENEPIO_0101203">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GENEPIO_0001800"/>
        <obo:GENEPIO_0000162 xml:lang="en">PCDS: The identifier assigned to a sequence in one of the International Nucleotide Sequence Database Collaboration (INSDC) repositories.</obo:GENEPIO_0000162>
        <obo:IAO_0000112>PCDS: ERR123456, DRR123456, CRR123456</obo:IAO_0000112>
        <obo:IAO_0000114>metadata incomplete</obo:IAO_0000114>
        <obo:IAO_0000115 xml:lang="en">A unique identifier assigned by the International Nucleotide Sequence Database Collaboration (INSDC) to a raw sequence read, representing a single experimentally derived nucleotide sequence.</obo:IAO_0000115>
        <obo:IAO_0000118 xml:lang="en">PCDS:insdc_sequence_read_accession</obo:IAO_0000118>
        <dcterms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-04-09T18:02:29.914Z</dcterms:date>
        <rdfs:comment xml:lang="en">PCDS: Store the accession assigned to the submitted sequence. European Nucleotide Archive (ENA) sequence accessions start with ERR, NCBI-SRA accessions start with SRR, DNA Data Bank of Japan (DDBJ) accessions start with DRR and Genome Sequence Archive (GSA) accessions start with CRR.</rdfs:comment>
        <rdfs:label xml:lang="en">insdc sequence read accession</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/GENEPIO_0101204 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GENEPIO_0101204">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GENEPIO_0001800"/>
        <obo:GENEPIO_0000162 xml:lang="en">PCDS: The versioned identifier assigned to an assembly or consensus sequence in one of the International Nucleotide Sequence Database Collaboration (INSDC) repositories.</obo:GENEPIO_0000162>
        <obo:IAO_0000112>PCDS: LZ986655.1</obo:IAO_0000112>
        <obo:IAO_0000114>metadata incomplete</obo:IAO_0000114>
        <obo:IAO_0000115 xml:lang="en">A unique identifier that denotes an assembly record submitted to the International Nucleotide Sequence Database Collaboration (INSDC).</obo:IAO_0000115>
        <obo:IAO_0000118 xml:lang="en">PCDS:insdc_assembly_accession</obo:IAO_0000118>
        <dcterms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-04-09T18:02:29.914Z</dcterms:date>
        <rdfs:comment xml:lang="en">PCDS: Store the versioned accession assigned to the submitted sequence; e.g. the GenBank accession version.</rdfs:comment>
        <rdfs:label xml:lang="en">insdc assembly accession</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/GENEPIO_0101205 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GENEPIO_0101205">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GENEPIO_0100586"/>
        <obo:GENEPIO_0000162 xml:lang="en">PCDS: An environmental location in the natural or built environment, that is proximal to a sampling location and which can impact a sample.</obo:GENEPIO_0000162>
        <obo:IAO_0000112>PCDS: Farm</obo:IAO_0000112>
        <obo:IAO_0000114>metadata incomplete</obo:IAO_0000114>
        <obo:IAO_0000118 xml:lang="en">PCDS:proximal_environmental_site</obo:IAO_0000118>
        <dcterms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-04-13T17:18:02.461Z</dcterms:date>
        <rdfs:comment xml:lang="en">PCDS: Provide a descriptor of the environmental site close to the sampling site. Use the picklist provided in the template. If not applicable, choose a null value.</rdfs:comment>
        <rdfs:label xml:lang="en">proximal environmental site</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/GENEPIO_0101715 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GENEPIO_0101715">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GENEPIO_0102269"/>
        <obo:GENEPIO_0000162 xml:lang="en">PCDS: The name of the sequence file.</obo:GENEPIO_0000162>
        <obo:IAO_0000112>PCDS: mevassembly.fasta</obo:IAO_0000112>
