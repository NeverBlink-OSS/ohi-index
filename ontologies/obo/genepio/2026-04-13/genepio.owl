    <owl:Ontology rdf:about="http://purl.obolibrary.org/obo/genepio.owl">
        <owl:versionIRI rdf:resource="http://purl.obolibrary.org/obo/genepio/releases/2026-04-13/genepio.owl"/>
        <dcterms:description xml:lang="en">The Genomic Epidemiology Ontology aims to provide a comprehensive controlled vocabulary for infectious disease surveillance and outbreak investigations. It is an application ontology that draws on many other ontologies including anatomy, taxonomy, disease, symptoms, environment and food types for foodborn pathogen metadata.</dcterms:description>
        <dcterms:license rdf:resource="http://creativecommons.org/licenses/by/3.0/"/>
        <dcterms:title xml:lang="en">Genomic Epidemiology Ontology</dcterms:title>
        <oboInOwl:default-namespace>GENEPIO</oboInOwl:default-namespace>
        <owl:versionInfo>2026-04-13</owl:versionInfo>
    </owl:Ontology>
    


