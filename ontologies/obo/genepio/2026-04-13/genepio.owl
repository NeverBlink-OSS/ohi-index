        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_557"/>
        <obo:IAO_0000115 xml:lang="en">An urogenital tuberculosis that results_in formation of granulomas located_in kidney.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/doid.owl"/>
        <rdfs:label xml:lang="en">renal tuberculosis</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/DOID_974 -->

