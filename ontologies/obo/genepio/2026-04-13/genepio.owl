        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_03480020"/>
        <obo:IAO_0000115 xml:lang="en">Packed in a medium that is also a food product.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/foodon.owl"/>
        <oboInOwl:hasDbXref rdf:resource="http://www.langual.org/langual_thesaurus.asp?termid=K0011"/>
        <rdfs:label xml:lang="en">packed in edible medium</rdfs:label>
    </owl:Class>
    


