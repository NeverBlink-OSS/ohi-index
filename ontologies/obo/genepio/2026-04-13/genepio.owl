        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/envo.owl"/>
        <oboInOwl:hasExactSynonym xml:lang="en">conference center</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">conference centre</oboInOwl:hasExactSynonym>
