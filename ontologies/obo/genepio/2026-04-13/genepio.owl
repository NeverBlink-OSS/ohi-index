    <!-- http://purl.obolibrary.org/obo/HANCESTRO_0874 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HANCESTRO_0874">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HANCESTRO_0611"/>
        <obo:IAO_0000115>Individuals who self-identify or are reported by authors as belonging to the Kukama Kukamiria indigenous population in the Peruvian Amazon. Their language, also called Kukama-Kukamiria, is a Tupi-Guarani language.</obo:IAO_0000115>
        <obo:IAO_0000119>PMID:29407757</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:33945560</obo:IAO_0000119>
        <obo:IAO_0000119>https://www.wwf.org.ec/?389371/The-Kukama-Kukamiria-an-invisible-indigenous-people-that-emerges-revaluing-their-culture</obo:IAO_0000119>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/hancestro.owl"/>
        <oboInOwl:hasExactSynonym>Kukama Kukamilla</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">Kukama Kukamiria</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/HANCESTRO_0875 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HANCESTRO_0875">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HANCESTRO_0611"/>
        <obo:IAO_0000115>Individuals who self-identify or are reported by authors as belonging to the Shipibo-Conibo indigenous population along the Ucayali River in the Amazon rainforest in Peru. Formerly two groups, they eventually became one tribe through intermarriage and communal rituals and are currently known as the Shipibo-Conibo people.</obo:IAO_0000115>
        <obo:IAO_0000119>PMID:15798863</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:22515992</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:2705014</obo:IAO_0000119>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/hancestro.owl"/>
        <rdfs:label xml:lang="en">Shipibo-Conibo</rdfs:label>
    </owl:Class>
    


