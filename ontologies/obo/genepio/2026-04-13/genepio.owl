        <obo:GENEPIO_0000004>IRIDA ID</obo:GENEPIO_0000004>
        <obo:GENEPIO_0000005>ontology group</obo:GENEPIO_0000005>
        <obo:IAO_0000115>An IRIDA case ID is a tracking identifier for a case used in the IRIDA.ca software system.  It is used to cross-reference anonymized IDs.</obo:IAO_0000115>
        <obo:IAO_0000117 xml:lang="en">Damion Dooley</obo:IAO_0000117>
        <obo:IAO_0000119>GROUP: IRIDA Ontology (Emma)</obo:IAO_0000119>
        <rdfs:label>IRIDA case ID</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/GENEPIO_0000103 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GENEPIO_0000103">
        <obo:IAO_0000115 xml:lang="en">An NCBI BioProject data item is a datum within the NCBI BioProject standard collection</obo:IAO_0000115>
        <obo:IAO_0000117>Damion Dooley</obo:IAO_0000117>
        <obo:IAO_0000231 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000227"/>
        <obo:IAO_0100001 rdf:resource="http://purl.obolibrary.org/obo/GENEPIO_0001836"/>
