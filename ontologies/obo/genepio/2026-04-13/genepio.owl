        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GENEPIO_0100586"/>
        <obo:GENEPIO_0000162 xml:lang="en">PCDS: A perceived change in function or sensation, (loss, disturbance or appearance) indicative of a disease, reported by a patient.</obo:GENEPIO_0000162>
