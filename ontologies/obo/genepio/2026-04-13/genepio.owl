        <oboInOwl:hasExactSynonym>technical_replicate</oboInOwl:hasExactSynonym>
        <rdfs:label>technical replicate</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ebi.ac.uk/efo/EFO_0002091 -->

