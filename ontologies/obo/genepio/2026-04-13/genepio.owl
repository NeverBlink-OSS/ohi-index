    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GENEPIO_0002075">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NCIT_C103180"/>
        <obo:IAO_0000115 xml:lang="en">A Genomic Standards Consortium standard is an international, community-driven standard to facilitate  genomic data integration, discovery and comparison.</obo:IAO_0000115>
        <obo:IAO_0000117 xml:lang="en">Damion Dooley</obo:IAO_0000117>
        <rdfs:label xml:lang="en">Genomic Standards Consortium (GSC) standard</rdfs:label>
