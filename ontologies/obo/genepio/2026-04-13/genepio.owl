    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UBERON_0016378 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0016378">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000029"/>
        <obo:IAO_0000115>One of the lymph nodes that form a chain around the ileocolic artery.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/uberon.owl"/>
        <oboInOwl:hasDbXref>FMA:16611</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MA:0003065</oboInOwl:hasDbXref>
