        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_10314"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_104"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_1564"/>
        <obo:IAO_0000115 xml:lang="en">An endocarditis that is characterized by inflammation of the endocardium caused by infectious agents.</obo:IAO_0000115>
