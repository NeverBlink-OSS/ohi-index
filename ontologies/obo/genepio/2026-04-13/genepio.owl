        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_11102"/>
        <obo:IAO_0000115 xml:lang="en">A bartonellosis that has_material_basis_in Bartonella henselae or has_material_basis_in Bartonella quintana. The disease is characterized by the proliferation of blood vessels, resulting in them forming tumour-like masses in the skin and other organs.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/doid.owl"/>
