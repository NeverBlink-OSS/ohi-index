    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/GENEPIO_0102180 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GENEPIO_0102180">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GENEPIO_0100004"/>
        <obo:IAO_0000114>requires discussion</obo:IAO_0000114>
        <obo:IAO_0000115 xml:lang="en">A sampling strategy in which environments are systematically sampled to detect the presence or emergence of pathogens, contaminants, or other indicators without prior knowledge of an event.</obo:IAO_0000115>
        <obo:IAO_0000118 xml:lang="en">Environmental surveillance</obo:IAO_0000118>
        <dcterms:contributor rdf:resource="https://orcid.org/0000-0001-8008-8249"/>
        <dcterms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-04-13T19:52:38.515Z</dcterms:date>
        <rdfs:label xml:lang="en">environmental surveillance sampling</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/GENEPIO_0102181 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GENEPIO_0102181">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GENEPIO_0100004"/>
        <obo:IAO_0000114>requires discussion</obo:IAO_0000114>
        <obo:IAO_0000115 xml:lang="en">A sampling strategy in which surface waters are systematically sampled to assess overall water quality, detect contaminants, and identify emerging risks. Surveillance is broad and ongoing, aiming to establish baseline conditions and detect changes over time.</obo:IAO_0000115>
        <obo:IAO_0000118 xml:lang="en">Surface water quality surveillance</obo:IAO_0000118>
        <dcterms:contributor rdf:resource="https://orcid.org/0000-0001-8008-8249"/>
        <dcterms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-04-13T19:52:38.515Z</dcterms:date>
        <rdfs:label xml:lang="en">surface water quality surveillance sampling</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/GENEPIO_0102182 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GENEPIO_0102182">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HSO_0000072"/>
        <obo:IAO_0000114>requires discussion</obo:IAO_0000114>
        <obo:IAO_0000115 xml:lang="en">A sampling strategy in which environments are sampled to assess a known event, hazard, or signal over time. Monitoring is typically targeted and focused, such as tracking levels of a specific contaminant or pathogen after it has already been detected</obo:IAO_0000115>
        <obo:IAO_0000118 xml:lang="en">Monitoring</obo:IAO_0000118>
        <dcterms:contributor rdf:resource="https://orcid.org/0000-0001-8008-8249"/>
        <dcterms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-04-13T19:52:38.515Z</dcterms:date>
        <rdfs:label xml:lang="en">monitoring strategy</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/GENEPIO_0102183 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GENEPIO_0102183">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GENEPIO_0102182"/>
        <obo:IAO_0000114>requires discussion</obo:IAO_0000114>
        <obo:IAO_0000115 xml:lang="en">A monitoring strategy in which samples are collected due to a monitor or assess an algal bloom event.</obo:IAO_0000115>
        <obo:IAO_0000118 xml:lang="en">Algal bloom monitoring</obo:IAO_0000118>
        <dcterms:contributor rdf:resource="https://orcid.org/0000-0001-8008-8249"/>
        <dcterms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-04-13T19:52:38.515Z</dcterms:date>
        <rdfs:label xml:lang="en">algal bloom monitoring</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/GENEPIO_0102184 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GENEPIO_0102184">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GENEPIO_0102182"/>
        <obo:IAO_0000114>requires discussion</obo:IAO_0000114>
        <obo:IAO_0000115 xml:lang="en">A sampling strategy in which environments are sampled in response to observations, complaints, or reports from the community regarding a change in environmental conditions.</obo:IAO_0000115>
        <dcterms:contributor rdf:resource="https://orcid.org/0000-0001-8008-8249"/>
        <dcterms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-04-13T19:52:38.515Z</dcterms:date>
        <rdfs:label xml:lang="en">community triggered environmental monitoring</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/GENEPIO_0102185 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GENEPIO_0102185">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OBI_0002814"/>
        <obo:IAO_0000114>requires discussion</obo:IAO_0000114>
        <obo:IAO_0000115 xml:lang="en">A specimen collection device manufactured by Teledyne ISCO designed to collect discrete or composite samples from environmental media according to predefined time intervals, flow conditions, or external triggers.</obo:IAO_0000115>
        <obo:IAO_0000116>Planned Obsolescence: this term is a placeholder for a term requested in another ontology. Once the appropriate ontology term is available, this term’s identifier will be obsoleted with a “term replaced by” id of the other term.</obo:IAO_0000116>
        <obo:IAO_0000118 xml:lang="en">ISCO sampler</obo:IAO_0000118>
        <dcterms:contributor rdf:resource="https://orcid.org/0000-0002-1107-9135"/>
        <dcterms:contributor rdf:resource="https://orcid.org/0000-0002-8844-9165"/>
        <dcterms:contributor rdf:resource="https://orcid.org/0000-0002-9578-0788"/>
        <dcterms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-04-13T19:52:38.515Z</dcterms:date>
        <rdfs:comment xml:lang="en">Commonly used in water and wastewater monitoring and supports multiple sampling modes (e.g., grab, composite, flow-proportional). Typically programmable and may integrate with sensors (e.g., flow meters).</rdfs:comment>
        <rdfs:label xml:lang="en">ISCO sampling device</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/GENEPIO_0102186 -->

