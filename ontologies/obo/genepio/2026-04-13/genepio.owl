        <rdfs:label>Orthocoronavirinae infectious disease</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/MONDO_0021094 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MONDO_0021094">
