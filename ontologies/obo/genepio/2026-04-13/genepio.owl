    </rdf:Description>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/UO_0010022">
        <obo:IAO_0000115>A maritime length unit which is equal to 6,080 feet, 10 cables, or 1,853.184 metres</obo:IAO_0000115>
