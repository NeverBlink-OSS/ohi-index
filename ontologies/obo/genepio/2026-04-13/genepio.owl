        <rdfs:label>food storage organ</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UBERON_0010239 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0010239">
