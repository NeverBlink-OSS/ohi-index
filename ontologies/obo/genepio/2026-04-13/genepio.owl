        <dcterms:contributor rdf:resource="https://orcid.org/0000-0002-1107-9135"/>
        <dcterms:contributor rdf:resource="https://orcid.org/0000-0002-8844-9165"/>
        <dcterms:contributor rdf:resource="https://orcid.org/0000-0002-9578-0788"/>
        <dcterms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2022-01-19T18:23:15.862Z</dcterms:date>
        <oboInOwl:hasExactSynonym xml:lang="en">random sampling</oboInOwl:hasExactSynonym>
        <rdfs:comment xml:lang="en">Such that each possible unit has a fixed and known or equal probability of selection. [Source: &quot;Random Sample&quot; (p.238) in Porta, M. (2014). A Dictionary of Epidemiology (6th ed.). Oxford University Press, Incorporated.]</rdfs:comment>
        <rdfs:label xml:lang="en">baseline surveillance strategy</rdfs:label>
    </owl:Class>
    


