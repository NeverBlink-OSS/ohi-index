        <oboInOwl:hasExactSynonym>colon transversum</oboInOwl:hasExactSynonym>
        <rdfs:label>transverse colon</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UBERON_0001158 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0001158">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000168"/>
        <obo:IAO_0000115>The portion of the colon between the left colic flexure and the sigmoid colon at the pelvic brim; the portion of the descending colon lying in the left iliac fossa is sometimes called the iliac colon.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/uberon.owl"/>
