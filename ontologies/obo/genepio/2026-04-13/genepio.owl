        <rdfs:label xml:lang="en">sexual contact exposure</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/GENEPIO_0001556 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GENEPIO_0001556">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GENEPIO_0001275"/>
        <obo:IAO_0000117>Damion Dooley</obo:IAO_0000117>
        <rdfs:label xml:lang="en">exposure via diaper changing (human fecal)</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/GENEPIO_0001558 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GENEPIO_0001558">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000577"/>
        <rdfs:label xml:lang="en">container identifier</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/GENEPIO_0001559 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GENEPIO_0001559">
