        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_00000114"/>
        <obo:IAO_0000115>A flooded parcel of arable land used for growing rice and other semiaquatic crops.</obo:IAO_0000115>
