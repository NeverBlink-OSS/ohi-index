    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_02000258 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_02000258">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_00004485"/>
        <obo:IAO_0000115 xml:lang="en">A lamb leg half that is derived from a whole leg. The anatomical location is the “Half” that comes from the Pelvic region of the Leg known as the Sirloin. The half includes the center section with muscles from the bottom, eye, tip, and top.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/foodon.owl"/>
        <rdfs:label xml:lang="en">lamb sirloin half</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_02000259 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_02000259">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_02000258"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_02021135"/>
        <obo:IAO_0000115 xml:lang="en">A raw lamb sirloin half cut.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/foodon.owl"/>
        <rdfs:label xml:lang="en">lamb sirloin half (raw)</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_02000260 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_02000260">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_02000258"/>
        <obo:IAO_0000115 xml:lang="en">A lamb sirloin half that has bones removed except for the femur and humerus bone and the designated shank (i.e. hindshank, or foreshank) is removed.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/foodon.owl"/>
        <rdfs:label xml:lang="en">lamb sirloin half (shank off, semi-boneless)</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_02000261 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_02000261">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_02000259"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_02000260"/>
        <obo:IAO_0000115 xml:lang="en">A cut from lamb sirloin half (shank off, semi-boneless) that is raw.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/foodon.owl"/>
        <rdfs:label xml:lang="en">lamb sirloin half (shank off, semi-boneless, raw)</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_02000262 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_02000262">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_00004485"/>
        <obo:IAO_0000115 xml:lang="en">A boneless cut that comes from the outside and sirloin tip portion of any boneless leg cut.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/foodon.owl"/>
        <rdfs:label xml:lang="en">lamb leg bottom</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_02000263 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_02000263">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_00004485"/>
        <obo:IAO_0000115 xml:lang="en">A boneless cut that comes from the inside portion of any boneless leg cut and shall consist of the semimembranosus, adductor and firmly attached muscles. The inside is separated from the bottom and knuckle portion along the natural seams.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/foodon.owl"/>
        <rdfs:label xml:lang="en">lamb leg top</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_02000264 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_02000264">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_00004489"/>
        <obo:IAO_0000115 xml:lang="en">A lamb chop that derives from the sirloin portion of the leg. The cut location extends from the anterior end of the Pelvic bone to the hip socket.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/foodon.owl"/>
        <rdfs:label xml:lang="en">lamb sirloin chop</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_02000265 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_02000265">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_02000264"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_03311091"/>
        <obo:IAO_0000115 xml:lang="en">A raw lamb sirloin chop.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/foodon.owl"/>
        <rdfs:label xml:lang="en">lamb sirloin chop (raw)</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_02000266 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_02000266">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_02000264"/>
        <obo:IAO_0000115 xml:lang="en">A boneless lamb sirloin chop.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/foodon.owl"/>
        <rdfs:label xml:lang="en">lamb sirloin chop (boneless)</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_02000267 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_02000267">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_02000265"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_02000266"/>
        <obo:IAO_0000115 xml:lang="en">A raw and boneless lamb sirloin chop.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/foodon.owl"/>
        <rdfs:label xml:lang="en">lamb sirloin chop (boneless, raw)</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_02000268 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_02000268">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_00004485"/>
        <obo:IAO_0000115 xml:lang="en">A whole rear leg containing the eye, bottom, sirloin, sirloin tip and top.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/foodon.owl"/>
        <rdfs:label xml:lang="en">leg of lamb</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_02000269 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_02000269">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_02000268"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_02021135"/>
        <obo:IAO_0000115 xml:lang="en">A raw leg of lamb.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/foodon.owl"/>
        <rdfs:label xml:lang="en">leg of lamb (raw)</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_02000270 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_02000270">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_00004479"/>
        <obo:IAO_0000115 xml:lang="en">A leg of lamb that has the shank and sirloin removed leaving only the “center” section of the leg thus the name “center cut.”</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/foodon.owl"/>
        <rdfs:label xml:lang="en">leg of lamb center cut</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_02000271 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_02000271">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_02000270"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_02021245"/>
        <obo:IAO_0000115 xml:lang="en">A raw leg of lamb center cut.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/foodon.owl"/>
        <rdfs:label xml:lang="en">leg of lamb center cut (raw)</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_02000272 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_02000272">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_00004482"/>
        <obo:IAO_0000115 xml:lang="en">A lamb primal cut that is between the shoulder and loin.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/foodon.owl"/>
        <rdfs:label xml:lang="en">lamb rib</rdfs:label>
    </owl:Class>
    


