    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GENEPIO_0001543">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GENEPIO_0001192"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000428"/>
        <obo:IAO_0000117>Damion Dooley</obo:IAO_0000117>
        <rdfs:label xml:lang="en">illness causality</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/GENEPIO_0001548 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GENEPIO_0001548">
