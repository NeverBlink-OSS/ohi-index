        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MP_0002133"/>
        <obo:IAO_0000115>local accumulation of fluid, plasma proteins, and leukocytes in the respiratory system</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/mp.owl"/>
        <rdfs:label>respiratory system inflammation</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/MP_0005384 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MP_0005384">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MP_0000001"/>
        <obo:IAO_0000115>the observable morphological and physiological characteristics of the basic structural and functional unit of all mammalian organisms that are manifested through development and lifespan</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/mp.owl"/>
        <oboInOwl:hasExactSynonym>cell phenotype</oboInOwl:hasExactSynonym>
        <rdfs:label>cellular phenotype</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/MP_0005387 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MP_0005387">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MP_0000001"/>
        <obo:IAO_0000115>the observable morphological and physiological characteristics of the mammalian system that protects the body from foreign substances, cells, and tissues by producing the immune response and that includes especially the thymus, spleen, lymphoid tissue, lymphocytes including the B cells and T cells, and antibodies that are manifested through development and lifespan</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/mp.owl"/>
        <rdfs:label>immune system phenotype</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/MP_0005388 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MP_0005388">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MP_0000001"/>
