        <obo:IAO_0000115 xml:lang="en">A plan specification which specifies how the material enrichment procedure will influence the scale, or type of material that will be assayed in the specimen.</obo:IAO_0000115>
        <obo:IAO_0000117>PERSON: Chris Stoeckert, Jie Zheng</obo:IAO_0000117>
