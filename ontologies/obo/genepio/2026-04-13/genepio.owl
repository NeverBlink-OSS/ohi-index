    <!-- http://purl.obolibrary.org/obo/GENEPIO_0001614 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GENEPIO_0001614">
        <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/SIO_000136"/>
        <rdfs:subClassOf rdf:nodeID="genid172"/>
        <obo:IAO_0000115 xml:lang="en">A subject description is a field containing additional information about an organism (related to an investigation, study and/or specimen) that is not included in other defined vocabulary fields.</obo:IAO_0000115>
        <obo:IAO_0000117 xml:lang="en">Damion Dooley</obo:IAO_0000117>
        <obo:IAO_0000119 rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://purl.obolibrary.org/obo/GENEPIO_0001835</obo:IAO_0000119>
        <rdfs:label xml:lang="en">subject description</rdfs:label>
    </owl:Class>
    <owl:Restriction rdf:nodeID="genid172">
        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002350"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/GENEPIO_0001835"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/GENEPIO_0001614"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#subClassOf"/>
        <owl:annotatedTarget rdf:nodeID="genid172"/>
        <rdfs:label xml:lang="en">host description</rdfs:label>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/GENEPIO_0001615 -->

