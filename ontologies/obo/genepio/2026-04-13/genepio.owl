        <oboInOwl:hasExactSynonym>cranial deep node</oboInOwl:hasExactSynonym>
        <rdfs:label>cranial deep lymph node</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UBERON_0016374 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0016374">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0016398"/>
        <obo:IAO_0000115>A lymph node that is medial to the gluteus superficialis m., caudal to gluteus medius m. and sciatic nerve lymph node.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/uberon.owl"/>
        <oboInOwl:hasDbXref>MA:0002884</oboInOwl:hasDbXref>
