        <obo:GENEPIO_0000005 rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.aha.org/content/00-10/overview0302.pdf</obo:GENEPIO_0000005>
        <obo:GENEPIO_0000005 rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.webcitation.org/5VBWPbFgY</obo:GENEPIO_0000005>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000120"/>
        <obo:IAO_0000115 xml:lang="en">The American Hospital Association has issued HIPAA Updated Guidelines for Releasing Information on the Condition of Patients</obo:IAO_0000115>
