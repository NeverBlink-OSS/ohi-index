        <obo:IAO_0000115>Section of colon which is distal to the cecum and proximal to the transversecolon.[FMA,modified].</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/uberon.owl"/>
