        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000120"/>
        <obo:IAO_0000115 xml:lang="en">A standard established for use by the Integrated Rapid Infectious Disease Analysis (IRIDA) project, which is a Canadian-led initiative to build an open source, end-to-end platform for infectious disease genomic epidemiology.</obo:IAO_0000115>
        <obo:IAO_0000117>Damion Dooley</obo:IAO_0000117>
