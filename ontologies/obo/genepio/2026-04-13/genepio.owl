        <obo:IAO_0000114>metadata incomplete</obo:IAO_0000114>
        <obo:IAO_0000115 xml:lang="en">An identifier field which describes the user-defined name for the sample.</obo:IAO_0000115>
        <obo:IAO_0000118 xml:lang="en">PCDS:specimen_sample_collector_sample_id</obo:IAO_0000118>
        <dcterms:contributor rdf:resource="https://orcid.org/0000-0002-1107-9135"/>
        <dcterms:contributor rdf:resource="https://orcid.org/0000-0002-8844-9165"/>
        <dcterms:contributor rdf:resource="https://orcid.org/0000-0002-9578-0788"/>
        <dcterms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-04-24T00:42:14Z</dcterms:date>
        <oboInOwl:hasBroadSynonym xml:lang="en">sample collector sample identifier</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasBroadSynonym xml:lang="en">sample_collector_sample_ID</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasBroadSynonym xml:lang="en">specimen collector sample ID</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">sample collector sample identifier field</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">sample collector sample identifier slot</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">specimen collector sample ID slot</oboInOwl:hasExactSynonym>
        <rdfs:comment xml:lang="en">PCDS: The sample ID should represent the identifier assigned to the sample at time of collection, for which all the descriptive information applies. Every sample ID from a single submitter must be unique. The ID may use any format, but should be concise, consistent within the lab, and informative where possible. If the original sample ID is unknown or cannot be provided, leave blank or provide a null value.</rdfs:comment>
        <rdfs:label xml:lang="en">specimen collector sample ID</rdfs:label>
    </owl:Class>
    


