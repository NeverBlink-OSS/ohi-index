        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_03450002"/>
        <obo:IAO_0000115 xml:lang="en">A process to bring an already fully cooked product to serving temperature.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/foodon.owl"/>
        <oboInOwl:hasDbXref>http://www.langual.org/langual_thesaurus.asp?termid=G0037</oboInOwl:hasDbXref>
        <rdfs:label xml:lang="en">food reheating</rdfs:label>
    </owl:Class>
    


