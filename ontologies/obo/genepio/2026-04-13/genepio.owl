        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_530"/>
        <obo:IAO_0000115 xml:lang="en">An eyelid disease that is characterized by an infection of the sebaceous glands at the base of the eyelashes. Styes are generally caused by a Staphylococcus aureus bacterial infection.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/doid.owl"/>
