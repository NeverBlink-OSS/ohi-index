        <obo:GENEPIO_0000162 xml:lang="en">PCDS: The longitude coordinates of the geographical location of sample collection.</obo:GENEPIO_0000162>
        <obo:IAO_0000112>PCDS: 77.11 W</obo:IAO_0000112>
        <obo:IAO_0000114>metadata incomplete</obo:IAO_0000114>
        <obo:IAO_0000115 xml:lang="en">A data field which describes the longitude coordinates of the geographical location of sample collection.</obo:IAO_0000115>
        <obo:IAO_0000118 xml:lang="en">PCDS:geo_loc_longitude</obo:IAO_0000118>
        <dcterms:contributor rdf:resource="https://orcid.org/0000-0002-1107-9135"/>
        <dcterms:contributor rdf:resource="https://orcid.org/0000-0002-8844-9165"/>
