    <!-- http://purl.obolibrary.org/obo/GENEPIO_0002107 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GENEPIO_0002107">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GENEPIO_0100586"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OBI_0000079"/>
        <obo:GENEPIO_0000162 xml:lang="en">PCDS: An isolation medium is a culture medium which has the disposition to encourage growth of particular bacteria to the exclusion of others in the same growth environment.</obo:GENEPIO_0000162>
        <obo:IAO_0000112>PCDS: Brain heart infusion (BHI)</obo:IAO_0000112>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000428"/>
        <obo:IAO_0000114>metadata incomplete</obo:IAO_0000114>
        <obo:IAO_0000115 xml:lang="en">An isolation medium is a culture medium which has the disposition to encourage growth of particular bacteria to the exclusion of others in the same growth environment.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">Chris has proposed this term for OBI as &quot;enrichment culture medium&quot;</obo:IAO_0000116>
        <obo:IAO_0000117 xml:lang="en">Damion Dooley</obo:IAO_0000117>
        <obo:IAO_0000118 xml:lang="en">PCDS:isolation_medium</obo:IAO_0000118>
