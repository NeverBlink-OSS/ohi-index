        <oboInOwl:hasDbXref>EFO:0004246</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>GARD:0006816</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ICD10CM:M30.3</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ICD9:446.1</oboInOwl:hasDbXref>
