        <rdfs:label xml:lang="en">food allergen labelling about pod fruits and products thereof</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_03510231 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_03510231">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_03510213"/>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/foodon.owl"/>
