        <rdfs:label xml:lang="en">tenderloin</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_03530253 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_03530253">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_03530207"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_03530291"/>
        <obo:IAO_0000115 xml:lang="en">Plant cultivation according to organic food production methods including the use of fertilizers of organic origin such as compost manure, green manure, and bone meal and places emphasis on techniques such as crop rotation and companion planting, biological pest control and the fostering of insect predators.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/foodon.owl"/>
        <oboInOwl:hasDbXref rdf:resource="http://www.langual.org/langual_thesaurus.asp?termid=Z0253"/>
        <rdfs:label xml:lang="en">organic plant cultivation</rdfs:label>
    </owl:Class>
    


