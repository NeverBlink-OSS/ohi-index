    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_03510230 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_03510230">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_03510213"/>
