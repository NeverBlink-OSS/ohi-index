        <obo:IAO_0000119 rdf:resource="https://en.wikipedia.org/wiki/Phage_typing"/>
        <obo:IAO_0000412 rdf:resource="http://snomed.info/sct/900000000000207008"/>
        <rdfs:label xml:lang="en">Bacterial bacteriophage typing</rdfs:label>
        <rdfs:seeAlso>http://phinvads.cdc.gov/vads/http:/phinvads.cdc.gov/vads/ViewCodeSystemConcept.action?oid=2.16.840.1.113883.6.96&amp;code=22642004</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.bioassayontology.org/bao#BAO_0000513 -->

    <owl:Class rdf:about="http://www.bioassayontology.org/bao#BAO_0000513">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GENEPIO_0002047"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000115 xml:lang="en">A microplate having 96 wells.</obo:IAO_0000115>
        <obo:IAO_0000117 xml:lang="en">Damion Dooley</obo:IAO_0000117>
        <obo:IAO_0000119 rdf:resource="https://en.wikipedia.org/wiki/Microplate"/>
        <rdfs:label xml:lang="en">96 well plate</rdfs:label>
