        <oboInOwl:hasAlternativeId>CHEBI:45364</oboInOwl:hasAlternativeId>
        <oboInOwl:hasAlternativeId>CHEBI:8857</oboInOwl:hasAlternativeId>
        <rdfs:label>rifabutin</rdfs:label>
    </owl:Class>
    


