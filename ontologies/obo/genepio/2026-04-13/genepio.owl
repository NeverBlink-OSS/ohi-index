        <oboInOwl:hasExactSynonym>Guillain Barré syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Guillain-Barre-Strohl syndrome</oboInOwl:hasExactSynonym>
