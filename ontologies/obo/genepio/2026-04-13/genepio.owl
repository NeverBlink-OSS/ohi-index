        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NCIT_C3333"/>
        <obo:IAO_0000115>Acute inflammation of the lung parenchyma caused by viruses, bacteria, fungi, radiation treatment, or exposure to chemicals.  Signs and symptoms include cough, shortness of breath, fevers, chills, chest pain, headache, sweating, and weakness.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/ncit.owl"/>
