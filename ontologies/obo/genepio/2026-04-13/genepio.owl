    <!-- http://purl.obolibrary.org/obo/UBERON_0000168 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0000168">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0004921"/>
        <obo:IAO_0000115>A section dividing a colon along a proximal-distal axis.</obo:IAO_0000115>
