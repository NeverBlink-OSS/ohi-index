        <obo:IAO_0000112>PCDS: Hazard organism counts (i.e. Salmonella) do not distinguish between serovars.</obo:IAO_0000112>
        <obo:IAO_0000114>metadata incomplete</obo:IAO_0000114>
        <obo:IAO_0000115 xml:lang="en">A data field which describes the details pertaining to the prevalence metrics from a surveillance project.</obo:IAO_0000115>
        <obo:IAO_0000118 xml:lang="en">PCDS:prevalence_metrics_details</obo:IAO_0000118>
        <dcterms:contributor rdf:resource="https://orcid.org/0000-0002-1107-9135"/>
        <dcterms:contributor rdf:resource="https://orcid.org/0000-0002-8844-9165"/>
        <dcterms:contributor rdf:resource="https://orcid.org/0000-0002-9578-0788"/>
        <dcterms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2022-12-22T00:55:53.808Z</dcterms:date>
        <oboInOwl:hasBroadSynonym xml:lang="en">prevalence metrics details</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasBroadSynonym xml:lang="en">prevalence_metrics_details</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">prevalence metrics details slot</oboInOwl:hasExactSynonym>
        <rdfs:comment xml:lang="en">PCDS: If there are details pertaining to samples or organism counts in the sample plan that might be informative, provide details using free text.</rdfs:comment>
