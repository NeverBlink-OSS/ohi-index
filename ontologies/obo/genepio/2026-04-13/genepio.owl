        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000115 xml:lang="en">A disease cluster is an unusually high incidence of a particular disease or disorder occurring in close proximity in terms of both time and geography.</obo:IAO_0000115>
        <obo:IAO_0000117 xml:lang="en">Damion Dooley</obo:IAO_0000117>
        <obo:IAO_0000119 xml:lang="en">https://en.wikipedia.org/wiki/Disease_cluster</obo:IAO_0000119>
        <rdfs:label xml:lang="en">disease cluster</rdfs:label>
    </owl:Class>
    


