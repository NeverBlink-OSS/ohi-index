        <rdfs:label xml:lang="en">food reheating in pan or cooking utensil</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_03450043 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_03450043">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_03450014"/>
        <obo:IAO_0000115 xml:lang="en">A Chinese cooking technique to prepare delicate food such as bird nests, shark fins, etc. The food is covered with water and put in a covered ceramic jar and the jar is then steamed for several hours.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/foodon.owl"/>
        <oboInOwl:hasDbXref>http://www.langual.org/langual_thesaurus.asp?termid=G0043</oboInOwl:hasDbXref>
        <rdfs:label xml:lang="en">double steaming</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_03450044 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_03450044">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_03450006"/>
        <obo:IAO_0000115 xml:lang="en">Rotisserie is a style of roasting where meat is skewered on a spit and revolves over a flame or other heat source.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/foodon.owl"/>
        <oboInOwl:hasDbXref>http://www.langual.org/langual_thesaurus.asp?termid=G0044</oboInOwl:hasDbXref>
        <rdfs:label xml:lang="en">rotisserie roasting</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_03450045 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_03450045">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_03450006"/>
        <obo:IAO_0000115 xml:lang="en">Searing is a technique used in grilling, roasting, braising, sautéing, etc. that cooks the surface of the food at high temperature so that a brownish crust forms by Maillard reaction and denaturation of proteins.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/foodon.owl"/>
        <oboInOwl:hasDbXref>http://www.langual.org/langual_thesaurus.asp?termid=G0045</oboInOwl:hasDbXref>
        <rdfs:label xml:lang="en">searing</rdfs:label>
    </owl:Class>
    


