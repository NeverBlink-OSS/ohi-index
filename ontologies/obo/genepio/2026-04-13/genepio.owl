        <obo:IAO_0000115 xml:lang="en">A data item that representing the primary structure of a macromolecule(it&apos;s sequence) sometimes associated with an indicator of confidence of that measurement.</obo:IAO_0000115>
        <obo:IAO_0000115 xml:lang="en">A measurement datum that representing the primary structure of a macromolecule(it&apos;s sequence) sometimes associated with an indicator of confidence of that measurement.</obo:IAO_0000115>
        <obo:IAO_0000117>Person:Chris Stoeckert</obo:IAO_0000117>
        <obo:IAO_0000119>GROUP: OBI</obo:IAO_0000119>
        <rdfs:label xml:lang="en">sequence data</rdfs:label>
    </owl:Class>
    


