        <obo:GENEPIO_0000001>Assembly QC</obo:GENEPIO_0000001>
        <obo:GENEPIO_0000004>Annotation Algorithm</obo:GENEPIO_0000004>
        <obo:GENEPIO_0000005>Standard Term</obo:GENEPIO_0000005>
        <obo:IAO_0000112>Prokka</obo:IAO_0000112>
        <obo:IAO_0000115>Program used for annotation</obo:IAO_0000115>
        <obo:IAO_0000119>GROUP: IRIDA Ontology (Emma)</obo:IAO_0000119>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/genepio/core_slim.owl"/>
        <rdfs:label>genome annotation algorithm</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/GENEPIO_0000096 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GENEPIO_0000096">
