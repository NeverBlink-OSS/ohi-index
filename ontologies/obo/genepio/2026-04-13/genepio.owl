        <rdfs:label xml:lang="en">sequence amplification artifacts datum</rdfs:label>
        <rdfs:seeAlso>The PHA4GE QC Contextual Data Tags Specification: https://github.com/pha4ge/contextual-data-qc-tags</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/GENEPIO_0100574 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GENEPIO_0100574">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GENEPIO_0100662"/>
        <obo:IAO_0000114>ready for release</obo:IAO_0000114>
        <obo:IAO_0000115 xml:lang="en">A data item that describes sequence data containing more errors or undetermined bases (noise) than sequence representing the biological source (signal).</obo:IAO_0000115>
        <obo:IAO_0000118 xml:lang="en">low signal to noise ratio</obo:IAO_0000118>
        <dcterms:contributor rdf:resource="https://orcid.org/0000-0002-1107-9135"/>
