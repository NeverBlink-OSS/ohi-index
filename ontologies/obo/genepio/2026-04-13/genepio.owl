        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/ncit.owl"/>
        <oboInOwl:hasExactSynonym>Early Fetal Death</oboInOwl:hasExactSynonym>
        <rdfs:label>Early Fetal Death</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C112863 -->

