        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_03530211"/>
        <obo:IAO_0000115 xml:lang="en">A method of growing plants, usually crops, without soil, by using mineral nutrient solutions in an aqueous solvent.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/foodon.owl"/>
        <oboInOwl:hasDbXref rdf:resource="http://www.langual.org/langual_thesaurus.asp?termid=Z0214"/>
