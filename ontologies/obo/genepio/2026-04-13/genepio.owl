        <obo:IAO_0000112>PCDS: PRJNA12345</obo:IAO_0000112>
        <obo:IAO_0000114>metadata incomplete</obo:IAO_0000114>
        <obo:IAO_0000115 xml:lang="en">An identifier field which describes the International Nucleotide Sequence Database Collaboration (INSDC) accession number of the BioProject(s) to which the BioSample belongs.</obo:IAO_0000115>
        <obo:IAO_0000118 xml:lang="en">PCDS:bioproject_accession</obo:IAO_0000118>
        <dcterms:contributor rdf:resource="https://orcid.org/0000-0002-1107-9135"/>
        <dcterms:contributor rdf:resource="https://orcid.org/0000-0002-8844-9165"/>
        <dcterms:contributor rdf:resource="https://orcid.org/0000-0002-9578-0788"/>
        <dcterms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-04-24T00:42:14Z</dcterms:date>
        <oboInOwl:hasBroadSynonym xml:lang="en">bioproject accession</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasBroadSynonym xml:lang="en">bioproject_accession</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">bioproject accession slot</oboInOwl:hasExactSynonym>
        <rdfs:comment xml:lang="en">PCDS: Required if submission is linked to a BioProject. BioProjects are an organizing tool that links together raw sequence data, assemblies, and their associated metadata. A valid BioProject accession has prefix PRJN, PRJE or PRJD and is created once at the beginning of a new sequencing project. Your laboratory can have one or many BioProjects.</rdfs:comment>
        <rdfs:label xml:lang="en">bioproject accession</rdfs:label>
    </owl:Class>
    


