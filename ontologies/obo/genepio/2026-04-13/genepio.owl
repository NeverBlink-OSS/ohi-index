    <!-- http://purl.obolibrary.org/obo/OBI_0001620 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OBI_0001620">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GENEPIO_0001654"/>
        <obo:GENEPIO_0001763 xml:lang="en">help:Latitude should not be abstracted to the centre of a city, province/state or country as this may falsely implicate an existing location.</obo:GENEPIO_0001763>
        <obo:IAO_0000111 xml:lang="en">latitude coordinate measurement datum</obo:IAO_0000111>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000120"/>
        <obo:IAO_0000115 xml:lang="en">A measurement datum that is the measure of the latitude coordinate of a site.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">Damion Dooley&apos;s note: IAO lat/long can&apos;t be made a subclass of &quot;angular coordinate&quot; or disjoint contradiction arises.</obo:IAO_0000116>
        <obo:IAO_0000117 xml:lang="en">Person: Chris Stoeckert, Jie Zheng</obo:IAO_0000117>
        <obo:IAO_0000118 xml:lang="en">latitude</obo:IAO_0000118>
        <obo:IAO_0000119 xml:lang="en">NIAID GSCID-BRC metadata working group</obo:IAO_0000119>
        <obo:OBI_0001886>Specimen Collection Location - Latitude</obo:OBI_0001886>
        <rdfs:comment xml:lang="en">See http://www.csgnetwork.com/gpscoordconv.html

See http://www.geomidpoint.com/latlon.html
See http://www.ontobee.org/browser/rdf.php?o=OBI&amp;iri=http://purl.obolibrary.org/obo/OBI_0001621
See http://www.w3.org/2003/01/geo/wgs84_pos</rdfs:comment>
        <rdfs:label xml:lang="en">latitude coordinate measurement datum</rdfs:label>
    </owl:Class>
    


