        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NCIT_C17600"/>
        <obo:IAO_0000115>An age group comprised of individuals who have reached sexual maturity but whose character and personality are still developing. In psychology this generally covers the age range of 20-40.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/ncit.owl"/>
