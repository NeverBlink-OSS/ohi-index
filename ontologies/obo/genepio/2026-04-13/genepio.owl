    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C85173 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NCIT_C85173">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NCIT_C16729"/>
        <obo:IAO_0000115>Unexpected death in infancy which remains unexplained following autopsy, review of the medical history, and investigation of the death circumstances and death scene.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/ncit.owl"/>
