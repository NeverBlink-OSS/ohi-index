        <obo:IAO_0000115 xml:lang="en">Wild or semiwild foods consumed only during periods of famine when no other food is available.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/foodon.owl"/>
        <oboInOwl:hasDbXref rdf:resource="http://www.langual.org/langual_thesaurus.asp?termid=P0182"/>
        <rdfs:label xml:lang="en">aliment de disette</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_03510183 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_03510183">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_03510095"/>
        <obo:IAO_0000115 xml:lang="en">A food is &apos;enriched&apos; when nutrients are added to it to replace those that are lost in processing.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/foodon.owl"/>
        <oboInOwl:hasDbXref rdf:resource="http://www.langual.org/langual_thesaurus.asp?termid=P0183"/>
        <rdfs:label xml:lang="en">enriched food claim</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_03510184 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_03510184">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_03510095"/>
        <obo:IAO_0000115 xml:lang="en">A food is &apos;fortified&apos; when nutrients that were never present are added to it.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/foodon.owl"/>
        <oboInOwl:hasDbXref rdf:resource="http://www.langual.org/langual_thesaurus.asp?termid=P0184"/>
        <rdfs:label xml:lang="en">fortified food claim</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_03510185 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_03510185">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_03460159"/>
