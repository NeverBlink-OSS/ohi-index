        <oboInOwl:hasExactSynonym>State</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Territory</oboInOwl:hasExactSynonym>
        <rdfs:label>State</rdfs:label>
    </owl:Class>
    


