        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_00004336"/>
        <obo:IAO_0000115 xml:lang="en">A member of the group of eukaryotic organisms in the kingdom Fungi that includes unicellular microorganisms such as yeasts and molds, as well as multicellular fungi that produce familiar fruiting forms known as mushrooms.</obo:IAO_0000115>
