        <obo:IAO_0000233>https://github.com/obi-ontology/obi/issues/1579</obo:IAO_0000233>
        <oboInOwl:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/OBI_0002875"/>
        <rdfs:label>contig number identifier</rdfs:label>
    </owl:Class>
    


