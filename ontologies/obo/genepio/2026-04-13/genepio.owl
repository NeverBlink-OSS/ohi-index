    <!-- http://purl.obolibrary.org/obo/OBI_0001622 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OBI_0001622">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NCIT_C42614"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OBI_0001898"/>
