        <obo:IAO_0000115 xml:lang="en">A leg half that is derived from a whole pork leg. The anatomical location is the “Half” that comes from the Rump or Pelvic region of the Leg.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/foodon.owl"/>
        <rdfs:label xml:lang="en">pork leg sirloin half</rdfs:label>
