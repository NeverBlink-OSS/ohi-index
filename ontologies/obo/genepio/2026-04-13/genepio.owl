    <!-- http://purl.obolibrary.org/obo/APOLLO_SV_00000098 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/APOLLO_SV_00000098">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/APOLLO_SV_00000617"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/STATO_0000047"/>
        <obo:IAO_0000115 xml:lang="en">The count of individuals in a contagious population (empirical or virtual).</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/apollo_sv.owl"/>
        <rdfs:label xml:lang="en">count of contagious population</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/APOLLO_SV_00000099 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/APOLLO_SV_00000099">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/APOLLO_SV_00000617"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/STATO_0000047"/>
        <obo:IAO_0000115 xml:lang="en">The count of individuals in a resistant population (empirical or virtual).</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/apollo_sv.owl"/>
