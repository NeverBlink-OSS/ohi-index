    <!-- http://www.ebi.ac.uk/efo/EFO_0004340 -->

    <owl:Class rdf:about="http://www.ebi.ac.uk/efo/EFO_0004340">
        <rdfs:subClassOf rdf:resource="http://www.ebi.ac.uk/efo/EFO_0004324"/>
        <obo:IAO_0000115>An indicator of body density as determined by the relationship of BODY WEIGHT to BODY HEIGHT. BMI=weight (kg)/height squared (m2). BMI correlates with body fat (ADIPOSE TISSUE). Their relationship varies with age and gender. For adults, BMI falls into these categories: below 18.5 (underweight); 18.5-24.9 (normal); 25.0-29.9 (overweight); 30.0 and above (obese). (National Center for Health Statistics, Centers for Disease Control and Prevention)</obo:IAO_0000115>
        <obo:IAO_0000117>Dani Welter</obo:IAO_0000117>
        <obo:IAO_0000119>https://en.wikipedia.org/wiki/Body_mass_index</obo:IAO_0000119>
        <obo:IAO_0000412 rdf:resource="http://www.ebi.ac.uk/efo/efo.owl"/>
        <oboInOwl:hasDbXref>ICD9:V85-V85.99</oboInOwl:hasDbXref>
