        <dcterms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-04-13T19:52:38.515Z</dcterms:date>
        <rdfs:label xml:lang="en">Torpedo passive water sampling device</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/GENEPIO_0102187 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GENEPIO_0102187">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OBI_0002767"/>
        <obo:IAO_0000115 xml:lang="en">An amplicon sequencing assay in which the amplicon is derived from universal primers used to amplify the 18S ribosomal RNA gene from isolate bacterial genomic DNA or metagenomic DNA from a microbioal community. Resulting sequences are compared to reference 18S sequence databases to identify or classify bacteria present within a given sample.</obo:IAO_0000115>
        <obo:IAO_0000116>Planned Obsolescence: this term is a placeholder for a term requested in another ontology. Once the appropriate ontology term is available, this term’s identifier will be obsoleted with a “term replaced by” id of the other term.</obo:IAO_0000116>
        <dcterms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-04-13T19:52:38.515Z</dcterms:date>
        <rdfs:label xml:lang="en">18S ribosomal gene sequencing assay</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/GENEPIO_0102188 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GENEPIO_0102188">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OBI_0002767"/>
        <obo:IAO_0000115 xml:lang="en">An amplicon sequencing assay in which one or more genomic regions of viral nucleic acids are selectively amplified using PCR and subsequently sequenced to detect, characterise, or quantify viral populations</obo:IAO_0000115>
        <dcterms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-04-13T19:52:38.515Z</dcterms:date>
        <rdfs:label xml:lang="en">Viral amplicon sequencing</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/GENEPIO_0102189 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GENEPIO_0102189">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OBI_0002767"/>
        <obo:IAO_0000115 xml:lang="en">An amplicon sequencing assay that targets and sequences a standardized region of the mitochondrial cytochrome c oxidase subunit I (COI) gene to enable taxonomic identification of eukaryotic organisms based on DNA barcodes.</obo:IAO_0000115>
        <dcterms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-04-13T19:52:38.515Z</dcterms:date>
        <rdfs:label xml:lang="en">Cytochrome c oxidase I barcoding</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/GENEPIO_0102190 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GENEPIO_0102190">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GENEPIO_0001940"/>
        <obo:IAO_0000115 xml:lang="en">A library selection process in which target molecules are selectively bound to magnetic beads and separated from a sample using a magnetic field.</obo:IAO_0000115>
        <dcterms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-04-13T19:52:38.515Z</dcterms:date>
        <rdfs:label xml:lang="en">Magnetic bead capture</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/GENEPIO_0102191 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GENEPIO_0102191">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GENEPIO_0001940"/>
        <obo:IAO_0000115 xml:lang="en">A library selection process in which polyadenylated RNA molecules are selectively captured from a sample, typically using oligo(dT) probes, to enrich for messenger RNA.</obo:IAO_0000115>
        <dcterms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-04-13T19:52:38.515Z</dcterms:date>
        <rdfs:label xml:lang="en">Poly(A) selection</rdfs:label>
    </owl:Class>
    


