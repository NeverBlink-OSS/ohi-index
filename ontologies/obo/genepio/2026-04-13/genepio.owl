    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_02000273">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_02000272"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_02021135"/>
        <obo:IAO_0000115 xml:lang="en">A raw lamb rib.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/foodon.owl"/>
        <rdfs:label xml:lang="en">lamb rib (raw)</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_02000274 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_02000274">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_00004482"/>
        <obo:IAO_0000115 xml:lang="en">A lamb minor primal cut that is the lower chest cavity underneath the rack that includes ribs 5-8.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/foodon.owl"/>
        <rdfs:label xml:lang="en">lamb breast</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_02000275 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_02000275">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_00004485"/>
        <obo:IAO_0000115 xml:lang="en">A minor lamb primal cut that is meat lower shank from front leg with no hock bones.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/foodon.owl"/>
        <rdfs:label xml:lang="en">lamb foreshank</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_02000276 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_02000276">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_02000275"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_02021135"/>
        <obo:IAO_0000115 xml:lang="en">A raw lamb foreshank.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/foodon.owl"/>
        <rdfs:label xml:lang="en">lamb foreshank (raw)</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_02000277 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_02000277">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_00004482"/>
        <obo:IAO_0000115 xml:lang="en">A lamb cut that comes from the anatomical body location on either side of the spine that is located posterior to the Rack and anterior to the Sirloin or hip.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/foodon.owl"/>
        <rdfs:label xml:lang="en">lamb loin</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_02000278 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_02000278">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_02000277"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_02021135"/>
        <obo:IAO_0000115 xml:lang="en">A raw lamb loin cut.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/foodon.owl"/>
        <rdfs:label xml:lang="en">lamb loin (raw)</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_02000279 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_02000279">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_00004485"/>
        <obo:IAO_0000115 xml:lang="en">A whole cut that is derived from the short loin or any loin item that includes the sirloin. Because of its anatomical location, the tenderloin is the least exercised muscle in the carcass thus the name “Tender” Loin. The cut location is from underneath the finger bones in the short loin and the hipbone in the sirloin.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/foodon.owl"/>
        <rdfs:label xml:lang="en">lamb tenderloin</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_02000280 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_02000280">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_02000279"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_02021135"/>
        <obo:IAO_0000115 xml:lang="en">A raw lamb tenderloin cut.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/foodon.owl"/>
        <rdfs:label xml:lang="en">lamb tenderloin (raw)</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_02000281 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_02000281">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_00004483"/>
        <obo:IAO_0000115 xml:lang="en">A boneless and fatty cut from the belly of a pig.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/foodon.owl"/>
        <rdfs:label xml:lang="en">pork belly</rdfs:label>
    </owl:Class>
    


