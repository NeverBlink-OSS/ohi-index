        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000120"/>
        <obo:IAO_0000115 xml:lang="en">A CRID symbol that is sufficient to look up a citation from the PubMed, a literature database of life sciences and biomedical information.</obo:IAO_0000115>
        <obo:IAO_0000116>Edits was made on Aug 24, 2016 based on OBI dev call, details see tracker: https://sourceforge.net/p/obi/obi-terms/819/</obo:IAO_0000116>
        <obo:IAO_0000117 xml:lang="en">Person: Chris Stoeckert, Jie Zheng</obo:IAO_0000117>
        <obo:IAO_0000118 xml:lang="en">PMID</obo:IAO_0000118>
        <obo:IAO_0000118 xml:lang="en">PubMed Identifier</obo:IAO_0000118>
        <obo:IAO_0000119 xml:lang="en">Website: http://en.wikipedia.org/wiki/Wikipedia:PMID</obo:IAO_0000119>
        <obo:OBI_0001886>Publication Citation</obo:OBI_0001886>
        <rdfs:label xml:lang="en">PubMed ID</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OBI_0001619 -->

